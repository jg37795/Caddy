.join("\x2C ");\n  }\n\n  return color;\n}\n\nfunction hexToRGB(color) {\n  if (color.length === 6) {\n    const [r1\x2C r2\x2C g1\x2C g2\x2C b1\x2C b2] = color.split("");\n\n    return `rgb(${hexesToDecimals([r1\x2C r2]\x2C [g1\x2C g2]\x2C [b1\x2C b2]).join("\x2C ")})`;\n  }\n\n  if (color.length === 3) {\n    const [r1\x2C g1\x2C b1] = color.split("");\n\n    return `rgb(${hexesToDecimals([r1\x2C r1]\x2C [g1\x2C g1]\x2C [b1\x2C b1]).join("\x2C ")})`;\n  }\n\n  return "rgb(0\x2C 0\x2C 0)";\n}\n\nfunction hexToRGBA(color) {\n  if (color.length === 8) {\n    const [r1\x2C r2\x2C g1\x2C g2\x2C b1\x2C b2\x2C a1\x2C a2] = color.split("");\n\n    return `rgba(${hexesToDecimals([r1\x2C r2]\x2C [g1\x2C g2]\x2C [b1\x2C b2]).join("\x2C ")}\x2C ${hexToPercent(a1\x2C a2)})`;\n  }\n\n  if (color.length === 4) {\n    const [r1\x2C g1\x2C b1\x2C a1] = color.split("");\n\n    return `rgba(${hexesToDecimals([r1\x2C r1]\x2C [g1\x2C g1]\x2C [b1\x2C b1]).join("\x2C ")}\x2C ${hexToPercent(a1\x2C a1)})`;\n  }\n\n  return "rgba(0\x2C 0\x2C 0\x2C 1)";\n}\n\nfunction hexToDecimal(d1\x2C d2) {\n  return parseInt(d1\x2C 16) * 16 + parseInt(d2\x2C 16);\n}\n\nfunction hexesToDecimals(...hexes) {\n  return hexes.map(pair => hexToDecimal(pair[0]\x2C pair[1]));\n}\n\nfunction hexToPercent(d1\x2C d2) {\n  return Math.floor(1000 * hexToDecimal(d1\x2C d2) / 255) / 1000;\n}\n
