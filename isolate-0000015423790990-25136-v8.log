.log(1 - x);\n    return x < (a + 1) / (a + b + 2)\n      ? (Math.exp(lb) * betacf(a\x2C b\x2C x)) / a\n      : 1 - (Math.exp(lb) * betacf(b\x2C a\x2C 1 - x)) / b;\n  }\n  function tCdf(t\x2C nu) {                          // Student-t CDF via incomplete beta \u2014 Abramowitz & Stegun 26.5.27\n    if (!Number.isFinite(t)) return t > 0 ? 1 : 0;\n    if (nu > 1e7) return normCdf(t);\n    const p = 0.5 * ibeta(nu / 2\x2C 0.5\x2C nu / (nu + t * t));\n    return t > 0 ? 1 - p : p;\n  }\n  function tQuantile(p\x2C nu) {\n    if (!(nu > 0) || nu > 1e7) return invNorm(p);\n    let lo = -80\x2C hi = 80;\n    const seed = invNorm(p);\n    if (tCdf(seed\x2C nu) > p) hi = seed; else lo = seed;\n    for (let i = 0; i < 90; i++) {\n      const mid = 0.5 * (lo + hi);\n      if (tCdf(mid\x2C nu) < p) lo = mid; else hi = mid;\n      if (hi - lo < 1e-11) break;\n    }\n    return 0.5 * (lo + hi);\n  }\n  function chi2Inv(p\x2C df) {\n    if (df === 2) return -2 * Math.log(1 - p);    // exact: \u03c7\xb2\u2082 CDF = 1 - exp(-x/2)\n    let lo = 0\x2C hi = Math.max(30\x2C 4 * df + 60);\n    for (let i = 0; i < 220; i++) {\n      const mid = 0.5 * (lo + hi);\n      if (gammaP(df / 2\x2C mid / 2) < p) lo = mid; else hi = mid;\n    }\n    return 0.5 * (lo + hi);\n  }\n\n  // ---------- Robust & descriptive statistics ----------\n  const MAD_TO_SIGMA = 1.4826;                    // MAD\u2192\u03c3 consistency factor for a normal \u2014 Rousseeuw & Croux\x2C JASA 88 (1993) 1273\n  const RAYLEIGH_95 = 2.4477468306;               // 95th percentile of the Rayleigh dist = sqrt(-2 ln 0.05) \u2014 standard CEP\u2194R95 conversion\n  function quantileSorted(sorted\x2C p) {\n    const n = sorted.length;\n    if (!n) return NaN;\n    if (n === 1) return sorted[0];\n    const h = (n - 1) * clamp(p\x2C 0\x2C 1);\n    const lo = Math.floor(h)\x2C hi = Math.ceil(h);\n    return sorted[lo] + (h - lo) * (sorted[hi] - sorted[lo]); // type-7 quantile \u2014 Hyndman & Fan\x2C Am. Stat. 50 (1996) 361\n  }\n  const median = (arr) => quantileSorted([...arr].sort((a\x2C b) => a - b)\x2C 0.5);\n  function madSigma(arr) {\n    if (arr.length < 2) return NaN;\n    const m = median(arr);\n    return MAD_TO_SIGMA * median(arr.map((x) => Math.abs(x - m)));\n  }\n  function c4(n) {                                // unbiasing factor for the sample SD of a normal \u2014 Kenney & Keeping\x2C Math. of Statistics Pt.1 3rd ed.\n    if (n < 2) return NaN;\n    if (n > 400) return 1 - 0.75 / n;\n    return Math.sqrt(2 / (n - 1)) * Math.exp(logGamma(n / 2) - logGamma((n - 1) / 2));\n  }\n  function weightedMoments(values\x2C weights) {      // weighted Welford \u2014 Welford\x2C Technometrics 4 (1962) 419; West\x2C CACM 22 (1979) 532\n    let W = 0\x2C W2 = 0\x2C mean = 0\x2C S = 0;\n    for (let i = 0; i < values.length; i++) {\n      const w = weights[i];\n      if (!(w > 0)) continue;\n      W += w; W2 += w * w;\n      const d = values[i] - mean;\n      mean += (w / W) * d;\n      S += w * d * (values[i] - mean);\n    }\n    const nEff = W2 > 0 ? (W * W) / W2 : 0;        // Kish effective sample size \u2014 Kish\x2C Survey Sampling (1965) \xa78.2\n    const variance = W > 0 && nEff > 1 ? (S / W) * (nEff / (nEff - 1)) : NaN;\n    return { W\x2C mean\x2C variance\x2C nEff };\n  }\n  function theilSen(xs\x2C ys) {                      // median-of-slopes regression \u2014 Theil (1950); Sen\x2C JASA 63 (1968) 1379\n    const n = Math.min(xs.length\x2C ys.length);\n    if (n < 3) return null;\n    const slopes = [];\n    for (let i = 0; i < n - 1; i++)\n      for (let j = i + 1; j < n; j++) {\n        const dx = xs[j] - xs[i];\n        if (Math.abs(dx) > EPS) slopes.push((ys[j] - ys[i]) / dx);\n      }\n    if (!slopes.length) return null;\n    const slope = median(slopes);\n    return { slope\x2C intercept: median(ys.map((y\x2C i) => y - slope * xs[i]))\x2C n };\n  }\n  function wilsonInterval(k\x2C n\x2C conf = 0.95) {     // score interval for a proportion \u2014 Wilson\x2C JASA 22 (1927) 209\n    if (!n) return { p: NaN\x2C lo: NaN\x2C hi: NaN\x2C n: 0 };\n    const z = invNorm(1 - (1 - conf) / 2)\x2C p = k / n\x2C z2 = z * z\x2C d = 1 + z2 / n;\n    const c = p + z2 / (2 * n);\n    const h = (z / d) * Math.sqrt((p * (1 - p)) / n + z2 / (4 * n * n));\n    return { p\x2C lo: clamp(c / d - h\x2C 0\x2C 1)\x2C hi: clamp(c / d + h\x2C 0\x2C 1)\x2C n };\n  }\n\n  // ---------- Shape-preserving interpolation ----------\n  function pchip(xs\x2C ys) {                         // monotone cubic \u2014 Fritsch & Carlson\x2C SIAM J. Numer. Anal. 17 (1980) 238\n    const n = xs.length;\n    const h = new Array(n - 1)\x2C delta = new Array(n - 1)\x2C m = new Array(n).fill(0);\n    for (let i = 0; i < n - 1; i++) {\n      h[i] = xs[i + 1] - xs[i];\n      delta[i] = (ys[i + 1] - ys[i]) / h[i];\n    }\n    m[0] = delta[0]; m[n - 1] = delta[n - 2];\n    for (let i = 1; i < n - 1; i++) {\n      if (delta[i - 1] * delta[i] <= 0) { m[i] = 0; continue; }\n      const w1 = 2 * h[i] + h[i - 1]\x2C w2 = h[i] + 2 * h[i - 1];\n      m[i] = (w1 + w2) / (w1 / delta[i - 1] + w2 / delta[i]);\n    }\n    return function evalAt(x) {\n      if (x <= xs[0]) return ys[0] + m[0] * (x - xs[0]);\n      if (x >= xs[n - 1]) return ys[n - 1] + m[n - 1] * (x - xs[n - 1]);\n      let lo = 0\x2C hi = n - 1;\n      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (xs[mid] > x) hi = mid; else lo = mid; }\n      const t = (x - xs[lo]) / h[lo]\x2C t2 = t * t\x2C t3 = t2 * t;\n      return (2 * t3 - 3 * t2 + 1) * ys[lo] + (t3 - 2 * t2 + t) * h[lo] * m[lo] +\n        (-2 * t3 + 3 * t2) * ys[lo + 1] + (t3 - t2) * h[lo] * m[lo + 1];\n    };\n  }\n\n  // ---------- Quadrature over a normal factor (9-node truncated Gauss\u2013Legendre) ----------\n  const GL9_X = [-0.9681602395076261\x2C -0.8360311073266358\x2C -0.6133714327005904\x2C\n  -0.3242534234038089\x2C 0\x2C 0.3242534234038089\x2C 0.6133714327005904\x2C\n    0.8360311073266358\x2C 0.9681602395076261];   // 9-pt Gauss\u2013Legendre absciss