script-source,145,C:\\Users\\wendy\\Desktop\\Caddy\\Caddy-main\\node_modules\\universalify\\index.js,'use strict'\n\nexports.fromCallback = function (fn) {\n  return Object.defineProperty(function () {\n    if (typeof arguments[arguments.length - 1] === 'function') fn.apply(this\x2C arguments)\n    else {\n      return new Promise((resolve\x2C reject) => {\n        arguments[arguments.length] = (err\x2C res) => {\n          if (err) return reject(err)\n          resolve(res)\n        }\n        arguments.length++\n        fn.apply(this\x2C arguments)\n      })\n    }\n  }\x2C 'name'\x2C { value: fn.name })\n}\n\nexports.fromPromise = function (fn) {\n  return Object.defineProperty(function () {\n    const cb = arguments[arguments.length - 1]\n    if (typeof cb !== 'function') return fn.apply(this\x2C arguments)\n    else {\n      delete arguments[arguments.length - 1]\n      arguments.length--\n      fn.apply(this\x2C arguments).then(r => cb(null\x2C r)\x2C cb)\n    }\n  }\x2C 'name'\x2C { value: fn.name })\n}\n
