estroy(error);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Arguments: [port\x2C] [host\x2C] [options\x2C] [cb]\x0d\nexports.connect = function connect(...args) {\x0d\n  args = normalizeConnectArgs(args);\x0d\n  let options = args[0];\x0d\n  const cb = args[1];\x0d\n  const allowUnauthorized = getAllowUnauthorized();\x0d\n\x0d\n  options = {\x0d\n    rejectUnauthorized: !allowUnauthorized\x2C\x0d\n    ciphers: tls.DEFAULT_CIPHERS\x2C\x0d\n    checkServerIdentity: tls.checkServerIdentity\x2C\x0d\n    minDHSize: 1024\x2C\x0d\n    ...options\x0d\n  };\x0d\n\x0d\n  if (!options.keepAlive)\x0d\n    options.singleUse = true;\x0d\n\x0d\n  assert(typeof options.checkServerIdentity === 'function');\x0d\n  assert(typeof options.minDHSize === 'number'\x2C\x0d\n         'options.minDHSize is not a number: ' + options.minDHSize);\x0d\n  assert(options.minDHSize > 0\x2C\x0d\n         'options.minDHSize is not a positive number: ' +\x0d\n         options.minDHSize);\x0d\n\x0d\n  const context = options.secureContext || tls.createSecureContext(options);\x0d\n\x0d\n  const tlssock = new TLSSocket(options.socket\x2C {\x0d\n    allowHalfOpen: options.allowHalfOpen\x2C\x0d\n    pipe: !!options.path\x2C\x0d\n    secureContext: context\x2C\x0d\n    isServer: false\x2C\x0d\n    requestCert: true\x2C\x0d\n    rejectUnauthorized: options.rejectUnauthorized !== false\x2C\x0d\n    session: options.session\x2C\x0d\n    ALPNProtocols: options.ALPNProtocols\x2C\x0d\n    requestOCSP: options.requestOCSP\x2C\x0d\n    enableTrace: options.enableTrace\x2C\x0d\n    pskCallback: options.pskCallback\x2C\x0d\n    highWaterMark: options.highWaterMark\x2C\x0d\n    onread: options.onread\x2C\x0d\n    signal: options.signal\x2C\x0d\n  });\x0d\n\x0d\n  // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n  // causing the assignment to default value (`true`) fail. Before assigning\x0d\n  // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n  // and update rejectUnauthorize