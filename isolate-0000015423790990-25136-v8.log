   blue = '\\u001b[34m';\x0d\n          green = '\\u001b[32m';\x0d\n          white = '\\u001b[39m';\x0d\n          red = '\\u001b[31m';\x0d\n        } else {\x0d\n          blue = '';\x0d\n          green = '';\x0d\n          white = '';\x0d\n          red = '';\x0d\n        }\x0d\n      }\x0d\n      // Prevent the error stack from being visible by duplicating the error\x0d\n      // in a very close way to the original in case both sides are actually\x0d\n      // instances of Error.\x0d\n      if (typeof actual === 'object' && actual !== null &&\x0d\n          typeof expected === 'object' && expected !== null &&\x0d\n          'stack' in actual && actual instanceof Error &&\x0d\n          'stack' in expected && expected instanceof Error) {\x0d\n        actual = copyError(actual);\x0d\n        expected = copyError(expected);\x0d\n      }\x0d\n\x0d\n      if (operator === 'deepStrictEqual' || operator === 'strictEqual') {\x0d\n        super(createErrDiff(actual\x2C expected\x2C operator));\x0d\n      } else if (operator === 'notDeepStrictEqual' ||\x0d\n        operator === 'notStrictEqual') {\x0d\n        // In case the objects are equal but the operator requires unequal\x2C show\x0d\n        // the first object and say A equals B\x0d\n        let base = kReadableOperator[operator];\x0d\n        const res = StringPrototypeSplit(inspectValue(actual)\x2C '\\n');\x0d\n\x0d\n        // In case "actual" is an object or a function\x2C it should not be\x0d\n        // reference equal.\x0d\n        if (operator === 'notStrictEqual' &&\x0d\n            ((typeof actual === 'object' && actual !== null) ||\x0d\n             typeof actual === 'function')) {\x0d\n          base = kReadableOperator.notStrictEqualObject;\x0d\n        }\x0d\n\x0d\n        // Only remove lines in case it makes sense to collapse those.\x0d\n        // TODO: Accept env to always show the full error.\x0d\n        if (res.length > 50) {\x0d\n          res[46] = `${blue}...${white}`;\x0d\n          while 