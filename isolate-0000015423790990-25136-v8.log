 sU1 = Math.sin(U1)\x2C cU1 = Math.cos(U1);\n    const sU2 = Math.sin(U2)\x2C cU2 = Math.cos(U2);\n    let lam = L\x2C lamPrev\x2C it = 0;\n    let sLam = 0\x2C cLam = 1\x2C sSig = 0\x2C cSig = 1\x2C sig = 0\x2C c2Alpha = 1\x2C cos2SigM = 1;\n    do {\n      sLam = Math.sin(lam); cLam = Math.cos(lam);\n      sSig = hypot2(cU2 * sLam\x2C cU1 * sU2 - sU1 * cU2 * cLam);\n      if (sSig < EPS) return { s: 0\x2C az1: 0\x2C az2: 0\x2C converged: true };\n      cSig = sU1 * sU2 + cU1 * cU2 * cLam;\n      sig = Math.atan2(sSig\x2C cSig);\n      const sAlpha = (cU1 * cU2 * sLam) / sSig;\n      c2Alpha = Math.max(0\x2C 1 - sAlpha * sAlpha);\n      cos2SigM = c2Alpha < EPS ? 0 : cSig - (2 * sU1 * sU2) / c2Alpha;\n      const C = (f / 16) * c2Alpha * (4 + f * (4 - 3 * c2Alpha));\n      lamPrev = lam;\n      lam = L + (1 - C) * f * sAlpha *\n        (sig + C * sSig * (cos2SigM + C * cSig * (-1 + 2 * cos2SigM * cos2SigM)));\n    } while (Math.abs(lam - lamPrev) > VINCENTY_TOL && ++it < VINCENTY_MAXIT);\n\n    if (it >= VINCENTY_MAXIT) {\n      const dp = d2r(p2.lat - p1.lat)\x2C dl = d2r(p2.lng - p1.lng);\n      const hs = Math.sin(dp / 2) ** 2 +\n        Math.cos(d2r(p1.lat)) * Math.cos(d2r(p2.lat)) * Math.sin(dl / 2) ** 2;\n      const s = 2 * R * Math.atan2(Math.sqrt(hs)\x2C Math.sqrt(1 - hs));\n      const y = Math.sin(dl) * Math.cos(d2r(p2.lat));\n      const x = Math.cos(d2r(p1.lat)) * Math.sin(d2r(p2.lat)) -\n        Math.sin(d2r(p1.lat)) * Math.cos(d2r(p2.lat)) * Math.cos(dl);\n      const az = norm(r2d(Math.atan2(y\x2C x)));\n      return { s\x2C az1: az\x2C az2: az\x2C converged: false };\n    }\n    const uSq = (c2Alpha * (a * a - b * b)) / (b * b);\n    const A = 1 + (uSq / 16384) * (4096 + uSq * (-768 + uSq * (320 - 175 * uSq)));\n    const B = (uSq / 1024) * (256 + uSq * (-128 + uSq * (74 - 47 * uSq)));\n    const dSig = B * sSig * (cos2SigM + (B / 4) * (\n      cSig * (-1 + 2 * cos2SigM * cos2SigM) -\n      (B / 6) * cos2SigM * (-3 + 4 * sSig * sSig) * (-3 + 4 * cos2SigM * cos2SigM)));\n    return {\n      s: b * A * (sig - dSig)\x2C\n      az1: norm(r2d(Math.atan2(cU2 * sLam\x2C cU1 * sU2 - sU1 * cU2 * cLam)))\x2C\n      az2: norm(r2d(Math.atan2(cU1 * sLam\x2C -sU1 * cU2 + cU1 * sU2 * cLam)))\x2C\n      converged: true\x2C\n    };\n  }\n\n  function geodesicDirect(p\x2C azDeg\x2C sMeters) {\n    const a = WGS84_A\x2C b = WGS84_B\x2C f = WGS84_F;\n    const alpha1 = d2r(norm(azDeg));\n    const sA1 = Math.sin(alpha1)\x2C cA1 = Math.cos(alpha1);\n    const tanU1 = (1 - f) * Math.tan(d2r(p.lat));\n    const cU1 = 1 / Math.sqrt(1 + tanU1 * tanU1)\x2C sU1 = tanU1 * cU1;\n    const sigma1 = Math.atan2(tanU1\x2C cA1);\n    const sAlpha = cU1 * sA1\x2C c2Alpha = 1 - sAlpha * sAlpha;\n    const uSq = (c2Alpha * (a * a - b * b)) / (b * b);\n    const A = 1 + (uSq / 16384) * (4096 + uSq * (-768 + uSq * (320 - 175 * uSq)));\n    const B = (uSq / 1024) * (256 + uSq * (-128 + uSq * (74 - 47 * uSq)));\n    let sigma = sMeters / (b * A)\x2C sigmaPrev\x2C it = 0\x2C sSig = 0\x2C cSig = 1\x2C cos2SigM = 1;\n    do {\n      cos2SigM = Math.cos(2 * sigma1 + sigma);\n      sSig = Math.sin(sigma); cSig = Math.cos(sigma);\n      const dSig = B * sSig * (cos2SigM + (B / 4) * (\n        cSig * (-1 + 2 * cos2SigM * cos2SigM) -\n        (B / 6) * cos2SigM * (-3 + 4 * sSig * sSig) * (-3 + 4 * cos2SigM * cos2SigM)));\n      sigmaPrev = sigma;\n      sigma = sMeters / (b * A) + dSig;\n    } while (Math.abs(sigma - sigmaPrev) > VINCENTY_TOL && ++it < VINCENTY_MAXIT);\n    const tmp = sU1 * sSig - cU1 * cSig * cA1;\n    const lat2 = Math.atan2(sU1 * cSig + cU1 * sSig * cA1\x2C\n      (1 - f) * Math.sqrt(sAlpha * sAlpha + tmp * tmp));\n    const lambda = Math.atan2(sSig * sA1\x2C cU1 * cSig - sU1 * sSig * cA1);\n    const C = (f / 16) * c2Alpha * (4 + f * (4 - 3 * c2Alpha));\n    const Lo = lambda - (1 - C) * f * sAlpha *\n      (sigma + C * sSig * (cos2SigM + C * cSig * (-1 + 2 * cos2SigM * cos2SigM)));\n    return { lat: r2d(lat2)\x2C lng: p.lng + r2d(Lo) };\n  }\n\n  // PUBLIC NAME PRESERVED \u2014 now the exact WGS-84 geodesic\x2C not the spherical haversine.\n  // The geodesic between two lat/lngs is already the horizontal projection\x2C so no slope\n  // correction is needed. Optional meanHeightM scales the arc to flight altitude.\n  function haversineMeters(a\x2C b\x2C meanHeightM) {\n    const g = geodesicInverse(a\x2C b);\n    if (!Number.isFinite(meanHeightM) || meanHeightM === 0) return g.s;\n    const phi = d2r((a.lat + b.lat) / 2);\n    const s = Math.sin(phi)\x2C W2 = 1 - WGS84_E2 * s * s;\n    const N = WGS84_A / Math.sqrt(W2);                              // prime-vertical radius of curvature\n    const M = (WGS84_A * (1 - WGS84_E2)) / (W2 * Math.sqrt(W2));    // meridional radius of curvature\n    const az = d2r(g.az1);\n    const Ralpha = 1 / (Math.cos(az) ** 2 / M + Math.sin(az) ** 2 / N); // Euler's radius in azimuth\n    return g.s * (1 + meanHeightM / Ralpha);\n  }\n\n  // PUBLIC NAME PRESERVED \u2014 geodesic forward azimuth.\n  function initialBearingDeg(a\x2C b) {\n    return geodesicInverse(a\x2C b).az1;\n  }\n\n  // Local ENU tangent frame; error < 1 cm inside 2 km.\n  function enuFrame(origin) {\n    const phi = d2r(origin.lat);\n    const s = Math.sin(phi)\x2C W2 = 1 - WGS84_E2 * s * s;\n    const N = WGS84_A / Math.sqrt(W2);\n    const M = (WGS84_A * (1 - WGS84_E2)) / (W2 * Math.sqrt(W2));\n    return {\n      lat0: origin.lat\x2C lng0: origin.lng\x2C\n      mPerDegLat: (M * Math.PI) / 180\x2C\n      mPerDegLng: (N * Math.cos(phi) * Math.PI) / 180\x2C\n    };\n  }\n  const toENU = (fr\x2C p) => ({\n    e: (p.lng - fr.lng0) * fr.mPerDegLng\x2C\n    n: (p.lat - fr.lat0) * fr.mPerDegLat\x2C\n  });\n  const fromENU = (fr\x2C e\x2C n) => ({\n    lat: fr.lat0 + n / fr.mPerDegLat\x2C\n    lng: fr.lng0 + e / fr.mPerDegLng\x2C\n  });\n  function crossTrackYd(A\x2C B\x2C p) {                 // signed perpendicular offset; + = right of A\u2192B\n    const fr = enuFrame(A)\x2C b = toENU(fr\x2C B)\x2C q = toENU(fr\x2C p);\n    const len = hypot2(b.e\x2C b.n);\n    if (len < EPS) return 0;\n    return ((q.e * (b.n / len) - q.n * (b.e / len)) * M_TO_YD);\n  }\n  function alongTrackYd(A\x2C B\x2C p) {\n    const fr = enuFrame(A)\x2C b = toENU(fr\x2C B)\x2C q = toENU(fr\x2C p);\n    const len = hypot2(b.e\x2C b.n);\n    if (len < EPS) return 0;\n    return ((q.e * b.e + q.n * b.n) / len) * M_TO_YD;\n  }\n  const midpointGeodesic = (A\x2C B) => {\n    const g = geodesicInverse(A\x2C B);\n    return geodesicDirect(A\x2C g.az1\x2C g.s / 2);\n  };\n  function gravityAt(latDeg\x2C heightM) {             // Somigliana + 2nd-order free-air \u2014 NIMA TR8350.2 \xa74; Heiskanen & Moritz (1967) eq. 2-124\n    const s2 = Math.sin(d2r(num(latDeg\x2C 40))) ** 2;\n    const g0 = (GRAV_EQ * (1 + GRAV_K * s2)) / Math.sqrt(1 - WGS84_E2 * s2);\n    const h = num(heightM\x2C 0);\n    return g0 * (1 - (2 / WGS84_A) * (1 + WGS84_F + GRAV_M - 2 * WGS84_F * s2) * h +\n      (3 / (WGS84_A * WGS84_A)) * h * h);\n  }\n  // ============================================================\n  //  BLOCK 3 \u2014 ATMOSPHERE\n  // ============================================================\n\n  // CIPM-2007 moist-air density \u2014 Picard\x2C Davis\x2C Gl\xe4ser & Fujii\x2C Metrologia 45 (2008) 149. Rel. unc. 2.2e-5.\n  const CIPM_MA = 28.96546e-3;   // molar mass of dry air\x2C kg/mol \u2014 CIPM-2007 Table 1\n  const CIPM_MV = 18.01528e-3;   // molar mass of water vapour\x2C kg/mol \u2014 CIPM-2007 Table 1\n  const CIPM_R = 8.314472;      // molar gas constant adopted by CIPM-2007\x2C J/(mol\xb7K)\n  const SVP_A = 1.2378847e-5;   // saturation vapour pressure coeff. A\x2C K\u207b\xb2 \u2014 CIPM-2007 eq. A1.1\n  const SVP_B = -1.9121316e-2;   // saturation vapour pressure coeff. B\x2C K\u207b\xb9 \u2014 CIPM-2007 eq. A1.1\n  const SVP_C = 33.93711047;    // saturation vapour pressure coeff. C \u2014 CIPM-2007 eq. A1.1\n  const SVP_D = -6.3431645e3;    // saturation vapour pressure coeff. D\x2C K \u2014 CIPM-2007 eq. A1.1\n  const ENH_A = 1.00062;         // enhancement factor \u03b1 \u2014 CIPM-2007 eq. A1.2\n  const ENH_B = 3.14e-8;         // enhancement factor \u03b2\x2C Pa\u207b\xb9 \u2014 CIPM-2007 eq. A1.2\n  const ENH_G = 5.6e-7;          // enhancement factor \u03b3\x2C \xb0C\u207b\xb2 \u2014 CIPM-2007 eq. A1.2\n  const Z_A0 = 1.58123e-6;       // compressibility a\u2080\x2C K/Pa \u2014 CIPM-2007 eq. A1.3\n  const Z_A1 = -2.9331e-8;       // compressibility a\u2081\x2C Pa\u207b\xb9 \u2014 CIPM-2007 eq. A1.3\n  const Z_A2 = 1.1043e-10;       // compressibility a\u2082\x2C (K\xb7Pa)\u207b\xb9 \u2014 CIPM-2007 eq. A1.3\n  const Z_B0 = 5.707e-6;         // compressibility b\u2080\x2C K/Pa \u2014 CIPM-2007 eq. A1.3\n  const Z_B1 = -2.051e-8;        // compressibility b\u2081\x2C Pa\u207b\xb9 \u2014 CIPM-2007 eq. A1.3\n  const Z_C0 = 1.9898e-4;        // compressibility c\u2080\x2C K/Pa \u2014 CIPM-2007 eq. A1.3\n  const Z_C1 = -2.376e-6;        // compressibility c\u2081\x2C Pa\u207b\xb9 \u2014 CIPM-2007 eq. A1.3\n  const Z_D = 1.83e-11;         // compressibility d\x2C K\xb2/Pa\xb2 \u2014 CIPM-2007 eq. A1.3\n  const Z_E = -0.765e-8;        // compressibility e\x2C K\xb2/Pa\xb2 \u2014 CIPM-2007 eq. A1.3\n\n  function saturationVaporPressure(tempC) {\n    const T = tempC + KELVIN_0C;\n    return Math.exp(SVP_A * T * T + SVP_B * T + SVP_C + SVP_D / T);\n  }\n  function airDensityCIPM(tempC\x2C pressurePa\x2C rhPercent) {\n    const T = tempC + KELVIN_0C;\n    const p = Math.max(1000\x2C pressurePa);\n    const h = clamp(num(rhPercent\x2C 50)\x2C 0\x2C 100) / 100;\n    const f = ENH_A + ENH_B * p + ENH_G * tempC * tempC;\n    const xv = (h * f * saturationVaporPressure(tempC)) / p;\n    const Z = 1 -\n      (p / T) * (Z_A0 + Z_A1 * tempC + Z_A2 * tempC * tempC +\n        (Z_B0 + Z_B1 * tempC) * xv + (Z_C0 + Z_C1 * tempC) * xv * xv) +\n      ((p * p) / (T * T)) * (Z_D + Z_E * xv * xv);\n    return ((p * CIPM_MA) / (Z * CIPM_R * T)) * (1 - xv * (1 - CIPM_MV / CIPM_MA));\n  }\n\n  const ISA_P0 = 101325;         // sea-level standard pressure\x2C Pa \u2014 U.S. Standard Atmosphere 1976 (NOAA-S/T 76-1562)\n  const ISA_T0 = 288.15;         // sea-level standard temperature\x2C K \u2014 USSA 1976\n  const ISA_L = 0.0065;         // tropospheric lapse rate\x2C K/m \u2014 USSA 1976\n  const ISA_EXP = 5.2558797;     // g\u2080M/(R*L) for the troposphere \u2014 USSA 1976 eq. 33a\n  const DRY_AIR_R = 287.052874;  // specific gas constant of dry air\x2C J/(kg\xb7K) \u2014 ISO 2533 / CODATA 2018\n  const pressureFromISA = (altitudeM) =>\n    ISA_P0 * Math.pow(1 - (ISA_L * clamp(num(altitudeM\x2C 0)\x2C -500\x2C 11000)) / ISA_T0\x2C ISA_EXP);\n  function stationPressureFromMSL(pMslPa\x2C altitudeM\x2C tempC) {  // hypsometric reduction \u2014 WMO-No. 8 Part I Ch. 3\n    const Tv = tempC + KELVIN_0C + 0.5 * ISA_L * Math.max(0\x2C altitudeM);\n    return pMslPa * Math.exp((-gravityAt(40\x2C 0) * altitudeM) / (DRY_AIR_R * Tv));\n  }\n\n  const STD_TEMP_F = 70;         // industry reference temperature for quoted carry numbers \u2014 TrackMan/USGA test conditions\n  const STD_RH = 50;            // industry reference relative humidity\x2C % \u2014 TrackMan/USGA test conditions\n  const STD_ALT_FT = 0;         // sea level reference \u2014 quoted carry numbers assume it\n  const STD_LAT = 40;           // reference latitude for normal gravity\x2C deg \u2014 mid-latitude US courses\n\n  function airDensity({ tempF\x2C rh\x2C altitudeFt\x2C pressureHpa } = {}) {\n    const tempC = (num(tempF\x2C STD_TEMP_F) - 32) / 1.8;\n    const altM = num(altitudeFt\x2C 0) * FT_TO_M;\n    const p = Number.isFinite(pressureHpa) && pressureHpa > 500\n      ? pressureHpa * 100                        // Open-Meteo surface_pressure is already station level\n      : pressureFromISA(altM);\n    return airDensityCIPM(tempC\x2C p\x2C num(rh\x2C STD_RH));\n  }\n  const RHO_STD = airDensity({ tempF: STD_TEMP_F\x2C rh: STD_RH\x2C altitudeFt: STD_ALT_FT }); // \u22481.1943 kg/m\xb3\n\n  const SUTH_MU0 = 1.716e-5;     // dynamic viscosity of air at 273.15 K\x2C Pa\xb7s \u2014 White\x2C Viscous Fluid Flow 3rd ed. Table 1-2\n  const SUTH_S = 110.4;          // Sutherland constant for air\x2C K \u2014 White (2006) Table 1-2\n  function kinematicViscosity(tempC\x2C rho) {\n    const T = tempC + KELVIN_0C;\n    const mu = SUTH_MU0 * Math.pow(T / KELVIN_0C\x2C 1.5) * ((KELVIN_0C + SUTH_S) / (T + SUTH_S));\n    return mu / Math.max(0.4\x2C rho);\n  }\n\n  // --- Surface-layer wind profile ---\n  // The single largest wind-modelling error in consumer golf apps is using the 10 m model wind\n  // as if it were the wind the ball flies through. At 1 m it is ~60% of that; at 30 m\x2C ~119%.\n  const WIND_Z0_FAIRWAY = 0.03;      // roughness length for short grass / open terrain\x2C m \u2014 Wieringa\x2C Bound.-Layer Meteorol. 63 (1993) 323 (Davenport class 3)\n  const WIND_Z_REF = 10;             // WMO standard anemometer height\x2C m \u2014 WMO-No. 8 Part I Ch. 5\n  const WIND_Z_MIN = 0.35;           // lower clamp \u2248 ball radius + turf roughness sublayer\x2C m\n  const WIND_SHEAR_ALPHA_DEF = 0.143; // 1/7 power-law exponent\x2C neutral open terrain \u2014 Justus et al.\x2C J. Appl. Meteorol. 17 (1978) 350\n  const WIND_ALPHA_MIN = 0.02;       // lower bound on a fitted shear exponent (near-neutral\x2C very smooth)\n  const WIND_ALPHA_MAX = 0.45;       // upper bound on a fitted shear exponent (strongly stable nocturnal)\n  const WIND_VEER_DEG_PER_M = 0.035; // Ekman veer in the lower surface layer\x2C deg/m \u2014 Pe\xf1a et al.\x2C Bound.-Layer Meteorol. 136 (2010) 383\n  const WIND_VEER_MAX_DEG = 6;       // veer saturates below trajectory apex heights\n\n  function windProfileFactor(zMeters\x2C z0 = WIND_Z0_FAIRWAY) {\n    const z = Math.max(WIND_Z_MIN\x2C zMeters);\n    return Math.log(z / z0) / Math.log(WIND_Z_REF / z0);\n  }\n  function windPowerFactor(zMeters\x2C alpha) {\n    const a = clamp(num(alpha\x2C WIND_SHEAR_ALPHA_DEF)\x2C WIND_ALPHA_MIN\x2C WIND_ALPHA_MAX);\n    return Math.pow(Math.max(WIND_Z_MIN\x2C zMeters) / WIND_Z_REF\x2C a);\n  }\n  // Fit the local shear exponent from two model levels when both are available.\n  function fitShearAlpha(u10\x2C u80) {\n    if (!(u10 > 0.5) || !(u80 > 0.5)) return null;\n    return clamp(Math.log(u80 / u10) / Math.log(80 / 10)\x2C WIND_ALPHA_MIN\x2C WIND_ALPHA_MAX);\n  }\n  function windVeerDeg(zMeters\x2C latDeg) {\n    const sgn = num(latDeg\x2C 40) >= 0 ? 1 : -1;   // veers clockwise with height in the NH\x2C counter-clockwise in the SH\n    return sgn * clamp((Math.max(0\x2C zMeters) - WIND_Z_REF) * WIND_VEER_DEG_PER_M\x2C\n      -WIND_VEER_MAX_DEG\x2C WIND_VEER_MAX_DEG);\n  }\n  // ============================================================\n  //  BLOCK 4 \u2014 3-DOF BALL FLIGHT\n  //  Frame: x = downrange along the aim bearing\x2C y = up\x2C z = right of the aim line.\n  // ============================================================\n\n  const BALL = Object.freeze({\n    massKg: 0.04593\x2C      // USGA/R&A maximum ball mass 1.620 oz \u2014 Rules of Golf\x2C Equipment Rules Pt.3 \xa71a\n    radiusM: 0.021335\x2C    // USGA/R&A minimum diameter 1.680 in\x2C halved \u2014 Equipment Rules Pt.3 \xa71b\n    areaM2: Math.PI * 0.021335 * 0.021335\x2C\n    spinDecayTauS: 25\x2C    // measured exponential spin decay \u03c9=\u03c9\u2080e^(\u2212t/\u03c4) \u2014 Smits & Smith\x2C Science and Golf II (1994)\n  });\n\n  // Smits\u2013Smith spin-ratio fits\x2C as reproduced in A. R. Penner\x2C "The physics of golf"\x2C\n  // Rep. Prog. Phys. 66 (2003) 131\x2C eqs. (12)\u2013(13). Valid for 0.02 \u2264 S \u2264 0.6.\n  const AERO_S_MIN = 0.02;   // lower validity bound of the Smits\u2013Smith fit \u2014 Penner (2003) \xa73.2\n  const AERO_S_MAX = 0.60;   // upper validity bound of the Smits\u2013Smith fit \u2014 Penner (2003) \xa73.2\n  const CL_C0 = -0.05;       // lift-fit offset \u2014 Smits & Smith (1994)\n  const CL_C1 = 0.0025;      // lift-fit radicand constant \u2014 Smits & Smith (1994)\n  const CL_C2 = 0.36;        // lift-fit radicand slope in S \u2014 Smits & Smith (1994)\n  const CD_C0 = 0.24;        // zero-spin drag of a dimpled ball in the supercritical regime \u2014 Bearman & Harvey\x2C Aeronaut. Q. 27 (1976) 112\n  const CD_C1 = 0.18;        // drag rise per unit spin ratio \u2014 Smits & Smith (1994)\n  function aeroCoefficients(spinRatio) {\n    const S = clamp(spinRatio\x2C AERO_S_MIN\x2C AERO_S_MAX);\n    return { cl: CL_C0 + Math.sqrt(CL_C1 + CL_C2 * S)\x2C cd: CD_C0 + CD_C1 * S };\n  }\n\n  const TRAJ_DT = 0.01;                 // RK4 step\x2C s. Global error is O(dt\u2074) \u21d2 \u22481 cm over a 7 s flight \u2014 five orders of magnitude below GPS resolution.\n  const TRAJ_MAX_FLIGHT_S = 20;         // hard flight-time cap\x2C s; the longest real golf shot flies \u22488 s\n  const TRAJ_MAX_STEPS = Math.ceil(TRAJ_MAX_FLIGHT_S / TRAJ_DT); // DERIVED \u2014 the cap lives in TIME\x2C so changing dt can never silently truncate a trajectory again\n  const TRAJ_REFINE = 14;     // bisection halvings on the terminal step \u21d2 ~1e-6 s landing resolution\n\n  /**\n   * launch : { speedMps\x2C launchDeg\x2C spinRadS\x2C aimOffsetDeg }\n   * env    : { rho\x2C gravity\x2C windAt(z)->{wx\x2Cwz}\x2C coriolis:{ox\x2Coy\x2Coz}\x2C targetDropM }\n   * Returns the state at the moment the ball first descends through targetDropM.\n   */\n  function integrateTrajectory(launch\x2C env) {\n    const m = BALL.massKg\x2C A = BALL.areaM2\x2C r = BALL.radiusM;\n    const halfRhoA = 0.5 * env.rho * A;\n    const g = env.gravity;\n    const drop = num(env.targetDropM\x2C 0);\n    const w = env.coriolis || { ox: 0\x2C oy: 0\x2C oz: 0 };\n    const th = d2r(launch.launchDeg)\x2C az = d2r(num(launch.aimOffsetDeg\x2C 0));\n    let S = [0\x2C 0\x2C 0\x2C\n      launch.speedMps * Math.cos(th) * Math.cos(az)\x2C\n      launch.speedMps * Math.sin(th)\x2C\n      launch.speedMps * Math.cos(th) * Math.sin(az)];\n    // Spin axis fixed in the inertial frame (standard 3-DOF closure). This is what produces\n    // genuine weathercocking in a crosswind rather than naive pure advection.\n    const axis = { x: -Math.sin(az)\x2C y: 0\x2C z: Math.cos(az) };\n    const spin0 = launch.spinRadS;\n    let apex = 0\x2C t = 0\x2C steps = 0;\n\n    const deriv = (s\x2C tt) => {\n      const wind = env.windAt(Math.max(0\x2C s[1]));\n      const vrx = s[3] - wind.wx\x2C vry = s[4]\x2C vrz = s[5] - wind.wz;\n      const v = Math.sqrt(vrx * vrx + vry * vry + vrz * vrz) || EPS;\n      const spin = spin0 * Math.exp(-tt / BALL.spinDecayTauS);\n      const { cl\x2C cd } = aeroCoefficients((spin * r) / v);\n      const q = (halfRhoA * v) / m;\n      let lx = axis.y * vrz - axis.z * vry;\n      let ly = axis.z * vrx - axis.x * vrz;\n      let lz = axis.x * vry - axis.y * vrx;\n      const ln = Math.sqrt(lx * lx + ly * ly + lz * lz) || EPS;\n      lx /= ln; ly /= ln; lz /= ln;\n      const L = q * cl * v;\n      const cx = -2 * (w.oy * s[5] - w.oz * s[4]);   // Coriolis a = \u22122\u03a9\xd7v; \u22485 in of drift on a driver\n      const cy = -2 * (w.oz * s[3] - w.ox * s[5]);\n      const cz = -2 * (w.ox * s[4] - w.oy * s[3]);\n      return [s[3]\x2C s[4]\x2C s[5]\x2C\n      -q * cd * vrx + L * lx + cx\x2C\n      -q * cd * vry + L * ly - g + cy\x2C\n      -q * cd * vrz + L * lz + cz];\n    };\n    const step = (s\x2C tt\x2C h) => {\n      const k1 = deriv(s\x2C tt);\n      const s2 = s.map((v\x2C i) => v + (h / 2) * k1[i]);\n      const k2 = deriv(s2\x2C tt + h / 2);\n      const s3 = s.map((v\x2C i) => v + (h / 2) * k2[i]);\n      const k3 = deriv(s3\x2C tt + h / 2);\n      const s4 = s.map((v\x2C i) => v + h * k3[i]);\n      const k4 = deriv(s4\x2C tt + h);\n      return s.map((v\x2C i) => v + (h / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]));\n    };\n\n    while (steps++ < TRAJ_MAX_STEPS) {\n      const next = step(S\x2C t\x2C TRAJ_DT);\n      if (next[1] > apex) apex = next[1];\n      const descending = next[4] < 0;\n      if (descending && next[1] <= drop && S[1] > drop) {\n        // Refine the landing instant by bisection on the sub-step.\n        let lo = 0\x2C hi = TRAJ_DT;\n        for (let i = 0; i < TRAJ_REFINE; i++) {\n          const mid = 0.5 * (lo + hi);\n          const sm = step(S\x2C t\x2C mid);\n          if (sm[1] > drop) lo = mid; else hi = mid;\n        }\n        const land = step(S\x2C t\x2C 0.5 * (lo + hi));\n        const vh = hypot2(land[3]\x2C land[5]);\n        return {\n          carryM: land[0]\x2C lateralM: land[2]\x2C apexM: apex\x2C\n          timeS: t + 0.5 * (lo + hi)\x2C\n          landSpeedMps: Math.sqrt(land[3] ** 2 + land[4] ** 2 + land[5] ** 2)\x2C\n          descentDeg: r2d(Math.atan2(-land[4]\x2C Math.max(EPS\x2C vh)))\x2C\n          reached: true\x2C\n        };\n      }\n      S = next;\n      t += TRAJ_DT;\n      if (S[1] < drop - 200) break;    // ran off a cliff far below the target; bail\n    }\n    // Never reached the target plane (target above the apex\x2C or step budget exhausted).\n    const vh = hypot2(S[3]\x2C S[5]);\n    return {\n      carryM: S[0]\x2C lateralM: S[2]\x2C apexM: apex\x2C timeS: t\x2C\n      landSpeedMps: Math.sqrt(S[3] ** 2 + S[4] ** 2 + S[5] ** 2)\x2C\n      descentDeg: r2d(Math.atan2(-S[4]\x2C Math.max(EPS\x2C vh)))\x2C\n      reached: false\x2C\n    };\n  }\n\n  // Bounce-and-roll. Energy model: the first bounce retains a descent-angle-dependent\n  // fraction of horizontal speed\x2C then the ball decelerates against an effective turf\n  // friction. Structure per Penner (2003) \xa75; \u03bc and e\u2095 calibrated so the model reproduces\n  // published TrackMan carry-vs-total gaps (driver \u2248 +18 yd\x2C 7-iron \u2248 +4 yd on medium turf).\n  const ROLL_MU = Object.freeze({ firm: 0.40\x2C medium: 0.55\x2C soft: 0.80 }); // effective turf deceleration coefficient \u2014 calibrated per above\n  const ROLL_EH_A = 0.80;      // horizontal restitution at 0\xb0 descent \u2014 calibrated to TrackMan carry/total gaps\n  const ROLL_EH_B = 0.0065;    // loss of horizontal restitution per degree of descent \u2014 calibrated as above\n  const ROLL_EH_MIN = 0.28;    // floor on horizontal restitution for steep wedge landings\n  function rolloutYd(landSpeedMps\x2C descentDeg\x2C firmness = 'medium'\x2C gravity = 9.80665) {\n    if (!(landSpeedMps > 0)) return 0;\n    const mu = ROLL_MU[firmness] || ROLL_MU.medium;\n    const eh = clamp(ROLL_EH_A - ROLL_EH_B * Math.abs(descentDeg)\x2C ROLL_EH_MIN\x2C ROLL_EH_A);\n    const vh = eh * landSpeedMps * Math.cos(d2r(clamp(Math.abs(descentDeg)\x2C 0\x2C 89)));\n    return ((vh * vh) / (2 * mu * gravity)) * M_TO_YD;\n  }\n\n  // TrackMan PGA Tour launch-condition averages (men). Indexed later by *integrated*\n  // standard carry so any constant bias in the aero model cancels in the inverse mapping.\n  // Source: TrackMan Golf\x2C "PGA Tour averages" launch-monitor dataset (ball speed / launch angle / spin rate).\n  const LAUNCH_TABLE = Object.freeze([\n    { ballMph: 167\x2C launchDeg: 10.9\x2C spinRpm: 2686 }\x2C  // Driver \u2014 TrackMan PGA Tour averages\n    { ballMph: 158\x2C launchDeg: 9.2\x2C spinRpm: 3655 }\x2C  // 3-wood \u2014 TrackMan PGA Tour averages\n    { ballMph: 152\x2C launchDeg: 9.4\x2C spinRpm: 4350 }\x2C  // 5-wood \u2014 TrackMan PGA Tour averages\n    { ballMph: 146\x2C launchDeg: 10.2\x2C spinRpm: 4437 }\x2C  // Hybrid \u2014 TrackMan PGA Tour averages\n    { ballMph: 142\x2C launchDeg: 10.4\x2C spinRpm: 4630 }\x2C  // 3-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 137\x2C launchDeg: 11.0\x2C spinRpm: 4836 }\x2C  // 4-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 132\x2C launchDeg: 12.1\x2C spinRpm: 5361 }\x2C  // 5-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 127\x2C launchDeg: 14.1\x2C spinRpm: 6231 }\x2C  // 6-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 120\x2C launchDeg: 16.3\x2C spinRpm: 7097 }\x2C  // 7-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 115\x2C launchDeg: 18.1\x2C spinRpm: 7998 }\x2C  // 8-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 109\x2C launchDeg: 20.4\x2C spinRpm: 8647 }\x2C  // 9-iron \u2014 TrackMan PGA Tour averages\n    { ballMph: 102\x2C launchDeg: 24.2\x2C spinRpm: 9304 }\x2C  // PW \u2014 TrackMan PGA Tour averages\n    { ballMph: 88\x2C launchDeg: 26.5\x2C spinRpm: 9600 }\x2C  // partial-wedge extension\x2C extrapolated on the table's own trend\n    { ballMph: 72\x2C launchDeg: 28.0\x2C spinRpm: 9200 }\x2C  // short-wedge extension\x2C extrapolated on the table's own trend\n  ]);\n\n  const STILL_AIR_ENV = Object.freeze({\n    rho: RHO_STD\x2C\n    gravity: gravityAt(STD_LAT\x2C 0)\x2C\n    windAt: () => ({ wx: 0\x2C wz: 0 })\x2C\n    coriolis: { ox: 0\x2C oy: 0\x2C oz: 0 }\x2C\n    targetDropM: 0\x2C\n  });\n\n  let _launchFamily = null;\n  // Build the standard-condition family once: integrate each table row in still standard\n  // air\x2C then interpolate launch conditions as monotone functions of the resulting carry.\n  function referenceLaunchFamily() {\n    if (_launchFamily) return _launchFamily;\n    const rows = LAUNCH_TABLE.map((L) => {\n      const launch = {\n        speedMps: L.ballMph * MPH_TO_MPS\x2C\n        launchDeg: L.launchDeg\x2C\n        spinRadS: L.spinRpm * RPM_TO_RADS\x2C\n        aimOffsetDeg: 0\x2C\n      };\n      const t = integrateTrajectory(launch\x2C STILL_AIR_ENV);\n      return { carryYd: t.carryM * M_TO_YD\x2C ...launch\x2C apexM: t.apexM };\n    }).sort((a\x2C b) => a.carryYd - b.carryYd);\n    // Extend beyond PGA-Tour carry with self-consistent long-drive anchors so the\n    // solver stays monotone for far tee-to-green measurement taps (par-5 layup\n    // planning). Launch \u224811\xb0\x2C spin \u22481800 rpm (long-drive optimized); ball speed is\n    // solved so the integrator reproduces each anchor carry exactly.\n    const EXT_ANCHORS = [\n      { carryYd: 350\x2C seedMps: 88 }\x2C\n      { carryYd: 460\x2C seedMps: 104 }\x2C\n      { carryYd: 560\x2C seedMps: 118 }\x2C\n      { carryYd: 650\x2C seedMps: 132 }\x2C\n      { carryYd: 780\x2C seedMps: 147 }\x2C\n      { carryYd: 950\x2C seedMps: 164 }\x2C\n    ];\n    for (const { carryYd: targetYd\x2C seedMps } of EXT_ANCHORS) {\n      let speed = seedMps;\n      for (let i = 0; i < 30; i++) {\n        const t0 = integrateTrajectory({\n          speedMps: speed\x2C launchDeg: 11\x2C\n          spinRadS: 1800 * RPM_TO_RADS\x2C aimOffsetDeg: 0\x2C\n        }\x2C STILL_AIR_ENV);\n        const f = t0.carryM * M_TO_YD - targetYd;\n        if (Math.abs(f) < 0.05) break;\n        const h = Math.max(1\x2C 0.02 * speed);\n        const tP = integrateTrajectory({\n          speedMps: speed + h\x2C launchDeg: 11\x2C\n          spinRadS: 1800 * RPM_TO_RADS\x2C aimOffsetDeg: 0\x2C\n        }\x2C STILL_AIR_ENV);\n        const fp = ((tP.carryM * M_TO_YD) - (t0.carryM * M_TO_YD)) / h;\n        speed = fp > 1e-3 ? speed - f / fp : speed + (f > 0 ? 0.5 : -0.5);\n        if (speed < 20) speed = 20;\n      }\n      const t = integrateTrajectory({\n        speedMps: speed\x2C launchDeg: 11\x2C\n        spinRadS: 1800 * RPM_TO_RADS\x2C aimOffsetDeg: 0\x2C\n      }\x2C STILL_AIR_ENV);\n      rows.push({\n        carryYd: t.carryM * M_TO_YD\x2C\n        speedMps: speed\x2C\n        launchDeg: 11\x2C\n        spinRadS: 1800 * RPM_TO_RADS\x2C\n        apexM: t.apexM\x2C\n        extended: true\x2C\n      });\n    }\n    rows.sort((a\x2C b) => a.carryYd - b.carryYd);\n    const tourMaxCarry = Math.max(...rows.filter((r) => !r.extended).map((r) => r.carryYd));\n    // Enforce strict monotonicity so the interpolators are invertible.\n    for (let i = 1; i < rows.length; i++)\n      if (rows[i].carryYd <= rows[i - 1].carryYd) rows[i].carryYd = rows[i - 1].carryYd + 0.5;\n    const cs = rows.map((r) => r.carryYd);\n    _launchFamily = {\n      minCarry: cs[0]\x2C maxCarry: cs[cs.length - 1]\x2C tourMaxCarry\x2C\n      speed: pchip(cs\x2C rows.map((r) => r.speedMps))\x2C\n      launch: pchip(cs\x2C rows.map((r) => r.launchDeg))\x2C\n      spin: pchip(cs\x2C rows.map((r) => r.spinRadS))\x2C\n      apex: pchip(cs\x2C rows.map((r) => r.apexM))\x2C\n      rows\x2C\n    };\n    return _launchFamily;\n  }\n  // Launch conditions for a player whose standard-condition carry is `carryYd`.\n  function launchForStandardCarry(carryYd) {\n    const F = referenceLaunchFamily();\n    // Track the family's calibrated ceiling instead of a hard-coded 650 yd\n    // cap\x2C so plays-like keeps scaling with the real tapped distance no\n    // matter how far the target sits.\n    const c = clamp(num(carryYd\x2C 100)\x2C 8\x2C Math.max(650\x2C Math.round(F.maxCarry)));\n    return {\n      speedMps: Math.max(8\x2C F.speed(c))\x2C\n      launchDeg: clamp(F.launch(c)\x2C 4\x2C 42)\x2C\n      spinRadS: Math.max(500 * RPM_TO_RADS\x2C F.spin(c))\x2C\n      aimOffsetDeg: 0\x2C\n      apexM: Math.max(1\x2C F.apex(c))\x2C\n      extended: c > F.tourMaxCarry\x2C\n    };\n  }\n  // ============================================================\n  //  BLOCK 5 \u2014 PLAYS-LIKE (inverse trajectory solve)\n  //  Replaces: windComponents\x2C PHYSICS\x2C playsLike\x2C playsLikeFor\n  // ============================================================\n\n  /**\n   * Wind decomposition. SINGLE SOURCE OF TRUTH for wind signs app-wide.\n   *   headwindMph  > 0 => into the player;  < 0 => tailwind\n   *   crosswindMph > 0 => FROM the right => pushes ball LEFT => aim RIGHT\n   */\n  function windComponents({ windMph\x2C windFromDeg\x2C bearingDeg } = {}) {\n    const speed = Math.max(0\x2C num(windMph\x2C 0));\n    const theta = d2r(norm(num(windFromDeg\x2C 0)) - norm(num(bearingDeg\x2C 0)));\n    return { headwindMph: speed * Math.cos(theta)\x2C crosswindMph: speed * Math.sin(theta) };\n  }\n\n  const PHYSICS = Object.freeze({\n    // Baselines defining "standard conditions" \u2014 the reference the plays-like number is quoted against.\n    TEMP_BASELINE_F: STD_TEMP_F\x2C          // reference temperature for quoted carry\x2C \xb0F \u2014 TrackMan/USGA test conditions\n    HUMIDITY_BASELINE_RH: STD_RH\x2C         // reference relative humidity\x2C % \u2014 TrackMan/USGA test conditions\n    ALTITUDE_BASELINE_FT: STD_ALT_FT\x2C     // reference altitude\x2C ft \u2014 quoted carry numbers assume sea level\n    MIN_CROSSWIND_MPH: 1.0\x2C               // below this the aim correction is inside GPS/aim noise; report "minimal"\n    SOLVER_TOL_YD: 0.25\x2C                 // inverse-solve tolerance\x2C yd \u2014 GPS error is \xb110\u201330 yd; tighter tolerances burn iterations for nothing\n    SOLVER_MAX_ITER: 14\x2C                  // Newton + bisection safeguard iteration cap\n    // Legacy linear coefficients\x2C retained ONLY so any external reader of PHYSICS.* keeps working.\n    // The solver no longer uses them; they are superseded by the trajectory model.\n    FT_PER_ELEV_YARD: 3\x2C                  // legacy rule of thumb\x2C superseded \u2014 1 yd per 3 ft of elevation\n    HEADWIND_PCT_PER_MPH: 0.01\x2C           // legacy rule of thumb\x2C superseded \u2014 1%/mph into the wind\n    TAILWIND_PCT_PER_MPH: 0.005\x2C          // legacy rule of thumb\x2C superseded \u2014 0.5%/mph downwind\n    TEMP_PCT_PER_10F: 0.0075\x2C             // legacy rule of thumb\x2C superseded \u2014 0.75% per 10\xb0F\n    ALTITUDE_PCT_PER_1000FT: 0.0116\x2C      // legacy rule of thumb\x2C superseded \u2014 1.16% per 1000 ft\n    HUMIDITY_PCT_PER_RH_POINT: -0.0002\x2C   // legacy rule of thumb\x2C superseded\n    HUMIDITY_MAX_ABS_PCT: 0.01\x2C           // legacy clamp\x2C superseded\n    CROSSWIND_AIM_PCT_PER_MPH: 0.01\x2C      // legacy rule of thumb\x2C superseded by integrated lateral deflection\n  });\n\n  // Build the integration environment for a set of on-course conditions.\n  function buildEnv(cond) {\n    const tempF = num(cond.tempF\x2C STD_TEMP_F);\n    const altFt = num(cond.courseAltitudeFt\x2C 0);\n    const rho = airDensity({ tempF\x2C rh: cond.rh\x2C altitudeFt: altFt\x2C pressureHpa: cond.pressureHpa });\n    const bearing = norm(num(cond.bearingDeg\x2C 0));\n    const lat = num(cond.latDeg\x2C STD_LAT);\n    const alpha = Number.isFinite(cond.shearAlpha) ? cond.shearAlpha : null;\n    const speed10 = Math.max(0\x2C num(cond.windMph\x2C 0)) * MPH_TO_MPS;\n    const fromDeg = norm(num(cond.windFromDeg\x2C 0));\n    const phi = d2r(lat);\n    return {\n      rho\x2C\n      gravity: gravityAt(lat\x2C altFt * FT_TO_M)\x2C\n      targetDropM: num(cond.elevDiffFt\x2C 0) * FT_TO_M\x2C\n      // Earth rotation resolved into the shot frame (x\u0302 at bearing \u03b2\x2C \u0177 up\x2C \u1e91 right of x\u0302).\n      coriolis: {\n        ox: OMEGA_EARTH * Math.cos(phi) * Math.cos(d2r(bearing))\x2C\n        oy: OMEGA_EARTH * Math.sin(phi)\x2C\n        oz: -OMEGA_EARTH * Math.cos(phi) * Math.sin(d2r(bearing))\x2C\n      }\x2C\n      windAt(z) {\n        if (speed10 <= 0) return { wx: 0\x2C wz: 0 };\n        const f = alpha != null ? windPowerFactor(z\x2C alpha) : windProfileFactor(z);\n        const spd = speed10 * f;\n        const dir = fromDeg + windVeerDeg(z\x2C lat);\n        const rel = d2r(dir - bearing);\n        // wx = \u2212head\x2C wz = \u2212cross with the windComponents sign convention.\n        return { wx: -spd * Math.cos(rel)\x2C wz: -spd * Math.sin(rel) };\n      }\x2C\n    };\n  }\n\n  const _plCache = makeLRU(400);\n  const _plKey = (D\x2C c) =>\n    [Math.round(D * 2)\x2C Math.round(num(c.elevDiffFt\x2C 0))\x2C Math.round(num(c.courseAltitudeFt\x2C 0) / 25)\x2C\n    Math.round(num(c.tempF\x2C 70))\x2C Math.round(num(c.rh\x2C 50) / 5)\x2C Math.round(num(c.windMph\x2C 0) * 2)\x2C\n    Math.round(norm(num(c.windFromDeg\x2C 0)) / 3)\x2C Math.round(norm(num(c.bearingDeg\x2C 0)) / 3)\x2C\n    Math.round(num(c.pressureHpa\x2C 0))\x2C Math.round(num(c.shearAlpha\x2C 0.143) * 100)\x2C\n    Math.round(num(c.latDeg\x2C 40))].join('|');\n\n  // Carry actually achieved\x2C in yards\x2C by a player whose standard carry is P\x2C under `env`.\n  function carryUnder(P\x2C env) {\n    const L = launchForStandardCarry(P);\n    const t = integrateTrajectory(L\x2C env);\n    return t.reached ? t.carryM * M_TO_YD : Math.max(0\x2C t.carryM * M_TO_YD);\n  }\n\n  /**\n   * Core inverse solve: the standard-condition carry number P such that a shot launched\n   * with P's launch conditions exactly covers `targetYd` under `cond`. Newton on a smooth\n   * monotone function with a bisection safeguard; ~6\u20139 integrations.\n   */\n  function solvePlaysLikeYd(targetYd\x2C cond) {\n    const D = Math.max(0\x2C num(targetYd\x2C 0));\n    if (D < 1) return { playsLikeYd: D\x2C launch: null\x2C traj: null\x2C dCarrydP: 1\x2C env: null };\n    const key = _plKey(D\x2C cond);\n    const hit = _plCache.get(key);\n    if (hit) return hit;\n\n    const env = buildEnv(cond);\n    const famMax = Math.max(650\x2C Math.round(referenceLaunchFamily().maxCarry));\n    let lo = 5\x2C hi = famMax;\n    let P = clamp(D - num(cond.elevDiffFt\x2C 0) / 3\x2C 8\x2C famMax); // legacy linear rule used ONLY as the Newton seed\n    let f = carryUnder(P\x2C env) - D;\n    for (let i = 0; i < PHYSICS.SOLVER_MAX_ITER; i++) {\n      if (Math.abs(f) < PHYSICS.SOLVER_TOL_YD) break;\n      if (f > 0) hi = Math.min(hi\x2C P); else lo = Math.max(lo\x2C P);\n      const h = Math.max(1\x2C 0.02 * P);\n      const fp = (carryUnder(P + h\x2C env) - carryUnder(P - h\x2C env)) / (2 * h);\n      let next = fp > 1e-3 ? P - f / fp : 0.5 * (lo + hi);\n      if (!(next > lo && next < hi)) next = 0.5 * (lo + hi);\n      P = next;\n      f = carryUnder(P\x2C env) - D;\n    }\n    const L = launchForStandardCarry(P);\n    const traj = integrateTrajectory(L\x2C env);\n    const h = Math.max(1\x2C 0.02 * P);\n    const dCarrydP = Math.max(0.2\x2C (carryUnder(P + h\x2C env) - carryUnder(P - h\x2C env)) / (2 * h));\n    const out = { playsLikeYd: P\x2C launch: L\x2C traj\x2C dCarrydP\x2C env };\n    _plCache.set(key\x2C out);\n    return out;\n  }\n\n  /**\n   * PUBLIC SIGNATURE PRESERVED. Same input keys\x2C same output keys\x2C plus extras.\n   * Every *AdjYd is "yards added to horizontalYd"; positive => plays longer.\n   * Attributions are first-order sensitivities from the solved state\x2C renormalized so\n   * the parts sum exactly to the whole (they are not independent in the real physics).\n   */\n  function playsLike(input = {}) {\n    const horizontalYd = Math.max(0\x2C num(input.horizontalYd\x2C 0));\n    const bearingDeg = norm(num(input.bearingDeg\x2C 0));\n    const elevDiffFt = num(input.elevDiffFt\x2C 0);\n    const courseAltitudeFt = num(input.courseAltitudeFt\x2C 0);\n    const tempF = num(input.tempF\x2C STD_TEMP_F);\n    const rh = clamp(num(input.rh\x2C STD_RH)\x2C 0\x2C 100);\n    const windMph = Math.max(0\x2C num(input.windMph\x2C 0));\n    const windFromDeg = norm(num(input.windFromDeg\x2C 0));\n    const lieYd = num(input.lieYd\x2C 0);\n    const pressureHpa = num(input.pressureHpa\x2C NaN);\n    const shearAlpha = num(input.shearAlpha\x2C NaN);\n    const latDeg = num(input.latDeg\x2C STD_LAT);\n    const gustMph = num(input.gustMph\x2C NaN);\n    const firmness = input.firmness || 'medium';\n\n    const { headwindMph\x2C crosswindMph } = windComponents({ windMph\x2C windFromDeg\x2C bearingDeg });\n\n    const cond = {\n      bearingDeg\x2C elevDiffFt\x2C courseAltitudeFt\x2C tempF\x2C rh\x2C windMph\x2C windFromDeg\x2C\n      pressureHpa\x2C shearAlpha\x2C latDeg\n    };\n    const sol = solvePlaysLikeYd(horizontalYd\x2C cond);\n    const P = sol.playsLikeYd;\n    const g = Math.max(0.2\x2C sol.dCarrydP);\n\n    // First-order attribution: switch one factor to its baseline\x2C re-evaluate carry at the\n    // solved launch\x2C and convert the carry change into required-yardage change via dC/dP.\n    // carryOn is independent of the override \u2014 hoisting it drops 4 of the 10\n    // attribution integrations (~30% of playsLike's total cost).\n    const carryOn = horizontalYd >= 1 && sol.env ? carryUnder(P\x2C sol.env) : 0;\n    const attribution = (override) => {\n      if (horizontalYd < 1 || !sol.env) return 0;\n      return (carryUnder(P\x2C buildEnv({ ...cond\x2C ...override })) - carryOn) / g;\n    };\n    let elevAdjYd = elevDiffFt !== 0 ? attribution({ elevDiffFt: 0 }) : 0;\n    let windAdjYd = windMph > 0 ? attribution({ windMph: 0 }) : 0;\n    let tempAdjYd = tempF !== STD_TEMP_F ? attribution({ tempF: STD_TEMP_F }) : 0;\n    let altitudeAdjYd = courseAltitudeFt !== 0 ? attribution({ courseAltitudeFt: 0 }) : 0;\n    let humidityAdjYd = rh !== STD_RH ? attribution({ rh: STD_RH }) : 0;\n\n    // Renormalize so \u03a3 parts == P \u2212 D exactly.\n    const parts = [elevAdjYd\x2C windAdjYd\x2C tempAdjYd\x2C altitudeAdjYd\x2C humidityAdjYd];\n    const sumParts = parts.reduce((a\x2C b) => a + b\x2C 0);\n    const residual = (P - horizontalYd) - sumParts;\n    const absTot = parts.reduce((a\x2C b) => a + Math.abs(b)\x2C 0);\n    if (absTot > 1e-6) {\n      const k = residual / absTot;\n      elevAdjYd += k * Math.abs(elevAdjYd);\n      windAdjYd += k * Math.abs(windAdjYd);\n      tempAdjYd += k * Math.abs(tempAdjYd);\n      altitudeAdjYd += k * Math.abs(altitudeAdjYd);\n      humidityAdjYd += k * Math.abs(humidityAdjYd);\n    }\n\n    const playsLikeYd = Math.max(0\x2C Math.round(P + lieYd));\n\n    // Crosswind aim from the integrated lateral deflection \u2014 not a percent-per-mph rule.\n    let crossFrom\x2C aimYd\x2C aimDeg = 0\x2C lateralDriftYd = 0;\n    if (sol.traj) lateralDriftYd = sol.traj.lateralM * M_TO_YD;\n    if (Math.abs(crosswindMph) < PHYSICS.MIN_CROSSWIND_MPH || horizontalYd < 15) {\n      crossFrom = 'minimal';\n      aimYd = 0;\n    } else {\n      // Solve the aim offset that cancels the deflection: one secant step on aimOffsetDeg.\n      const trial = (aDeg) => {\n        const L = { ...sol.launch\x2C aimOffsetDeg: aDeg };\n        const t = integrateTrajectory(L\x2C sol.env);\n        return t.lateralM * M_TO_YD;\n      };\n      const z0 = lateralDriftYd;\n      const probe = Math.sign(-z0) * 1.5 || 1.5;\n      const z1 = trial(probe);\n      const slope = (z1 - z0) / probe;\n      aimDeg = Math.abs(slope) > 1e-6 ? clamp(-z0 / slope\x2C -25\x2C 25) : 0;\n      aimYd = Math.round(-z0);   // signed: + = aim right\x2C matching crosswind > 0\n      crossFrom = crosswindMph > 0\n        ? 'wind pushes left \u2014 aim right'\n        : 'wind pushes right \u2014 aim left';\n    }\n\n    // Gust exposure: half the head/cross gust delta\x2C expressed in yards of uncertainty.\n    let gustYd = 0;\n    if (Number.isFinite(gustMph) && gustMph > windMph + 1) {\n      const cg = { ...cond\x2C windMph: gustMph };\n      gustYd = Math.abs(solvePlaysLikeYd(horizontalYd\x2C cg).playsLikeYd - P);\n    }\n\n    const rho = sol.env ? sol.env.rho : RHO_STD;\n    const roll = sol.traj\n      ? rolloutYd(sol.traj.landSpeedMps\x2C sol.traj.descentDeg\x2C firmness\x2C\n        sol.env ? sol.env.gravity : 9.80665)\n      : 0;\n\n    return {\n      // --- original keys\x2C unchanged names/meanings ---\n      horizontalYd\x2C playsLikeYd\x2C\n      windAdjYd\x2C tempAdjYd\x2C altitudeAdjYd\x2C humidityAdjYd\x2C elevAdjYd\x2C lieYd\x2C\n      headwindMph\x2C crosswindMph\x2C crossFrom\x2C aimYd\x2C\n      bearingDeg\x2C elevDiffFt\x2C courseAltitudeFt\x2C tempF\x2C rh\x2C windMph\x2C windFromDeg\x2C\n      windPct: horizontalYd > 0 ? windAdjYd / horizontalYd : 0\x2C\n      tempPct: horizontalYd > 0 ? tempAdjYd / horizontalYd : 0\x2C\n      altitudePct: horizontalYd > 0 ? altitudeAdjYd / horizontalYd : 0\x2C\n      humidityPct: horizontalYd > 0 ? humidityAdjYd / horizontalYd : 0\x2C\n      // --- new\x2C additive ---\n      aimDeg\x2C lateralDriftYd\x2C gustYd\x2C\n      rhoKgM3: rho\x2C\n      densityRatio: rho / RHO_STD\x2C\n      apexFt: sol.traj ? sol.traj.apexM * M_TO_FT : null\x2C\n      flightTimeS: sol.traj ? sol.traj.timeS : null\x2C\n      descentDeg: sol.traj ? sol.traj.descentDeg : null\x2C\n      landSpeedMph: sol.traj ? sol.traj.landSpeedMps * MPS_TO_MPH : null\x2C\n      rolloutYd: roll\x2C\n      solvedCarryYd: P\x2C\n      solverReached: sol.traj ? sol.traj.reached : true\x2C\n      extended: sol.launch ? !!sol.launch.extended : false\x2C\n    };\n  }\n\n  // PUBLIC SIGNATURE PRESERVED. Light path \u2014 plays-like number only\x2C no attributions.\n  function playsLikeFor(rawYd\x2C bearing) {\n    const w = getWeatherOrNeutral()\x2C e = getElevationOrNeutral();\n    const d = Math.max(0\x2C num(rawYd\x2C 0));\n    if (d < 1) return Math.round(d);\n    return Math.round(solvePlaysLikeYd(d\x2C {\n      bearingDeg: bearing\x2C\n      elevDiffFt: e.targetFt - e.userFt\x2C\n      courseAltitudeFt: (e.targetFt + e.userFt) / 2\x2C\n      tempF: w.tempF\x2C rh: w.rh\x2C\n      windMph: w.windMph\x2C windFromDeg: w.windFromDeg\x2C\n      pressureHpa: w.pressureHpa\x2C shearAlpha: w.shearAlpha\x2C\n      latDeg: state.loc ? state.loc.lat : STD_LAT\x2C\n    }).playsLikeYd);\n  }\n  // ============================================================\n  //  PATCH B \u2014 ZERO-ALLOCATION 3-DOF INTEGRATOR\n  //  Overrides: integrateTrajectory\x2C buildEnv\n  //  Identical physics and identical return shape to Block 4; the RK4 inner\n  //  loop is rewritten in flat scalars because the array-based version\n  //  allocated ~8 six-element arrays per step (~288k objects/sec at 1 Hz).\n  // ============================================================\n\n  function buildEnv(cond) {\n    const tempF = num(cond.tempF\x2C STD_TEMP_F);\n    const altFt = num(cond.courseAltitudeFt\x2C 0);\n    const rho = airDensity({ tempF\x2C rh: cond.rh\x2C altitudeFt: altFt\x2C pressureHpa: cond.pressureHpa });\n    const bearing = norm(num(cond.bearingDeg\x2C 0));\n    const lat = num(cond.latDeg\x2C STD_LAT);\n    const alpha = Number.isFinite(cond.shearAlpha) ? cond.shearAlpha : null;\n    const speed10 = Math.max(0\x2C num(cond.windMph\x2C 0)) * MPH_TO_MPS;\n    const fromDeg = norm(num(cond.windFromDeg\x2C 0));\n    const phi = d2r(lat);\n    // Reused wind object: the consumer reads it immediately and never retains it\x2C\n    // so mutating one instance removes 4 allocations per integration step.\n    const windOut = { wx: 0\x2C wz: 0 };\n    return {\n      rho\x2C\n      gravity: gravityAt(lat\x2C altFt * FT_TO_M)\x2C\n      targetDropM: num(cond.elevDiffFt\x2C 0) * FT_TO_M\x2C\n      coriolis: {\n        ox: OMEGA_EARTH * Math.cos(phi) * Math.cos(d2r(bearing))\x2C\n        oy: OMEGA_EARTH * Math.sin(phi)\x2C\n        oz: -OMEGA_EARTH * Math.cos(phi) * Math.sin(d2r(bearing))\x2C\n      }\x2C\n      windAt(z) {\n        if (speed10 <= 0) { windOut.wx = 0; windOut.wz = 0; return windOut; }\n        const f = alpha != null ? windPowerFactor(z\x2C alpha) : windProfileFactor(z);\n        const spd = speed10 * f;\n        const rel = d2r(fromDeg + windVeerDeg(z\x2C lat) - bearing);\n        windOut.wx = -spd * Math.cos(rel);\n        windOut.wz = -spd * Math.sin(rel);\n        return windOut;\n      }\x2C\n    };\n  }\n\n  function integrateTrajectory(launch\x2C env) {\n    const r = BALL.radiusM;\n    const invM = 1 / BALL.massKg;\n    const halfRhoA = 0.5 * env.rho * BALL.areaM2;\n    const grav = env.gravity;\n    const drop = num(env.targetDropM\x2C 0);\n    const co = env.coriolis || { ox: 0\x2C oy: 0\x2C oz: 0 };\n    const c2x = 2 * co.ox\x2C c2y = 2 * co.oy\x2C c2z = 2 * co.oz;\n    const windAt = env.windAt;\n    const th = d2r(launch.launchDeg)\x2C az = d2r(num(launch.aimOffsetDeg\x2C 0));\n    const axX = -Math.sin(az)\x2C axZ = Math.cos(az);   // spin axis; axY = 0\n    const spin0 = launch.spinRadS;\n    const invTau = 1 / BALL.spinDecayTauS;\n    const dt = TRAJ_DT;\n\n    let aX = 0\x2C aY = 0\x2C aZ = 0;          // accel scratch\n    let sX = 0\x2C sY = 0\x2C sZ = 0\x2C sVX = 0\x2C sVY = 0\x2C sVZ = 0;   // step scratch\n\n    function accel(py\x2C pvx\x2C pvy\x2C pvz\x2C tt) {\n      const wind = windAt(py > 0 ? py : 0);\n      const vrx = pvx - wind.wx\x2C vry = pvy\x2C vrz = pvz - wind.wz;\n      let v = Math.sqrt(vrx * vrx + vry * vry + vrz * vrz);\n      if (!(v > EPS)) v = EPS;\n      let S = (spin0 * Math.exp(-tt * invTau) * r) / v;\n      if (S < AERO_S_MIN) S = AERO_S_MIN; else if (S > AERO_S_MAX) S = AERO_S_MAX;\n      const cl = CL_C0 + Math.sqrt(CL_C1 + CL_C2 * S);\n      const cd = CD_C0 + CD_C1 * S;\n      const q = halfRhoA * v * invM;\n      // lift direction = normalize(axis \xd7 vRel)\x2C axis = (axX\x2C 0\x2C axZ)\n      const lx = -axZ * vry\x2C ly = axZ * vrx - axX * vrz\x2C lz = axX * vry;\n      let ln = Math.sqrt(lx * lx + ly * ly + lz * lz);\n      if (!(ln > EPS)) ln = EPS;\n      const Lq = (q * cl * v) / ln;\n      aX = -q * cd * vrx + Lq * lx - (c2y * pvz - c2z * pvy);\n      aY = -q * cd * vry + Lq * ly - grav - (c2z * pvx - c2x * pvz);\n      aZ = -q * cd * vrz + Lq * lz - (c2x * pvy - c2y * pvx);\n    }\n\n    function stepTo(x0\x2C y0\x2C z0\x2C vx0\x2C vy0\x2C vz0\x2C t0\x2C h) {\n      const h2 = 0.5 * h\x2C h6 = h / 6;\n      accel(y0\x2C vx0\x2C vy0\x2C vz0\x2C t0);\n      const k1px = vx0\x2C k1py = vy0\x2C k1pz = vz0\x2C k1vx = aX\x2C k1vy = aY\x2C k1vz = aZ;\n      let vX = vx0 + h2 * k1vx\x2C vY = vy0 + h2 * k1vy\x2C vZ = vz0 + h2 * k1vz;\n      accel(y0 + h2 * k1py\x2C vX\x2C vY\x2C vZ\x2C t0 + h2);\n      const k2px = vX\x2C k2py = vY\x2C k2pz = vZ\x2C k2vx = aX\x2C k2vy = aY\x2C k2vz = aZ;\n      vX = vx0 + h2 * k2vx; vY = vy0 + h2 * k2vy; vZ = vz0 + h2 * k2vz;\n      accel(y0 + h2 * k2py\x2C vX\x2C vY\x2C vZ\x2C t0 + h2);\n      const k3px = vX\x2C k3py = vY\x2C k3pz = vZ\x2C k3vx = aX\x2C k3vy = aY\x2C k3vz = aZ;\n      vX = vx0 + h * k3vx; vY = vy0 + h * k3vy; vZ = vz0 + h * k3vz;\n      accel(y0 + h * k3py\x2C vX\x2C vY\x2C vZ\x2C t0 + h);\n      sX = x0 + h6 * (k1px + 2 * k2px + 2 * k3px + vX);\n      sY = y0 + h6 * (k1py + 2 * k2py + 2 * k3py + vY);\n      sZ = z0 + h6 * (k1pz + 2 * k2pz + 2 * k3pz + vZ);\n      sVX = vx0 + h6 * (k1vx + 2 * k2vx + 2 * k3vx + aX);\n      sVY = vy0 + h6 * (k1vy + 2 * k2vy + 2 * k3vy + aY);\n      sVZ = vz0 + h6 * (k1vz + 2 * k2vz + 2 * k3vz + aZ);\n    }\n\n    let x = 0\x2C y = 0\x2C z = 0;\n    const cth = Math.cos(th);\n    let vx = launch.speedMps * cth * Math.cos(az);\n    let vy = launch.speedMps * Math.sin(th);\n    let vz = launch.speedMps * cth * Math.sin(az);\n    let apex = 0\x2C t = 0\x2C steps = 0;\n\n    while (steps++ < TRAJ_MAX_STEPS) {\n      stepTo(x\x2C y\x2C z\x2C vx\x2C vy\x2C vz\x2C t\x2C dt);\n      if (sY > apex) apex = sY;\n      if (sVY < 0 && sY <= drop && y > drop) {\n        let lo = 0\x2C hi = dt;\n        for (let i = 0; i < TRAJ_REFINE; i++) {\n          const mid = 0.5 * (lo + hi);\n          stepTo(x\x2C y\x2C z\x2C vx\x2C vy\x2C vz\x2C t\x2C mid);\n          if (sY > drop) lo = mid; else hi = mid;\n        }\n        const hFin = 0.5 * (lo + hi);\n        stepTo(x\x2C y\x2C z\x2C vx\x2C vy\x2C vz\x2C t\x2C hFin);\n        const vh = hypot2(sVX\x2C sVZ);\n        return {\n          carryM: sX\x2C lateralM: sZ\x2C apexM: apex\x2C timeS: t + hFin\x2C\n          landSpeedMps: Math.sqrt(sVX * sVX + sVY * sVY + sVZ * sVZ)\x2C\n          descentDeg: r2d(Math.atan2(-sVY\x2C Math.max(EPS\x2C vh)))\x2C\n          reached: true\x2C\n        };\n      }\n      x = sX; y = sY; z = sZ; vx = sVX; vy = sVY; vz = sVZ;\n      t += dt;\n      if (y < drop - 200) break;\n    }\n    const vh = hypot2(vx\x2C vz);\n    return {\n      carryM: x\x2C lateralM: z\x2C apexM: apex\x2C timeS: t\x2C\n      landSpeedMps: Math.sqrt(vx * vx + vy * vy + vz * vz)\x2C\n      descentDeg: r2d(Math.atan2(-vy\x2C Math.max(EPS\x2C vh)))\x2C\n      reached: false\x2C\n    };\n  }\n  // ============================================================\n  //  BLOCK 6 \u2014 GPS ESTIMATION\n  //  Replaces: kalman\x2C weightedAverage\x2C impliedSpeedReject\x2C onPosition\x2C updateGpsUI\n  // ============================================================\n\n  // The W3C Geolocation API defines `accuracy` as a 95%-confidence horizontal radius\x2C\n  // so the per-axis 1\u03c3 is R95 / (Rayleigh 95th percentile)\x2C NOT R95 itself.\n  // Ref: W3C Geolocation API Level 2\x2C GeolocationCoordinates.accuracy.\n  const GPS_ACC_TO_SIGMA = 1 / RAYLEIGH_95;\n  const KF_SIGMA_A = 0.45;          // pedestrian acceleration spectral density\x2C m/s\xb2 \u2014 CWNA model\x2C Bar-Shalom et al.\x2C Estimation with Applications to Tracking and Navigation (2001) \xa76.2\n  const KF_SIGMA_A_MIN = 0.10;      // lower bound when adaptation says the target is nearly static\n  const KF_SIGMA_A_MAX = 2.50;      // upper bound; above this the filter is effectively pass-through\n  const KF_GATE_P = 0.995;          // \u03c7\xb2\u2082 innovation gate probability \u2014 standard 2-D track gating\x2C Bar-Shalom \xa72.3\n  const KF_NIS_WINDOW = 12;         // sliding window for normalized-innovation-squared adaptation \u2014 Mehra\x2C IEEE TAC 17 (1972) 693\n  const KF_NIS_TARGET = 2;          // E[NIS] equals the measurement dimension when the model is consistent\n  const KF_ZUPT_SPEED_MPS = 0.35;   // below this the player is standing over the ball \u2014 zero-velocity update threshold\n  const KF_ZUPT_R = 0.01;           // pseudo-measurement variance for the ZUPT\x2C (m/s)\xb2 \u2014 tight by design\n  const GPS_CORRELATED_FRAC = 0.45; // fraction of the reported error that is bias-like (multipath/iono) and cannot be averaged away \u2014 Misra & Enge\x2C Global Positioning System 2nd ed. \xa75\n  const GPS_MAX_FUSE_N = 6;         // cap on effective sample count in the fuser\x2C reflecting the above correlation\n  const KF_MAX_DT_S = 12;           // beyond this gap the velocity estimate is worthless \u2014 reset velocity\n  const KF_REBASE_M = 3000;         // re-origin the ENU frame past this distance to keep the tangent-plane error negligible\n\n  const kalman = (() => {\n    let fr = null;                          // ENU frame\n    let x = null;                           // [e\x2C n\x2C ve\x2C vn]\n    let P = null;                           // 4x4 covariance\n    let lastT = 0;\n    let sigmaA = KF_SIGMA_A;\n    let nisBuf = [];\n    let rejects = 0;\n    let speedBuf = [];\n    const GATE = chi2Inv(KF_GATE_P\x2C 2);\n\n    const mat4 = () => [[0\x2C 0\x2C 0\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 0]];\n    function predict(dt) {\n      // x = F x\n      x[0] += x[2] * dt; x[1] += x[3] * dt;\n      // P = F P F\u1d40 + Q\x2C with the exact continuous-white-noise-acceleration Q.\n      const q = sigmaA * sigmaA;\n      const q11 = (q * dt * dt * dt) / 3\x2C q12 = (q * dt * dt) / 2\x2C q22 = q * dt;\n      const F = [[1\x2C 0\x2C dt\x2C 0]\x2C [0\x2C 1\x2C 0\x2C dt]\x2C [0\x2C 0\x2C 1\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 1]];\n      const FP = mat4();\n      for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) {\n        let s = 0; for (let k = 0; k < 4; k++) s += F[i][k] * P[k][j];\n        FP[i][j] = s;\n      }\n      const NP = mat4();\n      for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) {\n        let s = 0; for (let k = 0; k < 4; k++) s += FP[i][k] * F[j][k];\n        NP[i][j] = s;\n      }\n      NP[0][0] += q11; NP[1][1] += q11; NP[2][2] += q22; NP[3][3] += q22;\n      NP[0][2] += q12; NP[2][0] += q12; NP[1][3] += q12; NP[3][1] += q12;\n      P = NP;\n    }\n    function symmetrize() {\n      for (let i = 0; i < 4; i++) for (let j = i + 1; j < 4; j++) {\n        const m = 0.5 * (P[i][j] + P[j][i]); P[i][j] = m; P[j][i] = m;\n      }\n    }\n    function zupt() {\n      // Pseudo-measurement v = 0 on both velocity components.\n      for (const idx of [2\x2C 3]) {\n        const S = P[idx][idx] + KF_ZUPT_R;\n        if (!(S > 0)) continue;\n        const K = [P[0][idx] / S\x2C P[1][idx] / S\x2C P[2][idx] / S\x2C P[3][idx] / S];\n        const nu = -x[idx];\n        for (let i = 0; i < 4; i++) x[i] += K[i] * nu;\n        const row = [P[idx][0]\x2C P[idx][1]\x2C P[idx][2]\x2C P[idx][3]];\n        for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) P[i][j] -= K[i] * row[j];\n        symmetrize();\n      }\n    }\n    return {\n      // SIGNATURE PRESERVED: returns { lat\x2C lng } (plus extras).\n      process(newLat\x2C newLng\x2C accuracyM\x2C tsMs) {\n        const sig = Math.max(0.8\x2C num(accuracyM\x2C 30) * GPS_ACC_TO_SIGMA);\n        const Rm = sig * sig;\n        if (!fr || !x) {\n          fr = enuFrame({ lat: newLat\x2C lng: newLng });\n          x = [0\x2C 0\x2C 0\x2C 0];\n          P = [[Rm\x2C 0\x2C 0\x2C 0]\x2C [0\x2C Rm\x2C 0\x2C 0]\x2C [0\x2C 0\x2C 25\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 25]];  // initial velocity \u03c3 = 5 m/s (unknown gait)\n          lastT = tsMs; nisBuf = []; speedBuf = []; rejects = 0;\n          return { lat: newLat\x2C lng: newLng\x2C accuracy95: accuracyM\x2C speedMps: 0\x2C gated: false };\n        }\n        let dt = (tsMs - lastT) / 1000;\n        if (!(dt > 0)) dt = 0.05;\n        if (dt > KF_MAX_DT_S) { x[2] = 0; x[3] = 0; P[2][2] = 25; P[3][3] = 25; }\n        lastT = tsMs;\n        predict(Math.min(dt\x2C KF_MAX_DT_S));\n\n        const z = toENU(fr\x2C { lat: newLat\x2C lng: newLng });\n        const nu = [z.e - x[0]\x2C z.n - x[1]];\n        const S11 = P[0][0] + Rm\x2C S22 = P[1][1] + Rm\x2C S12 = P[0][1];\n        const det = S11 * S22 - S12 * S12;\n        let d2 = 0\x2C gated = false;\n        if (det > 0) {\n          d2 = (nu[0] * (S22 * nu[0] - S12 * nu[1]) + nu[1] * (S11 * nu[1] - S12 * nu[0])) / det;\n        }\n        if (d2 > GATE) {\n          rejects++;\n          if (rejects < MAX_CONSECUTIVE_REJECTS) {\n            gated = true;                     // reject the outlier\x2C keep the prediction\n          } else {\n            // Persistent disagreement means the filter\x2C not the fix\x2C is wrong: re-initialize.\n            fr = enuFrame({ lat: newLat\x2C lng: newLng });\n            x = [0\x2C 0\x2C 0\x2C 0];\n            P = [[Rm\x2C 0\x2C 0\x2C 0]\x2C [0\x2C Rm\x2C 0\x2C 0]\x2C [0\x2C 0\x2C 25\x2C 0]\x2C [0\x2C 0\x2C 0\x2C 25]];\n            rejects = 0; nisBuf = []; speedBuf = [];\n            return { lat: newLat\x2C lng: newLng\x2C accuracy95: accuracyM\x2C speedMps: 0\x2C gated: false\x2C reinit: true };\n          }\n        } else {\n          rejects = 0;\n        }\n\n        if (!gated) {\n          nisBuf.push(d2);\n          if (nisBuf.length > KF_NIS_WINDOW) nisBuf.shift();\n          // K = P H\u1d40 S\u207b\xb9 with H = [I 0]\n          const iS = [[S22 / det\x2C -S12 / det]\x2C [-S12 / det\x2C S11 / det]];\n          const K = [[0\x2C 0]\x2C [0\x2C 0]\x2C [0\x2C 0]\x2C [0\x2C 0]];\n          for (let i = 0; i < 4; i++) {\n            const p0 = P[i][0]\x2C p1 = P[i][1];\n            K[i][0] = p0 * iS[0][0] + p1 * iS[1][0];\n            K[i][1] = p0 * iS[0][1] + p1 * iS[1][1];\n          }\n          for (let i = 0; i < 4; i++) x[i] += K[i][0] * nu[0] + K[i][1] * nu[1];\n          const H0 = [P[0][0]\x2C P[0][1]\x2C P[0][2]\x2C P[0][3]];\n          const H1 = [P[1][0]\x2C P[1][1]\x2C P[1][2]\x2C P[1][3]];\n          for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++)\n            P[i][j] -= K[i][0] * H0[j] + K[i][1] * H1[j];\n          symmetrize();\n\n          // Mehra-style adaptation: drive mean NIS toward the measurement dimension.\n          if (nisBuf.length >= 6) {\n            const meanNis = nisBuf.reduce((a\x2C b) => a + b\x2C 0) / nisBuf.length;\n            const ratio = clamp(Math.sqrt(meanNis / KF_NIS_TARGET)\x2C 0.85\x2C 1.18);\n            sigmaA = clamp(sigmaA * ratio\x2C KF_SIGMA_A_MIN\x2C KF_SIGMA_A_MAX);\n          }\n        }\n\n        const spd = hypot2(x[2]\x2C x[3]);\n        speedBuf.push(spd);\n        if (speedBuf.length > 5) speedBuf.shift();\n        if (median(speedBuf) < KF_ZUPT_SPEED_MPS) zupt();\n\n        // Re-origin the tangent frame if we have wandered a long way.\n        if (Math.abs(x[0]) > KF_REBASE_M || Math.abs(x[1]) > KF_REBASE_M) {\n          const here = fromENU(fr\x2C x[0]\x2C x[1]);\n          fr = enuFrame(here); x[0] = 0; x[1] = 0;\n        }\n        const ll = fromENU(fr\x2C x[0]\x2C x[1]);\n        return {\n          lat: ll.lat\x2C lng: ll.lng\x2C\n          accuracy95: this.accuracy95(accuracyM)\x2C\n          speedMps: hypot2(x[2]\x2C x[3])\x2C\n          gated\x2C\n        };\n      }\x2C\n      // Honest 95% radius: circularized filter covariance\x2C floored by the irreducible\n      // correlated (bias-like) component of the raw device error.\n      accuracy95(rawAccM) {\n        if (!P) return num(rawAccM\x2C 30);\n        const varAvg = 0.5 * (P[0][0] + P[1][1]);\n        const filt = RAYLEIGH_95 * Math.sqrt(Math.max(0\x2C varAvg));\n        const floor = GPS_CORRELATED_FRAC * num(rawAccM\x2C 30);\n        return Math.max(filt\x2C floor);\n      }\x2C\n      speedMps() { return x ? hypot2(x[2]\x2C x[3]) : 0; }\x2C\n      headingDeg() { return x && hypot2(x[2]\x2C x[3]) > 0.3 ? norm(r2d(Math.atan2(x[2]\x2C x[3]))) : null; }\x2C\n      sigmaA() { return sigmaA; }\x2C\n      reset() { fr = null; x = null; P = null; lastT = 0; sigmaA = KF_SIGMA_A; nisBuf = []; speedBuf = []; rejects = 0; }\x2C\n    };\n  })();\n\n  /**\n   * SIGNATURE PRESERVED: weightedAverage(fixes) -> { lat\x2C lng\x2C accuracy }.\n   * Now a robust inverse-variance fusion with Huber down-weighting of outliers and a\n   * CORRECT fused accuracy. The old version returned min(accuracy)\x2C which claimed the\n   * precision of the single best fix for an average of ten \u2014 badly overconfident.\n   */\n  const HUBER_K = 1.345;   // Huber tuning constant giving 95% Gaussian efficiency \u2014 Huber\x2C Ann. Math. Stat. 35 (1964) 73\n  function weightedAverage(fixes) {\n    const list = (fixes || []).filter((f) => f && Number.isFinite(f.lat) && Number.isFinite(f.lng));\n    if (!list.length) return { lat: 0\x2C lng: 0\x2C accuracy: 9999 };\n    const last = list[list.length - 1];\n    if (list.length === 1) return { lat: last.lat\x2C lng: last.lng\x2C accuracy: num(last.accuracy\x2C 30) };\n\n    const fr = enuFrame(last);\n    const pts = list.map((f) => ({ ...toENU(fr\x2C f)\x2C sig: Math.max(0.8\x2C num(f.accuracy\x2C 30) * GPS_ACC_TO_SIGMA) }));\n    // Robust centre: start at the coordinate-wise median\x2C then 3 Huber IRLS passes.\n    let ce = median(pts.map((p) => p.e))\x2C cn = median(pts.map((p) => p.n));\n    const scale = Math.max(1\x2C madSigma(pts.map((p) => hypot2(p.e - ce\x2C p.n - cn))) || 1);\n    let sw = 0;\n    for (let it = 0; it < 3; it++) {\n      let se = 0\x2C sn = 0; sw = 0;\n      for (const p of pts) {\n        const r = hypot2(p.e - ce\x2C p.n - cn) / scale;\n        const hub = r <= HUBER_K ? 1 : HUBER_K / Math.max(EPS\x2C r);\n        const w = hub / (p.sig * p.sig);\n        se += p.e * w; sn += p.n * w; sw += w;\n      }\n      if (sw <= 0) break;\n      ce = se / sw; cn = sn / sw;\n    }\n    // Fused \u03c3\x2C then inflate for temporally correlated GPS error: averaging n correlated\n    // fixes buys at most GPS_MAX_FUSE_N-fold variance reduction\x2C and never beats the\n    // bias-like floor of the best single fix.\n    const sigIdeal = sw > 0 ? Math.sqrt(1 / sw) : num(last.accuracy\x2C 30) * GPS_ACC_TO_SIGMA;\n    const nEff = Math.min(list.length\x2C GPS_MAX_FUSE_N);\n    const sigCorr = sigIdeal * Math.sqrt(Math.max(1\x2C list.length / nEff));\n    const bestRaw = Math.min(...list.map((f) => num(f.accuracy\x2C 30)));\n    const acc95 = Math.max(sigCorr * RAYLEIGH_95\x2C GPS_CORRELATED_FRAC * bestRaw);\n    const ll = fromENU(fr\x2C ce\x2C cn);\n    return { lat: ll.lat\x2C lng: ll.lng\x2C accuracy: acc95 };\n  }\n\n  /**\n   * SIGNATURE PRESERVED: impliedSpeedReject(prev\x2C next) -> boolean.\n   * Statistical test instead of a fixed slack constant: reject only when the implied\n   * displacement is inconsistent with a walking player at the stated uncertainties.\n   */\n  const WALK_SPEED_SIGMA_MPS = 0.9;   // between-fix speed spread for a walking/riding golfer\x2C m/s \u2014 pedestrian gait variability\n  const SPEED_REJECT_Z = 4.0;         // 4\u03c3 one-sided \u21d2 ~3e-5 false-reject rate per fix\n  function impliedSpeedReject(prev\x2C next) {\n    if (!prev || !next) return false;\n    const dt = Math.max(0.25\x2C (next.ts - prev.ts) / 1000);\n    const dist = haversineMeters(prev\x2C next);\n    const sp = num(prev.accuracy\x2C 30) * GPS_ACC_TO_SIGMA;\n    const sn = num(next.accuracy\x2C 30) * GPS_ACC_TO_SIGMA;\n    const sigDist = Math.sqrt(sp * sp + sn * sn);                       // \u03c3 of the measured separation\n    const sigTot = Math.sqrt(sigDist * sigDist + (WALK_SPEED_SIGMA_MPS * dt) ** 2);\n    const expected = MAX_GPS_SPEED_MPS * dt;\n    return dist - SPEED_REJECT_Z * sigTot > expected;\n  }\n\n  // SIGNATURE PRESERVED.\n  function onPosition(pos) {\n    const c = pos.coords;\n    const raw = {\n      lat: c.latitude\x2C lng: c.longitude\x2C accuracy: c.accuracy\x2C\n      altitude: Number.isFinite(c.altitude) ? c.altitude : null\x2C\n      altitudeAccuracy: Number.isFinite(c.altitudeAccuracy) ? c.altitudeAccuracy : null\x2C\n      ts: pos.timestamp || Date.now()\x2C\n    };\n    state.lastRawFix = raw;\n\n    if (raw.accuracy > APPROX_ACC_M && !state.preciseHintShown &&\n      Date.now() - state.gpsStartedAt > 9000) {\n      state.preciseHintShown = true;\n      setNotice('Location looks approximate (\xb1' + Math.round(raw.accuracy) +\n        ' m). For real yardages\x2C turn on Precise Location for Safari/this app in iPhone Settings \u2014 tap the gear for the path.'\x2C 'danger');\n    }\n\n    const anchor = state.lastAcceptedFix;\n    const tooMany = state.consecutiveRejects >= MAX_CONSECUTIVE_REJECTS;\n    const tooOld = anchor && raw.ts - anchor.ts > REBASE_AFTER_MS;\n    if (anchor && !tooMany && !tooOld && impliedSpeedReject(anchor\x2C raw)) {\n      state.consecutiveRejects++;\n      return;\n    }\n    state.consecutiveRejects = 0;\n    state.lastAcceptedFix = raw;\n\n    state.fixSamples.push(raw);\n    if (state.fixSamples.length > 10) state.fixSamples.shift();\n    const wAvg = weightedAverage(state.fixSamples);\n    const sm = kalman.process(wAvg.lat\x2C wAvg.lng\x2C wAvg.accuracy\x2C raw.ts);\n    state.smoothed = sm;\n    // Report the filter's own 95% radius\x2C never better than the correlated-error floor.\n    const acc = Number.isFinite(sm.accuracy95)\n      ? sm.accuracy95\n      : num(wAvg.accuracy\x2C raw.accuracy);\n    state.currentAccuracy = acc;\n    state.loc = {\n      lat: sm.lat\x2C lng: sm.lng\x2C accuracy: acc\x2C\n      altitude: raw.altitude\x2C ts: raw.ts\x2C\n    };\n    state.locStale = false;\n    state.gpsDenied = false;\n    save('caddy:lastLocation'\x2C state.loc);\n    updateGpsUI();\n    updateUserMarker();\n    if (state.map && !state.pannedOnce) {\n      state.map.setView([state.loc.lat\x2C state.loc.lng]\x2C 17\x2C { animate: !reduceMotion });\n      state.pannedOnce = true;\n    } else if (state.map && state.followMode === FollowMode.LOCKED) {\n      holdLockedView({ lat: state.loc.lat\x2C lng: state.loc.lng }\x2C !reduceMotion);\n    }\n    if (state.target) {\n      // GPS ticks fire ~once per second and each fix nudges the smoothed\n      // position slightly\x2C which used to run the FULL inverse-trajectory\n      // solve every time. Recalculate only when you've actually moved far\n      // enough for the number to change. Taps\x2C aim changes\x2C green marks\n      // and weather/elevation refreshes all call calculateRange()\n      // themselves and are never delayed by this gate.\n      const movedYd = state.lastCalcLoc\n        ? haversineMeters(state.lastCalcLoc\x2C state.loc) * M_TO_YD\n        : Infinity;\n      if (movedYd >= RANGE_RECALC_MOVE_YD) calculateRange();\n    }\n\n    if (roundStatus() !== 'idle') {\n      renderRoundShotUI();\n    }\n\n    const roundSetupIsOpen =\n      els.roundSetupSheet?.classList.contains('open');\n\n    if (\n      roundSetupIsOpen &&\n      state.nearbySearchRequested &&\n      !state.nearbyCourseLoading\n    ) {\n      findNearbyCourses();\n    }\n\n    scheduleContextUpdate();\n  }\n\n  // SIGNATURE PRESERVED. Now also surfaces convergence progress and motion state.\n  function updateGpsUI(forceState) {\n    const dot = els.gpsDot;\n    dot.className = 'gps-dot';\n    if (!state.gpsRunning && !state.loc) {\n      if (state.gpsDenied) { dot.classList.add('bad'); els.gpsText.textContent = 'GPS denied'; }\n      else els.gpsText.textContent = 'Enable GPS';\n      return;\n    }\n    if ((forceState === 'searching' && !state.loc) || !state.loc) {\n      dot.classList.add('searching');\n      els.gpsText.textContent = 'Locating\u2026';\n      return;\n    }\n    const accYd = (state.loc.accuracy || 0) * M_TO_YD;\n    const moving = kalman.speedMps() > KF_ZUPT_SPEED_MPS;\n    const suffix = moving ? '' : ' \xb7 settled';\n    if (state.locStale || !state.gpsRunning) {\n      dot.classList.add('warn');\n      els.gpsText.textContent = `Last GPS \xb7 \xb1${fmt(accYd)} yd`;\n    } else if (state.loc.accuracy > USABLE_ACC_M) {\n      dot.classList.add('warn');\n      els.gpsText.textContent = `GPS \xb1${fmt(accYd)} yd`;\n    } else {\n      dot.classList.add('good');\n      els.gpsText.textContent = `GPS \xb1${fmt(accYd)} yd${suffix}`;\n    }\n    // The pill width changed \u2014 keep the advice pill clear of it.\n    positionBottomPills();\n  }\n  // ============================================================\n  //  BLOCK 7 \u2014 SHOT LOG + BAYESIAN DISPERSION MODEL\n  //  Replaces: logShot\x2C shotDataSummary\x2C clubStats\x2C\n  //            formulaDispersionYd\x2C clubDispersionYd + their constants\n  //  Schema: caddy:shotLog:v1 entries are EITHER a legacy number (total yd)\n  //          OR { d: totalYd\x2C c: carryYd\x2C l: lateralYd|null\x2C t: ms\x2C a: gpsAccM }.\n  // ============================================================\n\n  const SHOT_FULL_TRUST_N = 5;      // legacy name kept; the posterior now blends continuously\x2C this only gates UI copy\n  const SHOT_MIN_TRUST_N = 2;       // legacy name kept; minimum n before tracked data influences the posterior mean\n  const SHOT_MAX_PER_CLUB = 200;    // ring-buffer cap; recency weighting makes a longer history harmless\n  const DISPERSION_SIGMAS = 1.5;    // legacy name kept; superseded by DISPERSION_COVERAGE below\n\n  // Prior on relative distance dispersion. Tour distance-control \u03c3 is \u22484% of carry for\n  // short irons rising to \u22486% for the driver; amateurs run ~1.5\u20132\xd7 that.\n  // Ref: Broadie\x2C Every Shot Counts (2014) ch.4 & Interfaces 42 (2012) 146 (shot-pattern analysis);\n  //      TrackMan/Arccos aggregate dispersion studies for the amateur multiplier.\n  const DISP_REL_SHORT = 0.045;     // prior relative \u03c3 at short-iron distances \u2014 Broadie (2012/2014) shot patterns\n  const DISP_REL_LONG = 0.062;      // prior relative \u03c3 at driver distances \u2014 Broadie (2012/2014) shot patterns\n  const DISP_REL_KNEE_LO = 110;     // carry\x2C yd\x2C at which the short-iron relative \u03c3 applies\n  const DISP_REL_KNEE_HI = 270;     // carry\x2C yd\x2C at which the driver relative \u03c3 applies\n  const DISP_AMATEUR_MULT = 1.55;   // prior inflation for a non-tour player \u2014 Arccos/Shot Scope amateur dispersion aggregates\n  const DISP_FLOOR_YD = 3;          // no club is tighter than this in practice; also guards tiny samples\n  const DISP_PRIOR_STRENGTH = 6;    // \u03bd\u2080: prior worth ~6 observations\x2C so ~6 shots move \u03c3 halfway to measured\n  const DISP_HALFLIFE_DAYS = 240;   // recency half-life; a season-old shot carries half the weight of today's\n  const DISPERSION_COVERAGE = 0.87; // two-sided predictive coverage of the reported \xb1 band (\u2248\xb11.5\u03c3 for large n)\n  const LATERAL_REL_PRIOR = 0.065;  // prior relative \u03c3 of lateral dispersion (offline as a fraction of carry) \u2014 Broadie (2014) ch.4\n  const SHOT_SANITY_LO = 0.40;      // hard reject below 40% of stock: topped/chunked\x2C not a distance sample\n  const SHOT_SANITY_HI = 1.60;      // hard reject above 160% of stock: mis-tagged club or GPS blowup\n  const MISS_BIAS_MIN_N = 5;        // tracked shots with lateral data before miss-direction coaching activates\n\n  // QA-004: every value must be an array of shots \u2014 a string/number value\n  // here used to crash missDirectionSummary and the CSV export.\n  function sanitizeShotLog(v) {\n    if (!v || typeof v !== 'object' || Array.isArray(v)) return {};\n    const out = {};\n    for (const k of Object.keys(v)) if (Array.isArray(v[k])) out[k] = v[k];\n    return out;\n  }\n\n  function loadShotLog() {\n    const v = load(SHOTLOG_KEY\x2C {});\n    return sanitizeShotLog(v);\n  }\n  function saveShotLog(log) { save(SHOTLOG_KEY\x2C log); }\n\n  // Normalize either schema to { d\x2C c\x2C l\x2C t\x2C a }.\n  function normalizeShotEntry(e) {\n    if (Number.isFinite(e)) return { d: e\x2C c: null\x2C l: null\x2C t: null\x2C a: null };\n    if (!e || typeof e !== 'object') return null;\n    const d = Number(e.d);\n    if (!Number.isFinite(d) || d <= 0) return null;\n    return {\n      d\x2C\n      c: Number.isFinite(e.c) ? Number(e.c) : null\x2C\n      l: Number.isFinite(e.l) ? Number(e.l) : null\x2C\n      t: Number.isFinite(e.t) ? Number(e.t) : null\x2C\n      a: Number.isFinite(e.a) ? Number(e.a) : null\x2C\n    };\n  }\n\n  // Estimate the carry component of a measured TOTAL distance by modelling the rollout\n  // for that club's launch conditions in the CURRENT conditions. This fixes a real\n  // inconsistency: the log measured total\x2C but club.yards is a carry number.\n  function estimateCarryFromTotal(totalYd\x2C firmness = 'medium') {\n    const D = Math.max(0\x2C num(totalYd\x2C 0));\n    if (D < 15) return D;\n    let carry = D * 0.94;                                  // seed\n    for (let i = 0; i < 6; i++) {\n      const L = launchForStandardCarry(carry);\n      const t = integrateTrajectory(L\x2C STILL_AIR_ENV);\n      const roll = rolloutYd(t.landSpeedMps\x2C t.descentDeg\x2C firmness\x2C STILL_AIR_ENV.gravity);\n      const next = clamp(D - roll\x2C 0.55 * D\x2C D);\n      if (Math.abs(next - carry) < 0.05) { carry = next; break; }\n      carry = next;\n    }\n    return carry;\n  }\n\n  /**\n   * SIGNATURE PRESERVED: logShot(clubId\x2C distanceYd\x2C baselineYd) -> boolean.\n   * Extra optional args are additive and safe to omit.\n   */\n  function logShot(clubId\x2C distanceYd\x2C baselineYd\x2C lateralYd\x2C gpsAccM) {\n    const dist = Number(distanceYd);\n    if (!clubId || !Number.isFinite(dist) || dist <= 0 || dist > 400) return false;\n    const base = num(baselineYd\x2C 0);\n    if (base > 0 && (dist < base * SHOT_SANITY_LO || dist > base * SHOT_SANITY_HI)) return false;\n    const log = loadShotLog();\n    const arr = log[clubId] || (log[clubId] = []);\n    arr.push({\n      d: Math.round(dist * 10) / 10\x2C\n      c: Math.round(estimateCarryFromTotal(dist) * 10) / 10\x2C\n      l: Number.isFinite(lateralYd) ? Math.round(lateralYd * 10) / 10 : null\x2C\n      t: Date.now()\x2C\n      a: Number.isFinite(gpsAccM) ? Math.round(gpsAccM * 10) / 10 : null\x2C\n    });\n    if (arr.length > SHOT_MAX_PER_CLUB) log[clubId] = arr.slice(-SHOT_MAX_PER_CLUB);\n    saveShotLog(log);\n    return true;\n  }\n\n  // SIGNATURE PRESERVED.\n  function shotDataSummary() {\n    const log = loadShotLog();\n    let total = 0\x2C clubs = 0;\n    for (const k of Object.keys(log)) {\n      const n = (log[k] || []).map(normalizeShotEntry).filter(Boolean).length;\n      if (n > 0) { total += n; clubs += 1; }\n    }\n    return { total\x2C clubs };\n  }\n  function clearShotData() { try { localStorage.removeItem(SHOTLOG_KEY); } catch { } }\n\n  function priorRelSigma(carryYd) {\n    const t = smoothstep(DISP_REL_KNEE_LO\x2C DISP_REL_KNEE_HI\x2C num(carryYd\x2C 150));\n    return (DISP_REL_SHORT + t * (DISP_REL_LONG - DISP_REL_SHORT)) * DISP_AMATEUR_MULT;\n  }\n\n  // SIGNATURE PRESERVED. formulaDispersionYd(carry) -> prior \xb1band in yards.\n  function formulaDispersionYd(carry) {\n    const c = num(carry\x2C 0);\n    if (c <= 0) return 0;\n    const z = invNorm(0.5 + DISPERSION_COVERAGE / 2);\n    return Math.max(DISP_FLOOR_YD\x2C Math.round(z * priorRelSigma(c) * c));\n  }\n\n  /**\n   * SIGNATURE PRESERVED: clubStats(clubId) -> { mean\x2C stdev\x2C n } (+ many extras).\n   * Now a Normal\u2013Inverse-Gamma posterior over (carry mean\x2C carry \u03c3) with exponential\n   * recency weighting and robust pre-screening. mean/stdev keep their old meaning\n   * (null when insufficient data) so existing callers are unaffected.\n   * Conjugate NIG update: Gelman et al.\x2C Bayesian Data Analysis 3rd ed. \xa73.3.\n   */\n  function clubStatsUncached(clubId\x2C opts = {}) {\n    const log = loadShotLog();\n    const raw = (log[clubId] || []).map(normalizeShotEntry).filter(Boolean);\n    const club = state.clubs.find((c) => c.id === clubId);\n    const stock = club ? num(club.yards\x2C 0) : 0;\n    const empty = {\n      mean: null\x2C stdev: null\x2C n: 0\x2C nEff: 0\x2C sigmaPrior: null\x2C sigmaPost: null\x2C\n      meanTotal: null\x2C lateralSigma: null\x2C ciLo: null\x2C ciHi: null\x2C trend: null\x2C source: 'none'\n    };\n    if (!raw.length) {\n      if (stock > 0) {\n        empty.sigmaPrior = priorRelSigma(stock) * stock;\n        empty.sigmaPost = empty.sigmaPrior;\n        empty.source = 'prior';\n      }\n      return empty;\n    }\n    const now = Date.now();\n    const HL = DISP_HALFLIFE_DAYS * 86400000;\n    // Carry values (fall back to a modelled carry for legacy total-only entries).\n    const vals = raw.map((e) => (Number.isFinite(e.c) ? e.c : estimateCarryFromTotal(e.d)));\n    // Robust pre-screen at 3\xd7 MAD around the median; keeps a single shank from wrecking \u03c3.\n    const med = median(vals);\n    const mad = madSigma(vals) || Math.max(DISP_FLOOR_YD\x2C 0.05 * (stock || med));\n    const keep = vals.map((v) => Math.abs(v - med) <= 3 * mad);\n    const wts = raw.map((e\x2C i) => {\n      if (!keep[i]) return 0;\n      const age = Number.isFinite(e.t) ? Math.max(0\x2C now - e.t) : HL;   // undated legacy shots get one half-life of age\n      let w = Math.pow(0.5\x2C age / HL);\n      if (Number.isFinite(e.a) && e.a > 0) w *= 1 / (1 + (e.a / ROUND_GPS_OK_M) ** 2); // down-weight sloppy fixes\n      return w;\n    });\n    const mom = weightedMoments(vals\x2C wts);\n    const n = vals.filter((_\x2C i) => keep[i]).length;\n    const nEff = mom.nEff;\n\n    // NIG prior: \u03bc\u2080 = stock number\x2C \u03c3\u2080 from the skill model\x2C \u03bd\u2080 = DISP_PRIOR_STRENGTH.\n    const mu0 = stock > 0 ? stock : mom.mean;\n    const sigPrior = priorRelSigma(mu0) * mu0;\n    const nu0 = DISP_PRIOR_STRENGTH;\n    const kappa0 = 2;                                     // weak prior on the mean: worth 2 observations\n    const sampleVar = Number.isFinite(mom.variance) ? mom.variance : sigPrior * sigPrior;\n    // Posterior scale for \u03c3 (mode of the inverse-gamma marginal).\n    const nuN = nu0 + nEff;\n    const ss = nu0 * sigPrior * sigPrior + Math.max(0\x2C nEff - 1) * sampleVar +\n      (kappa0 * nEff / (kappa0 + nEff)) * (mom.mean - mu0) ** 2;\n    const sigmaPost = Math.sqrt(Math.max(DISP_FLOOR_YD * DISP_FLOOR_YD / 4\x2C ss / Math.max(1\x2C nuN)));\n    const meanPost = (kappa0 * mu0 + nEff * mom.mean) / (kappa0 + nEff);\n\n    // Posterior predictive interval for the MEAN (what to set club.yards to).\n    const seMean = sigmaPost / Math.sqrt(kappa0 + nEff);\n    const tq = tQuantile(0.975\x2C Math.max(1\x2C nuN));\n    // Lateral dispersion.\n    const lats = raw.map((e) => e.l).filter((x) => Number.isFinite(x));\n    const latSig = lats.length >= 3\n      ? Math.max(madSigma(lats) || 0\x2C Math.sqrt(weightedMoments(lats\x2C lats.map(() => 1)).variance || 0))\n      : LATERAL_REL_PRIOR * (mu0 || 150);\n    // Distance trend over time (yd per 30 days) \u2014 is the player gaining or losing speed?\n    // Cap the Theil-Sen input: it is O(n\xb2) and 60 recent shots already resolve a trend.\n    const dated = raw.map((e\x2C i) => ({ e\x2C v: vals[i] }))\n      .filter((o) => Number.isFinite(o.e.t)).slice(-TREND_MAX_SHOTS);\n    const trend = dated.length >= 5\n      ? (theilSen(dated.map((o) => o.e.t / 86400000)\x2C dated.map((o) => o.v)) || {}).slope\n      : null;\n\n    // Legacy-compatible fields: only expose mean/stdev once there is real data.\n    const legacyMean = n >= 1 ? mom.mean : null;\n    const legacyStd = n >= 2 && Number.isFinite(sampleVar)\n      ? Math.sqrt(sampleVar) / c4(Math.max(2\x2C Math.round(nEff)))   // bias-corrected sample SD\n      : null;\n\n    return {\n      mean: legacyMean\x2C stdev: legacyStd\x2C n\x2C\n      nEff\x2C meanPost\x2C sigmaPost\x2C sigmaPrior: sigPrior\x2C\n      meanTotal: raw.length ? weightedMoments(raw.map((e) => e.d)\x2C wts).mean : null\x2C\n      lateralSigma: latSig\x2C\n      ciLo: meanPost - tq * seMean\x2C ciHi: meanPost + tq * seMean\x2C\n      trendYdPer30d: Number.isFinite(trend) ? trend * 30 : null\x2C\n      source: n >= SHOT_MIN_TRUST_N ? 'posterior' : 'prior-dominated'\x2C\n    };\n  }\n\n  /**\n   * SIGNATURE PRESERVED: clubDispersionYd(club) -> \xb1 band in yards.\n   * Now the posterior-predictive half-width at DISPERSION_COVERAGE\x2C which shrinks\n   * smoothly and automatically as evidence accumulates. No hand-tuned blend.\n   */\n  function clubDispersionYd(club) {\n    if (!club) return 0;\n    const carry = num(club.yards\x2C 0);\n    if (carry <= 0) return 0;\n    const st = clubStats(club.id);\n    const sig = Number.isFinite(st.sigmaPost) ? st.sigmaPost : priorRelSigma(carry) * carry;\n    const nu = DISP_PRIOR_STRENGTH + (st.nEff || 0);\n    // Predictive spread includes uncertainty in the mean itself.\n    const predSig = sig * Math.sqrt(1 + 1 / (2 + (st.nEff || 0)));\n    const q = tQuantile(0.5 + DISPERSION_COVERAGE / 2\x2C Math.max(1\x2C nu));\n    return Math.max(DISP_FLOOR_YD\x2C Math.round(q * predSig));\n  }\n  // Raw \u03c3 accessors used by the strategy engine.\n  function clubSigmaDistYd(club) {\n    if (!club) return 0;\n    const st = clubStats(club.id);\n    return Number.isFinite(st.sigmaPost) ? st.sigmaPost : priorRelSigma(num(club.yards\x2C 150)) * num(club.yards\x2C 150);\n  }\n  function clubSigmaLatYd(club) {\n    if (!club) return 0;\n    const st = clubStats(club.id);\n    return Number.isFinite(st.lateralSigma) ? st.lateralSigma : LATERAL_REL_PRIOR * num(club.yards\x2C 150);\n  }\n\n  // Signed lateral bias (yd\x2C + = right of intended line) for a club with\n  // enough samples to trust. Robust: median of recorded offsets.\n  function clubLateralBiasYd(clubId) {\n    const log = loadShotLog();\n    const vals = (log[clubId] || [])\n      .map(normalizeShotEntry)\n      .filter((e) => e && Number.isFinite(e.l))\n      .map((e) => e.l);\n    if (vals.length < MISS_BIAS_MIN_N) return null;\n    return median(vals);\n  }\n\n  // ============================================================\n  //  PATCH A \u2014 MEMOIZATION LAYER FOR THE SHOT MODEL\n  //  Overrides: loadShotLog\x2C saveShotLog\x2C clearShotData\x2C\n  //             estimateCarryFromTotal.  Adds: clubStats wrapper.\n  //  clubStats is on the hot path ~216x per recalculation; without this\n  //  every call re-parses localStorage and re-runs an O(n\xb2) regression.\n  // ============================================================\n\n  const TREND_MAX_SHOTS = 60;       // cap on Theil-Sen input; O(n\xb2) cost vs negligible extra trend resolution\n  const CARRY_MEMO_BINS = 2;        // memo bins per yard for the total\u2192carry inversion (0.5 yd resolution)\n  const CARRY_MEMO_MAX = 512;       // bounded memo; shot distances span at most ~400 yd\n\n  let _shotLogCache = null;\n  let _shotLogVersion = 0;\n  const _clubStatsCache = new Map();\n  const _carryMemo = new Map();\n\n  function loadShotLog() {\n    if (_shotLogCache) return _shotLogCache;\n    const v = load(SHOTLOG_KEY\x2C {});\n    _shotLogCache = sanitizeShotLog(v);\n    return _shotLogCache;\n  }\n  function saveShotLog(log) {\n    save(SHOTLOG_KEY\x2C log);\n    _shotLogCache = log;\n    _shotLogVersion++;\n    _clubStatsCache.clear();\n  }\n  function clearShotData() {\n    try { localStorage.removeItem(SHOTLOG_KEY); } catch { }\n    _shotLogCache = null;\n    _shotLogVersion++;\n    _clubStatsCache.clear();\n  }\n\n  // Memoized: the inversion runs up to 6 trajectory integrations per distinct distance.\n  function estimateCarryFromTotal(totalYd\x2C firmness = 'medium') {\n    const D = Math.max(0\x2C num(totalYd\x2C 0));\n    if (D < 15) return D;\n    const key = firmness + '|' + Math.round(D * CARRY_MEMO_BINS);\n    const hit = _carryMemo.get(key);\n    if (hit !== undefined) return hit;\n    let carry = D * 0.94;\n    for (let i = 0; i < 6; i++) {\n      const L = launchForStandardCarry(carry);\n      const t = integrateTrajectory(L\x2C STILL_AIR_ENV);\n      const roll = rolloutYd(t.landSpeedMps\x2C t.descentDeg\x2C firmness\x2C STILL_AIR_ENV.gravity);\n      const next = clamp(D - roll\x2C 0.55 * D\x2C D);\n      if (Math.abs(next - carry) < 0.05) { carry = next; break; }\n      carry = next;\n    }\n    if (_carryMemo.size > CARRY_MEMO_MAX) _carryMemo.clear();\n    _carryMemo.set(key\x2C carry);\n    return carry;\n  }\n\n  // SIGNATURE PRESERVED. Cache key folds in the club's stock yardage because the\n  // NIG prior is centred on it \u2014 editing a club invalidates its entry automatically.\n  function clubStats(clubId\x2C opts) {\n    if (opts && Object.keys(opts).length) return clubStatsUncached(clubId\x2C opts);\n    const club = state.clubs.find((c) => c.id === clubId);\n    const key = clubId + '|' + _shotLogVersion + '|' + (club ? num(club.yards\x2C 0) : 0);\n    const hit = _clubStatsCache.get(key);\n    if (hit) return hit;\n    const out = clubStatsUncached(clubId\x2C opts);\n    _clubStatsCache.set(key\x2C out);\n    return out;\n  }\n  // ============================================================\n  //  BLOCK 8 \u2014 EXPECTED STROKES + DECISION THEORY\n  //  Replaces: recommendClub\x2C recommendSmart\x2C selectedClubGuidance\n  // ============================================================\n\n  // PGA Tour expected-strokes baselines. Distances in yards except putting (feet).\n  // Source: M. Broadie\x2C Every Shot Counts (2014)\x2C Tour baseline tables; and\n  // M. Broadie\x2C "Assessing Golfer Performance on the PGA TOUR"\x2C Interfaces 42 (2012) 146.\n  const ES_X_FAIRWAY = [10\x2C 20\x2C 30\x2C 40\x2C 50\x2C 60\x2C 70\x2C 80\x2C 90\x2C 100\x2C 120\x2C 140\x2C 160\x2C 180\x2C 200\x2C 220\x2C 240\x2C 260\x2C 280\x2C 300];\n  const ES_Y_FAIRWAY = [2.18\x2C 2.40\x2C 2.52\x2C 2.60\x2C 2.66\x2C 2.70\x2C 2.72\x2C 2.75\x2C 2.77\x2C 2.80\x2C 2.85\x2C 2.91\x2C 2.98\x2C 3.08\x2C 3.19\x2C 3.32\x2C 3.45\x2C 3.58\x2C 3.70\x2C 3.82]; // fairway baseline \u2014 Broadie (2014)\n  const ES_Y_ROUGH = [2.34\x2C 2.59\x2C 2.70\x2C 2.78\x2C 2.84\x2C 2.88\x2C 2.91\x2C 2.93\x2C 2.96\x2C 2.98\x2C 3.04\x2C 3.10\x2C 3.17\x2C 3.26\x2C 3.36\x2C 3.47\x2C 3.58\x2C 3.68\x2C 3.78\x2C 3.88]; // rough baseline \u2014 Broadie (2014)\n  const ES_Y_SAND = [2.43\x2C 2.53\x2C 2.66\x2C 2.82\x2C 2.92\x2C 2.99\x2C 3.03\x2C 3.05\x2C 3.07\x2C 3.10\x2C 3.14\x2C 3.19\x2C 3.25\x2C 3.32\x2C 3.42\x2C 3.53\x2C 3.64\x2C 3.74\x2C 3.84\x2C 3.94]; // sand baseline \u2014 Broadie (2014)\n  const ES_Y_RECOV = [2.95\x2C 3.05\x2C 3.10\x2C 3.15\x2C 3.20\x2C 3.25\x2C 3.30\x2C 3.35\x2C 3.40\x2C 3.45\x2C 3.51\x2C 3.57\x2C 3.63\x2C 3.69\x2C 3.76\x2C 3.83\x2C 3.90\x2C 3.97\x2C 4.04\x2C 4.11]; // recovery baseline \u2014 Broadie (2014)\n  const ES_X_GREEN_FT = [1\x2C 2\x2C 3\x2C 4\x2C 5\x2C 6\x2C 7\x2C 8\x2C 9\x2C 10\x2C 12\x2C 15\x2C 20\x2C 25\x2C 30\x2C 35\x2C 40\x2C 45\x2C 50\x2C 60\x2C 70\x2C 80\x2C 90\x2C 100];\n  const ES_Y_GREEN = [1.001\x2C 1.009\x2C 1.053\x2C 1.147\x2C 1.256\x2C 1.357\x2C 1.443\x2C 1.515\x2C 1.575\x2C 1.626\x2C 1.702\x2C 1.784\x2C\n    1.874\x2C 1.936\x2C 1.985\x2C 2.026\x2C 2.064\x2C 2.098\x2C 2.127\x2C 2.182\x2C 2.231\x2C 2.267\x2C 2.298\x2C 2.324];   // putting baseline \u2014 Broadie (2014)\n  const ES_PENALTY_STROKES = 1.0;   // one-stroke penalty for a water/OB drop \u2014 Rules of Golf 17.1d / 18.2\n  // Amateur scaling. Broadie's baselines are Tour; a mid handicap is worse everywhere\x2C but\n  // decisions depend on DIFFERENCES\x2C which scale roughly with the player's relative dispersion.\n  const ES_AMATEUR_PENALTY_MULT = 1.25; // inflation of off-green penalties for a non-tour short game \u2014 Broadie (2014) ch.6 amateur comparisons\n\n  const _esFair = pchip(ES_X_FAIRWAY\x2C ES_Y_FAIRWAY);\n  const _esRough = pchip(ES_X_FAIRWAY\x2C ES_Y_ROUGH);\n  const _esSand = pchip(ES_X_FAIRWAY\x2C ES_Y_SAND);\n  const _esRecov = pchip(ES_X_FAIRWAY\x2C ES_Y_RECOV);\n  const _esGreen = pchip(ES_X_GREEN_FT\x2C ES_Y_GREEN);\n\n  function expectedStrokes(lie\x2C distYd) {\n    const d = Math.max(0\x2C num(distYd\x2C 0));\n    if (lie === 'green') return clamp(_esGreen(clamp(d * 3\x2C 0.5\x2C 110))\x2C 1\x2C 3.2);\n    if (d < 1) return 1.0;\n    const f = (fn\x2C floor) => clamp(fn(clamp(d\x2C 5\x2C 320))\x2C floor\x2C 5.2);\n    switch (lie) {\n      case 'rough': return f(_esRough\x2C 2.1);\n      case 'sand': return f(_esSand\x2C 2.2);\n      case 'recovery': return f(_esRecov\x2C 2.6);\n      case 'penalty': return f(_esFair\x2C 2.0) + ES_PENALTY_STROKES * ES_AMATEUR_PENALTY_MULT;\n      default: return f(_esFair\x2C 2.0);\n    }\n  }\n  // Distance in yards from a landing point back to the hole\x2C given the pin is at pinAlong\n  // along the shot line\x2C and the shot finished at (along\x2C lateral) relative to the ball.\n  const distToPin = (along\x2C lateral\x2C pinAlong) => hypot2(pinAlong - along\x2C lateral);\n\n  /**\n   * Classify a finish point into a lie\x2C using whatever green geometry we actually have.\n   * geo: { front\x2C center\x2C back\x2C depth\x2C widthYd\x2C axisBearing } \u2014 see Block 9.\n   * All distances measured along/across the shot line\x2C in yards from the player.\n   */\n  const GREEN_FRINGE_YD = 3;        // apron/fringe collar depth around a green\x2C yd \u2014 typical USGA maintenance practice\n  const GREEN_WIDTH_TO_DEPTH = 1.15; // median green is slightly wider than deep \u2014 USGA Green Section green-sizing guidance (median \u22486\x2C000 ft\xb2)\n  const GREEN_MIN_HALF_WIDTH_YD = 8; // floor on the modelled half-width when depth is unknown\n  function classifyLie(along\x2C lateral\x2C geo\x2C opts = {}) {\n    const surround = opts.surround || 'rough';\n    if (!geo || geo.front == null || geo.back == null) {\n      // No green model: treat "close to the aim point" as green\x2C else the surround.\n      const tgt = num(opts.targetAlong\x2C NaN);\n      if (Number.isFinite(tgt) && hypot2(along - tgt\x2C lateral) < 12) return 'green';\n      return surround;\n    }\n    const halfW = Math.max(GREEN_MIN_HALF_WIDTH_YD\x2C\n      0.5 * (Number.isFinite(geo.widthYd) ? geo.widthYd : GREEN_WIDTH_TO_DEPTH * geo.depth));\n    const inDepth = along >= geo.front && along <= geo.back;\n    const inWidth = Math.abs(lateral - num(geo.centerLateral\x2C 0)) <= halfW;\n    if (inDepth && inWidth) return 'green';\n    const nearDepth = along >= geo.front - GREEN_FRINGE_YD && along <= geo.back + GREEN_FRINGE_YD;\n    const nearWidth = Math.abs(lateral - num(geo.centerLateral\x2C 0)) <= halfW + GREEN_FRINGE_YD;\n    if (nearDepth && nearWidth) return 'green';    // fringe putts as green in the baselines\n    return surround;\n  }\n\n  /**\n   * Expected strokes for playing `club` at a shot whose plays-like requirement is\n   * playsTarget\x2C with the pin at pinPlays plays-like yards. Integrates the 2-D outcome\n   * distribution on a 9x9 Gauss-Legendre product rule over the normal factors.\n   */\n  function clubExpectedStrokes(club\x2C playsTarget\x2C pinPlays\x2C geo\x2C opts = {}) {\n    if (!club) return { es: Infinity\x2C pGreen: 0\x2C pShort: 0\x2C pLong: 0\x2C pTrouble: 0 };\n    const mu = num(club.yards\x2C 0);\n    if (mu <= 0) return { es: Infinity\x2C pGreen: 0\x2C pShort: 0\x2C pLong: 0\x2C pTrouble: 0 };\n    const effort = num(opts.effort\x2C 1);                 // 1 = stock; <1 = smooth; >1 = firm\n    const muEff = mu * effort;\n    // Taking speed off tightens distance a little but costs strike quality; firming up\n    // widens both. Empirically \u03c3 scales sub-linearly with effort.\n    const sigD = clubSigmaDistYd(club) * (0.82 + 0.18 * effort) * Math.max(0.85\x2C effort);\n    const sigL = clubSigmaLatYd(club) * Math.max(0.85\x2C effort) * (mu > 0 ? muEff / mu : 1);\n    // Convert plays-like requirement back into the along-line frame: the club's plays-like\n    // capability is muEff\x2C and the pin sits pinPlays away in the same units.\n    const nodes = NORM_NODES;\n    let es = 0\x2C pGreen = 0\x2C pShort = 0\x2C pLong = 0\x2C pTrouble = 0;\n    for (let i = 0; i < nodes.zs.length; i++) {\n      const along = muEff + nodes.zs[i] * sigD;\n      for (let j = 0; j < nodes.zs.length; j++) {\n        const lateral = nodes.zs[j] * sigL + num(opts.aimLateral\x2C 0);\n        const w = nodes.ws[i] * nodes.ws[j];\n        const lie = classifyLie(along\x2C lateral\x2C geo\x2C { surround: opts.surround\x2C targetAlong: playsTarget });\n        const dPin = distToPin(along\x2C lateral\x2C pinPlays);\n        es += w * expectedStrokes(lie\x2C dPin);\n        if (lie === 'green') pGreen += w;\n        else {\n          pTrouble += w;\n          if (geo && geo.front != null && along < geo.front) pShort += w;\n          else if (geo && geo.back != null && along > geo.back) pLong += w;\n        }\n      }\n    }\n    return { es\x2C pGreen\x2C pShort\x2C pLong\x2C pTrouble\x2C muEff\x2C sigD\x2C sigL };\n  }\n\n  /**\n   * SIGNATURE PRESERVED: recommendClub(playsYd) -> { main\x2C sub }.\n   * Geometry-free path. Now chooses by minimizing expected strokes against a generic\n   * green centred on the target\x2C with the player's own dispersion\x2C and reports the\n   * effort level that minimizes it rather than a fixed "take the longer club" heuristic.\n   */\n  const GENERIC_GREEN_DEPTH_YD = 30;  // median depth of a modern green\x2C yd \u2014 USGA Green Section green-sizing guidance\n  const _recClubMemo = new Map();     // v1.7.3 tap-freeze: recommendClub LRU (see memoKey below)\n  const EFFORT_LEVELS = [0.88\x2C 0.94\x2C 1.0\x2C 1.06];  // smooth / easy / stock / firm \u2014 the four swings most players actually own\n  const EFFORT_NAMES = ['smooth'\x2C 'easy'\x2C 'stock'\x2C 'firm'];\n  const ES_TIE_THRESHOLD = 0.008;     // strokes; below this two options are indistinguishable given model error\n\n  function recommendClub(playsYd) {\n    playsYd = Math.max(0\x2C num(playsYd\x2C 0));\n    // v-fix(rec-memo) v1.7.3 (tap-freeze follow): the ES search below costs\n    // ~4k expected-strokes evaluations per call; renderStrategy calls it up\n    // to 4x per tap and repeat taps repeat the whole search. Memoize on the\n    // rounded yardage + shot-log version (identical inputs \u21d2 identical\n    // recommendation). LRU 48.\n    const memoKey = Math.round(playsYd) + '|' + _shotLogVersion + '|' +\n      state.clubs.length;\n    const hit = _recClubMemo.get(memoKey);\n    if (hit) return hit;\n    const asc = sortedClubsAsc()\x2C desc = sortedClubsDesc();\n    if (!asc.length)\n      return { main: 'Add clubs'\x2C sub: 'Go to Clubs and add your stock carry distances.' };\n    const shortest = asc[0]\x2C longest = desc[0];\n\n    if (playsYd <= 3) return { main: 'No full shot needed'\x2C sub: 'Tap-in or tiny chip \u2014 0\u20133 yards.' };\n    if (playsYd < 20) return { main: 'Putt / chip'\x2C sub: 'Very close. Use feel; no full swing.' };\n\n    // Generic green centred on the target so short/long misses are penalized symmetrically.\n    const geo = {\n      front: playsYd - GENERIC_GREEN_DEPTH_YD / 2\x2C\n      back: playsYd + GENERIC_GREEN_DEPTH_YD / 2\x2C\n      depth: GENERIC_GREEN_DEPTH_YD\x2C\n      widthYd: GENERIC_GREEN_DEPTH_YD * GREEN_WIDTH_TO_DEPTH\x2C\n      centerLateral: 0\x2C\n    };\n    let best = null;\n    for (const c of desc) {\n      for (let k = 0; k < EFFORT_LEVELS.length; k++) {\n        const eff = EFFORT_LEVELS[k];\n        const r = clubExpectedStrokes(c\x2C playsYd\x2C playsYd\x2C geo\x2C { effort: eff\x2C surround: 'rough' });\n        // Penalize efforts outside the stock swing slightly: they are harder to repeat\n        // than the dispersion model alone implies.\n        const penalty = Math.abs(eff - 1) * 0.02;\n        const score = r.es + penalty;\n        if (!best || score < best.score - 1e-9)\n          best = { club: c\x2C eff\x2C effName: EFFORT_NAMES[k]\x2C score\x2C ...r };\n      }\n    }\n    if (!best) return { main: 'Add clubs'\x2C sub: 'Go to Clubs and add your stock carry distances.' };\n\n    // Genuinely out of range?\n    if (playsYd > longest.yards * 1.08) {\n      const gap = Math.round(playsYd - longest.yards);\n      return {\n        main: 'Lay up'\x2C\n        sub: `${gap} yd beyond your ${longest.yards} yd ${longest.name}. Lay up to a full-wedge number (${Math.max(\n          40\x2C Math.round(playsYd - shortest.yards))} yd carry leaves ${shortest.name}).`\x2C\n      };\n    }\n    if (playsYd < shortest.yards * 0.55) {\n      const pct = clamp(Math.round((playsYd / shortest.yards) * 100)\x2C 30\x2C 95);\n      return {\n        main: `${shortest.name} \xb7 ${pct}%`\x2C\n        sub: `Partial wedge \u2014 control it with swing length\x2C not deceleration. Stock ${shortest.name} is ${shortest.yards} yd.`\x2C\n      };\n    }\n\n    const c = best.club;\n    const delta = Math.round(c.yards * best.eff - playsYd);\n    const label = best.eff === 1 ? `${c.name} stock` : `${c.name} ${best.effName}`;\n    // Runner-up margin tells the player how much the choice actually matters.\n    let runner = null;\n    for (const o of desc) {\n      if (o.id === c.id) continue;\n      const r = clubExpectedStrokes(o\x2C playsYd\x2C playsYd\x2C geo\x2C { effort: 1\x2C surround: 'rough' });\n      if (!runner || r.es < runner.es) runner = { club: o\x2C es: r.es };\n    }\n    const margin = runner ? runner.es - best.es : 0;\n    const bits = [];\n    bits.push(`Stock ${c.name} ${c.yards} yd vs ${fmt(playsYd)} yd plays-like (${delta >= 0 ? '+' : ''}${delta}).`);\n    bits.push(`${Math.round(best.pGreen * 100)}% green\x2C E[strokes] ${fmt(best.es\x2C 2)}.`);\n    if (runner && margin < ES_TIE_THRESHOLD)\n      bits.push(`${runner.club.name} is statistically identical \u2014 take the one you trust.`);\n    else if (runner)\n      bits.push(`Next best ${runner.club.name} costs ${fmt(margin\x2C 2)} strokes.`);\n    const out = { main: label\x2C sub: bits.join(' ') };\n    if (_recClubMemo.size > 48) _recClubMemo.delete(_recClubMemo.keys().next().value);\n    _recClubMemo.set(memoKey\x2C out);\n    return out;\n  }\n\n  /**\n   * SIGNATURE PRESERVED: recommendSmart(playsTarget\x2C geo\x2C bearing\x2C accYd)\n   *   -> { main\x2C sub\x2C verdict\x2C tips }\n   * Full geometry-aware optimizer. Verdict now comes from the expected-strokes surface\n   * and the probability of trouble\x2C not from a \xb12 yd edge comparison.\n   */\n  const VERDICT_GO_PGREEN = 0.55;      // \u226555% green with the best club => commit\n  const VERDICT_BAIL_PGREEN = 0.22;    // <22% green with the best club => the target itself is wrong\n  const VERDICT_BAIL_ES = 3.35;        // expected strokes above which the shot is not worth attempting as aimed\n  /* ---- Hazard cost model (strokes) ---- */\n  const HAZ_WATER_PENALTY = 1.8;   // \u2248 stroke-and-dropped: penalty + replay distance\n  const HAZ_BUNKER_PENALTY = 0.55; // typical bunker recovery vs adjacent grass\n  const HAZ_HALF_WIDTH_YD = 7;     // modeled half-width of a mapped hazard\n  const HAZ_CLEAR_MARGIN_YD = 4;   // carry margin demanded over water before "clear"\n\n  // Expected stroke cost of the hazard field for one sampled landing point.\n  // Landed SHORT of the hazard = failed carry \u2192 full penalty if on its line.\n  // Landed AT the hazard = in it (full) or graded proximity beside it.\n  // Landed WELL PAST = cleanly carried \u2192 free.\n  function hazardCostStrokes(along\x2C lateral\x2C hazards) {\n    let cost = 0;\n    for (const h of hazards) {\n      const pen = h.type === 'water' ? HAZ_WATER_PENALTY : HAZ_BUNKER_PENALTY;\n      const dCross = Math.abs(lateral - h.crossYd);\n      const dAlong = along - h.alongYd; // + = past the hazard\n      if (dAlong < -HAZ_CLEAR_MARGIN_YD) {\n        // Short of the hazard: it had to be carried\x2C and wasn't.\n        if (dCross < HAZ_HALF_WIDTH_YD) cost += pen;\n      } else if (Math.abs(dAlong) <= HAZ_HALF_WIDTH_YD + 6) {\n        // At the hazard: in it\x2C or close enough to cost recovery strokes.\n        const edge = dCross - HAZ_HALF_WIDTH_YD;\n        if (edge < 0) cost += pen;\n        else if (edge < 10) cost += pen * (1 - edge / 10) * 0.5;\n      }\n      // else: cleanly carried \u2014 no cost.\n    }\n    return cost;\n  }\n\n  function recommendSmart(playsTarget\x2C geo\x2C bearing\x2C accYd\x2C opts = {}) {\n    const asc = sortedClubsAsc();\n    const desc = sortedClubsDesc();\n    const strokeIndex = Number(opts.strokeIndex) || null;\n\n    if (!asc.length) {\n      return {\n        main: 'Add clubs'\x2C\n        sub: 'Add your carry distances in the Clubs tab.'\x2C\n        verdict: 'neutral'\x2C\n        tips: []\x2C\n      };\n    }\n\n    /*\n     * Important:\n     * The selected map target is always the shot target.\n     *\n     * FCB describes the green around that target. It must never silently\n     * replace the selected target with green center.\n     */\n    const pinPlays = playsTarget;\n\n    // Convert FCB's actual along-line distances into the same approximate\n    // plays-like scale used for club selection.\n    const rawTargetYd = Math.max(\n      1\x2C\n      state.lastCalc && Number.isFinite(state.lastCalc.horizontalYd)\n        ? state.lastCalc.horizontalYd\n        : haversineMeters(state.loc\x2C state.target) * M_TO_YD\n    );\n\n    const playsScale = playsTarget / rawTargetYd;\n\n    const frontRaw =\n      geo && Number.isFinite(geo.frontAlong)\n        ? geo.frontAlong\n        : geo && Number.isFinite(geo.front)\n          ? geo.front\n          : null;\n\n    const backRaw =\n      geo && Number.isFinite(geo.backAlong)\n        ? geo.backAlong\n        : geo && Number.isFinite(geo.back)\n          ? geo.back\n          : null;\n\n    // Green model remains aligned to the selected target line.\n    // Sorting prevents accidental Front/Back placement order from breaking it.\n    const model =\n      Number.isFinite(frontRaw) && Number.isFinite(backRaw)\n        ? {\n          front: Math.min(frontRaw\x2C backRaw) * playsScale\x2C\n          back: Math.max(frontRaw\x2C backRaw) * playsScale\x2C\n          depth:\n            Math.abs(backRaw - frontRaw) * playsScale || 4\x2C\n          widthYd: Number.isFinite(geo.widthYd)\n            ? geo.widthYd\n            : GREEN_WIDTH_TO_DEPTH *\n            Math.max(4\x2C Math.abs(backRaw - frontRaw) * playsScale)\x2C\n          centerLateral: num(geo.centerLateral\x2C 0)\x2C\n        }\n        : null;\n\n    /* ---- Hazard-aware optimization ----\n       Imported water/bunkers projected onto THIS line now price directly\n       into the club decision: every candidate is re-scored over the same\n       Gauss\u2013Hermite landing samples with the expected hazard cost added\x2C\n       and the optimizer also scans lateral aim shifts to find the line\n       that plays cheapest against the trouble. */\n    const haz = Array.isArray(opts.hazards) ? opts.hazards : hazardsOnLine();\n    const scan = haz.length ? [-12\x2C -6\x2C 0\x2C 6\x2C 12] : [0];\n\n    let best = null\x2C alternatives = [];\n    for (const c of desc) {\n      for (let k = 0; k < EFFORT_LEVELS.length; k++) {\n        const eff = EFFORT_LEVELS[k];\n        for (const aim of scan) {\n          const r = clubExpectedStrokes(c\x2C playsTarget\x2C pinPlays\x2C model\x2C {\n            effort: eff\x2C surround: 'rough'\x2C aimLateral: aim\x2C\n          });\n          // Re-sample the same quadrature nodes with hazard cost folded in\x2C\n          // so the expectation stays exact rather than bolted on after.\n          let hz = 0;\n          if (haz.length && Number.isFinite(r.muEff)) {\n            const nodes = NORM_NODES;\n            for (let i = 0; i < nodes.zs.length; i++) {\n              const along = r.muEff + nodes.zs[i] * r.sigD;\n              for (let j = 0; j < nodes.zs.length; j++) {\n                const lateral = nodes.zs[j] * r.sigL + aim;\n                hz += nodes.ws[i] * nodes.ws[j] * hazardCostStrokes(along\x2C lateral\x2C haz);\n              }\n            }\n          }\n          const score = r.es + hz + Math.abs(eff - 1) * 0.02 + Math.abs(aim) * 0.0015;\n          const cand = { club: c\x2C eff\x2C effName: EFFORT_NAMES[k]\x2C score\x2C aimLateral: aim\x2C hz\x2C ...r };\n          alternatives.push(cand);\n          if (!best || score < best.score - 1e-9) best = cand;\n        }\n      }\n    }\n    alternatives.sort((a\x2C b) => a.score - b.score);\n    const tips = [];\n    let verdict = 'neutral';\n    if (!best) {\n      return {\n        main: 'No recommendation'\x2C\n        sub: 'Add carry distances in the Clubs tab.'\x2C\n        verdict\x2C\n        tips\x2C\n      };\n    }\n\n    const c = best.club;\n    const main = best.eff === 1 ? `${c.name} stock` : `${c.name} ${best.effName}`;\n    const pG = best.pGreen;\n\n    if (pG >= VERDICT_GO_PGREEN) {\n      verdict = 'go';\n      tips.push(`\ud83d\udfe2 Green light \u2014 ${c.name} holds this green ${Math.round(pG * 100)}% of the time from your pattern. Commit and fire.`);\n    } else if (pG < VERDICT_BAIL_PGREEN || best.es > VERDICT_BAIL_ES) {\n      verdict = 'bail';\n      tips.push(`\ud83d\udd34 Low-percentage shot \u2014 only ~${Math.round(pG * 100)}% of your pattern finds this green (E[strokes] ${fmt(best.es\x2C 2)}). Play to the fat part or lay back.`);\n    } else {\n      verdict = 'manage';\n      tips.push(`\ud83d\udfe1 Manageable but not free \u2014 ~${Math.round(pG * 100)}% green with ${c.name}. Smooth swing\x2C favour the miss you can live with.`);\n    }\n\n    // Hardest-third stroke index: keep the commitment but soften the target line.\n    if (best && haz.length && Math.abs(best.aimLateral || 0) >= 3) {\n      const side = best.aimLateral > 0 ? 'right' : 'left';\n      const kind = haz.some((h) => h.type === 'water') ? 'the water' : 'the trouble';\n      tips.unshift(\n        `Aim ${Math.abs(Math.round(best.aimLateral))} yd ${side} of your target \u2014 against ${kind}\x2C that line saves about ${fmt(best.hz\x2C 2)} strokes.`\n      );\n    }\n    if (strokeIndex && strokeIndex <= 6) {\n      tips.push(\n        `#${strokeIndex} handicap hole \u2014 the numbers say commit\x2C but favour the fat side of the green over any corner pin.`\n      );\n    }\n\n    // Which miss is actually costly? Compare conditional expected strokes short vs long.\n    if (model) {\n      if (best.pLong > best.pShort * 1.6 && best.pLong > 0.12)\n        tips.push(`Your bad miss here is long (${Math.round(best.pLong * 100)}% vs ${Math.round(best.pShort * 100)}% short). Take the club that can't fly the back.`);\n      else if (best.pShort > best.pLong * 1.6 && best.pShort > 0.12)\n        tips.push(`Your bad miss here is short (${Math.round(best.pShort * 100)}% vs ${Math.round(best.pLong * 100)}% long) \u2014 most amateurs under-club; add one.`);\n      const depth = Math.round(model.depth);\n      if (depth >= 26) tips.push(`Deep green (~${depth} yd playing depth) \u2014 plenty of room\x2C be aggressive at the number.`);\n      else if (depth <= 14) tips.push(`Shallow green (~${depth} yd playing depth) \u2014 distance control decides this shot\x2C not line.`);\n    }\n\n    // Is a different club materially better\x2C or is this a coin flip?\n    const distinct = alternatives.filter((a\x2C i) =>\n      alternatives.findIndex((b) => b.club.id === a.club.id) === i).slice(0\x2C 3);\n    if (distinct.length > 1) {\n      const m = distinct[1].score - distinct[0].score;\n      if (m < ES_TIE_THRESHOLD)\n        tips.push(`${distinct[0].club.name} and ${distinct[1].club.name} are statistically tied \u2014 pick the one you'd rather hit.`);\n      else if (m > 0.06)\n        tips.push(`${c.name} is clearly right here \u2014 ${distinct[1].club.name} costs about ${fmt(m\x2C 2)} strokes.`);\n    }\n\n    // Where the target sits relative to the green.\n    if (model && playsTarget < model.front - 4) {\n      tips.push(\n        `Your selected target is about ${Math.round(\n          model.front - playsTarget\n        )} yd short of the green front. This is treated as an intentional layup target.`\n      );\n    }\n\n    if (model && playsTarget > model.back + 4) {\n      tips.push(\n        `Your selected target is about ${Math.round(\n          playsTarget - model.back\n        )} yd beyond the green back. Move the target onto the green unless that is intentional.`\n      );\n    }\n\n    // GPS uncertainty folded into the decision\x2C not just warned about.\n    if (accYd > ACCURACY_WARN_YD) {\n      const sigTot = Math.hypot(clubSigmaDistYd(c)\x2C accYd / RAYLEIGH_95);\n      tips.push(`GPS is \xb1${fmt(accYd)} yd \u2014 that inflates your effective distance spread to \xb1${fmt(sigTot * 1.5)} yd. Favour the middle.`);\n    }\n\n    const sub =\n      best.eff === 1\n        ? `${Math.round(pG * 100)}% green chance.`\n        : `${Math.round(pG * 100)}% green chance with a ${best.effName} swing.`;\n\n    return {\n      main\x2C\n      sub\x2C\n      verdict\x2C\n      tips\x2C\n\n      pGreen: pG\x2C\n      expectedStrokes: best.es\x2C\n      club: c\x2C\n      effort: best.eff\x2C\n      effortName: best.effName\x2C\n    };          // <-- this closes the object literal\n  }           // <-- ADD THIS: closes recommendSmart()\n  /**\n     * SIGNATURE PRESERVED: selectedClubGuidance(playsYd) -> string.\n     ...\n     */\n  function selectedClubGuidance(playsYd) {\n    const club = state.clubs.find((c) => c.id === state.prefs.selectedClubId);\n    if (!club || !Number.isFinite(playsYd)) return '';\n    const mu = num(club.yards\x2C 0);\n    if (mu <= 0) return '';\n    const sig = Math.max(1\x2C clubSigmaDistYd(club));\n    const pCover = 1 - normCdf((playsYd - mu) / sig);   // P(carry >= required)\n    const d = mu - playsYd;\n    const effort = playsYd / mu;\n    const pct = Math.round(pCover * 100);\n\n    let head;\n    if (Math.abs(d) <= 0.35 * sig) head = `${club.name}: stock`;\n    else if (d > 0 && effort >= 0.90) head = `${club.name}: easy (${Math.round(effort * 100)}%)`;\n    else if (d > 0) head = `${club.name}: too much \u2014 ${fmt(d)} yd long`;\n    else if (effort <= 1.06) head = `${club.name}: firm (${Math.round(effort * 100)}%)`;\n    else head = `${club.name}: not enough \u2014 ${fmt(-d)} yd short`;\n\n    return `${head} \xb7 ${pct}% chance of covering ${fmt(playsYd)} yd`;\n  }\n\n  // ============================================================\n  //  BLOCK 9 \u2014 GREEN GEOMETRY\n  //  Replaces: LEFTOVER_HIDE_YD\x2C OVERSHOOT_TOL_YD\x2C\n  //            leftoverToGreen\x2C formatLeftover\x2C greenGeometry\n  // ============================================================\n\n  const LEFTOVER_HIDE_YD = 3;        // below this\x2C leg 2 is degenerate \u2014 hide it\n  const OVERSHOOT_TOL_YD = 3;        // legacy name kept; superseded by the statistical test below\n  const GREEN_AXIS_MIN_YD = 6;       // front/back closer than this cannot define a reliable axis\n  const GREEN_ASPECT_DEFAULT = 1.15; // median green is slightly wider than deep \u2014 USGA Green Section green-sizing guidance\n  const GREEN_WIDTH_MIN_YD = 16;     // floor on modelled green width\x2C yd \u2014 smallest common championship green\n  const GREEN_WIDTH_MAX_YD = 55;     // ceiling on modelled green width\x2C yd \u2014 very large double green\n\n  /**\n   * SIGNATURE PRESERVED: leftoverToGreen(user\x2C aim\x2C green)\n   * -> { yards\x2C state\x2C lateralYd }\n   *\n   * `yards` is the ALONG-TRACK offset between the aim point and the green\n   * middle (projected onto your shot line) \u2014 NOT the straight-line separation.\n   *\n   * The old version used the crow-flies distance while the aim chip used the\n   * along-line projection\x2C so the label ("52 yd past middle") and the chip\n   * ("Aim: 50 yd past middle") disagreed whenever the middle sat even slightly\n   * beside your aim line. Every surface now reads this one function and can\n   * never disagree again.\n   */\n  function leftoverToGreen(user\x2C aim\x2C green) {\n    if (!user || !aim || !green) return null;\n\n    const aimToGreenYd = haversineMeters(aim\x2C green) * M_TO_YD;\n    if (aimToGreenYd < LEFTOVER_HIDE_YD)\n      return { yards: 0\x2C lateralYd: 0\x2C state: 'on' };\n\n    const userToAimYd = haversineMeters(user\x2C aim) * M_TO_YD;\n    const alongGreen = alongTrackYd(user\x2C aim\x2C green); // yd along the shot line\n    const lateralGreen = crossTrackYd(user\x2C aim\x2C green); // + = right of the line\n    const beyondYd = alongGreen - userToAimYd; // + = aim is SHORT of the middle\n\n    // Threshold = 1\u03c3 of the differential GPS error\x2C floored at the legacy tolerance.\n    const sigYd =\n      state.loc && Number.isFinite(state.loc.accuracy)\n        ? state.loc.accuracy * GPS_ACC_TO_SIGMA * M_TO_YD\n        : OVERSHOOT_TOL_YD;\n    const tol = Math.max(OVERSHOOT_TOL_YD\x2C sigYd);\n\n    const stateName =\n      beyondYd > tol ? 'short' : beyondYd < -tol ? 'over' : 'on';\n\n    return {\n      yards: Math.abs(beyondYd)\x2C\n      lateralYd: lateralGreen\x2C\n      state: stateName\x2C\n    };\n  }\n\n  // Canonical "aim target vs green middle" readout. Every surface that prints\n  // a "yd past/to middle" number must go through this so they always agree.\n  function greenCenterOffset() {\n    if (!state.loc || !state.target || !state.greenCenter) return null;\n    return leftoverToGreen(state.loc\x2C state.target\x2C state.greenCenter);\n  }\n\n  function formatLeftover(lo) {\n    if (!lo) return 'at middle';\n\n    if (lo.state === 'on') {\n      // "On" along the line but beside it: say the lateral offset\x2C since a\n      // bare "at middle" would be misleading.\n      if (Number.isFinite(lo.lateralYd) && Math.abs(lo.lateralYd) >= 8) {\n        return `middle ${Math.round(Math.abs(lo.lateralYd))} yd ${lo.lateralYd > 0 ? 'right' : 'left'\n          }`;\n      }\n      return 'at middle';\n    }\n\n    const y = Math.round(lo.yards);\n    let text =\n      lo.state === 'over' ? `${y} yd past middle` : `${y} yd to middle`;\n\n    // If the middle is meaningfully beside the line\x2C say so \u2014 otherwise the\n    // along-line number implies the middle sits right on your line.\n    if (Number.isFinite(lo.lateralYd) && Math.abs(lo.lateralYd) >= 8) {\n      text += ` (middle ${Math.round(Math.abs(lo.lateralYd))} yd ${lo.lateralYd > 0 ? 'right' : 'left'\n        })`;\n    }\n    return text;\n  }\n\n  /**\n   * SIGNATURE PRESERVED: greenGeometry() -> { front\x2C center\x2C back\x2C depth } (+ extras).\n   * front/center/back remain straight-line yardages from the player\x2C so all existing\n   * readouts are unchanged. depth is now the TRUE PLAYING DEPTH along the shot line.\n   */\n  function greenGeometry() {\n    if (!state.loc) return null;\n    const yd = (p) => (p ? haversineMeters(state.loc\x2C p) * M_TO_YD : null);\n    const front = yd(state.frontPt);\n    const center = yd(state.greenCenter);\n    const back = yd(state.backPt);\n\n    const aim = state.target || state.greenCenter || state.backPt || state.frontPt;\n    let depth = front != null && back != null ? Math.max(0\x2C back - front) : null;\n    let axisBearing = null\x2C obliquityDeg = null\x2C widthYd = null\x2C centerLateral = 0;\n    let frontAlong = null\x2C backAlong = null\x2C centerAlong = null;\n\n    if (aim && state.frontPt && state.backPt) {\n      const axisLen = haversineMeters(state.frontPt\x2C state.backPt) * M_TO_YD;\n      if (axisLen >= GREEN_AXIS_MIN_YD) {\n        axisBearing = initialBearingDeg(state.frontPt\x2C state.backPt);\n        const shotBearing = initialBearingDeg(state.loc\x2C aim);\n        obliquityDeg = Math.abs(angleDiff(axisBearing\x2C shotBearing));\n        // Playing depth = the green axis projected onto the shot line.\n        frontAlong = alongTrackYd(state.loc\x2C aim\x2C state.frontPt);\n        backAlong = alongTrackYd(state.loc\x2C aim\x2C state.backPt);\n        depth = Math.max(0\x2C backAlong - frontAlong);\n        // Width perpendicular to the AXIS\x2C estimated from the aspect ratio of the axis\n        // length\x2C then re-projected onto the shot line's cross direction. An oblique\n        // green presents more width and less depth \u2014 both handled here.\n        const axisWidth = clamp(axisLen * GREEN_ASPECT_DEFAULT\x2C GREEN_WIDTH_MIN_YD\x2C GREEN_WIDTH_MAX_YD);\n        const ob = d2r(obliquityDeg);\n        widthYd = clamp(\n          Math.abs(axisWidth * Math.cos(ob)) + Math.abs(axisLen * Math.sin(ob))\x2C\n          GREEN_WIDTH_MIN_YD\x2C GREEN_WIDTH_MAX_YD * 1.4\n        );\n      }\n    }\n    if (aim && state.greenCenter) {\n      centerAlong = alongTrackYd(state.loc\x2C aim\x2C state.greenCenter);\n      centerLateral = crossTrackYd(state.loc\x2C aim\x2C state.greenCenter);\n    }\n    if (widthYd == null && depth != null && depth > 0)\n      widthYd = clamp(depth * GREEN_ASPECT_DEFAULT\x2C GREEN_WIDTH_MIN_YD\x2C GREEN_WIDTH_MAX_YD);\n\n    return {\n      front\x2C center\x2C back\x2C depth\x2C\n      widthYd\x2C axisBearing\x2C obliquityDeg\x2C centerLateral\x2C\n      frontAlong\x2C backAlong\x2C centerAlong\x2C\n      // Straight-line depth\x2C kept separately so the UI can show both if you want.\n      depthStraight: front != null && back != null ? Math.max(0\x2C back - front) : null\x2C\n    };\n  }\n\n  // FCB is green reference data\x2C not an instruction to replace the user's map target.\n  // Only engage the green-aware optimizer when the selected target is actually\n  // on or very near the marked green center.\n  function targetIsOnMarkedGreen(geo) {\n    if (!state.loc || !state.target || !geo || !state.greenCenter) return false;\n\n    const targetToCenterYd =\n      haversineMeters(state.target\x2C state.greenCenter) * M_TO_YD;\n\n    // Green depth provides a reasonable tolerance. The clamp prevents very\n    // small or very large FCB spacing from making this too strict or too loose.\n    const toleranceYd = clamp(\n      (Number.isFinite(geo.depthStraight) ? geo.depthStraight : 24) * 0.8\x2C\n      18\x2C\n      35\n    );\n\n    return targetToCenterYd <= toleranceYd;\n  }\n\n  function targetToGreenTip() {\n    // Reads the SAME value the big label prints (greenCenterOffset)\x2C so the\n    // "yd past/to middle" figures can never differ between surfaces again.\n    const off = greenCenterOffset();\n    if (!off || off.state === 'on') return null;\n\n    const lateralText =\n      Number.isFinite(off.lateralYd) && Math.abs(off.lateralYd) >= 8\n        ? ` Green center is also about ${Math.round(\n          Math.abs(off.lateralYd)\n        )} yd ${off.lateralYd > 0 ? 'right' : 'left'} of your target line.`\n        : '';\n\n    if (off.state === 'short') {\n      return (\n        `This is a layup target: it leaves about ${Math.round(\n          off.yards\n        )} yd to green center.` +\n        ` Club choice is based on the selected target\x2C not the green center.` +\n        lateralText\n      );\n    }\n\n    return (\n      `Your selected target is about ${Math.round(\n        off.yards\n      )} yd beyond green center.` +\n      ` Move the target back onto the green unless that is intentional.` +\n      lateralText\n    );\n  }\n\n  /* ============================================================\n     BLOCK 9b \u2014 HAZARDS\x2C HOLE BRIEF & SMART LAYUP (advice inputs)\n     Spends the OSM-imported hazard coordinates and per-hole metadata\n     that were previously stored but never read.\n  ============================================================ */\n\n  const HAZARD_GREENSIDE_ALONG_YD = 28;  // "greenside" along-line window around the target\x2C yd\n  const HAZARD_GREENSIDE_CROSS_YD = 32;  // "greenside" lateral window\x2C yd\n  const HAZARD_CARRY_BUFFER_YD = 12;     // water this far short of the target counts as a carry threat\n  const TEE_SHOT_RADIUS_YD = 40;         // how close to the tee the hole brief appears\n\n  function holeHazards() {\n    const hole = getCurrentHoleData();\n    return hole && Array.isArray(hole.hazards) ? hole.hazards : [];\n  }\n\n  // Project imported hazards onto the CURRENT shot line: along = downrange\x2C\n  // cross = + right of the line.\n  function hazardsOnLine() {\n    const list = holeHazards();\n    if (!list.length || !state.loc || !state.target) return [];\n    return list\n      .map((h) => {\n        if (!h || !Number.isFinite(h.lat) || !Number.isFinite(h.lng))\n          return null;\n        return {\n          type: h.type === 'water' ? 'water' : 'bunker'\x2C\n          alongYd: alongTrackYd(state.loc\x2C state.target\x2C h)\x2C\n          crossYd: crossTrackYd(state.loc\x2C state.target\x2C h)\x2C\n        };\n      })\n      .filter(Boolean);\n  }\n\n  // Up to two human tips for hazards that genuinely threaten THIS target.\n  function hazardTips(targetYd) {\n    const out = [];\n    const hs = hazardsOnLine();\n    if (!hs.length) return out;\n\n    const side = (x) => (x >= 0 ? 'right' : 'left');\n\n    // Greenside threats: beside or around the target.\n    const greenside = hs.filter(\n      (h) =>\n        Math.abs(h.alongYd - targetYd) <= HAZARD_GREENSIDE_ALONG_YD &&\n        Math.abs(h.crossYd) <= HAZARD_GREENSIDE_CROSS_YD\n    );\n    if (greenside.length) {\n      const g =\n        greenside.find((h) => h.type === 'water') || greenside[0];\n      const kind = g.type === 'water' ? 'Water' : 'Bunker';\n      const whereTxt =\n        Math.abs(g.crossYd) >= 8\n          ? `${Math.round(Math.abs(g.crossYd))} yd ${side(g.crossYd)}`\n          : '';\n      const depthTxt =\n        Math.abs(g.alongYd - targetYd) <= 10\n          ? 'at the target'\n          : g.alongYd < targetYd\n            ? 'short'\n            : 'long';\n      out.push(\n        `${kind} ${depthTxt}${whereTxt ? ' ' + whereTxt : ''} of this target \u2014 favour the open side and take enough club to clear it.`\n      );\n    }\n\n    // Carry threats: water sitting ON the line between ball and target.\n    const carry = hs.filter(\n      (h) =>\n        h.type === 'water' &&\n        h.alongYd > 5 &&\n        h.alongYd < targetYd - HAZARD_CARRY_BUFFER_YD &&\n        Math.abs(h.crossYd) <= 18\n    );\n    if (carry.length) {\n      const c = carry.reduce((a\x2C b) => (b.alongYd > a.alongYd ? b : a));\n      out.push(\n        `The line crosses water around ${Math.round(c.alongYd)} yd \u2014 your club must clear it with margin\x2C not just reach.`\n      );\n    }\n    return out.slice(0\x2C 2);\n  }\n\n  // Opening plan while standing on/near this hole's tee of a fresh hole.\n  function holeBrief() {\n    if (!state.roundSession || !state.loc) return null;\n    const hole = getCurrentHoleData();\n    if (!hole || !hole.teePoint) return null;\n    const toTeeYd = haversineMeters(state.loc\x2C hole.teePoint) * M_TO_YD;\n    if (toTeeYd > TEE_SHOT_RADIUS_YD) return null;\n    // Fresh hole only: no counted shots logged here yet.\n    const played = (state.roundSession.shots || []).some(\n      (s) => s.hole === hole.number && s.counted\n    );\n    if (played) return null;\n\n    const course = getCurrentCourse();\n    const totalYd = Number(hole.yards) || null;\n    const par = hole.par || 4;\n\n    // Greedy full-swing plan from the long end of the bag.\n    const plan = [];\n    let remain = totalYd;\n    if (remain) {\n      for (const c of sortedClubsDesc()) {\n        if (remain <= c.yards * 1.08) break;\n        if (plan.length >= 3) break;\n        plan.push(c.name);\n        remain -= c.yards;\n      }\n    }\n\n    const bodyBits = [];\n    if (plan.length)\n      bodyBits.push(\n        `Plan: ${plan.join(' \u2192 ')}${remain > 0 ? `\x2C then ~${Math.round(remain)} yd in` : ''\n        }`\n      );\n    if (course?.teeName) bodyBits.push(`from the ${course.teeName}`);\n    if (hole.strokeIndex) bodyBits.push(`stroke index ${hole.strokeIndex}`);\n\n    return {\n      kicker: 'Hole brief'\x2C\n      main: `Par ${par}${totalYd ? ` \xb7 ${totalYd} yd` : ''}`\x2C\n      sub: bodyBits.join(' \xb7 ') || 'No mapped plan \u2014 play your normal tee club.'\x2C\n    };\n  }\n\n  // Named-club layup coaching for targets beyond the bag: names the club\n  // you're leaving yourself and\x2C with green geometry\x2C the exact finish yardage.\n  function smartLayupTip(geo) {\n    const desc = sortedClubsDesc();\n    const asc = sortedClubsAsc();\n    if (!asc.length || !desc.length) return null;\n    const calc = state.lastCalc;\n    if (!calc) return null;\n    const approach = asc[0]; // most lofted full swing\n    if (!(approach.yards > 0)) return null;\n\n    if (geo && Number.isFinite(geo.frontAlong)) {\n      const finishAt = Math.round(geo.frontAlong - approach.yards);\n      if (finishAt > 10) {\n        return `Smart layup: land it near ${finishAt} yd out \u2014 a full ${approach.name} (${approach.yards} yd) then covers the front edge.`;\n      }\n    }\n    return `Smart layup: club down short of your target so a full ${approach.name} (${approach.yards} yd) remains into the green.`;\n  }\n  // ============================================================\n  //  BLOCK 10 \u2014 WEATHER / ELEVATION CONTEXT\n  //  Replaces: updateContext\x2C getWeatherOrNeutral\x2C\n  //            getElevationOrNeutral\x2C updateWeatherUI\x2C stampText\n  // ============================================================\n\n  const ELEV_PROFILE_N = 9;          // sample count along the shot line; 9 resolves a ridge to ~1/8 of the shot\n  const BLIND_CLEARANCE_FT = 8;      // terrain rising this far above the sight line makes the shot blind\n  const GEOID_TYPICAL_CONUS_M = -30; // mean EGM96 geoid undulation over the CONUS\x2C m \u2014 NGA EGM96 model summary (used only to sanity-check GPS altitude)\n\n  function getWeatherOrNeutral() {\n    return state.context.weather || {\n      tempF: STD_TEMP_F\x2C rh: STD_RH\x2C windMph: 0\x2C windFromDeg: 0\x2C\n      pressureHpa: NaN\x2C gustMph: NaN\x2C shearAlpha: NaN\x2C\n    };\n  }\n  function getElevationOrNeutral() {\n    if (state.context.elevation) return state.context.elevation;\n    // GPS-only fallback: differential is zero\x2C absolute altitude is ellipsoidal so it is\n    // only used for density (a 30 m error costs ~0.3% density\x2C ~0.5 yd on a 200 yd shot).\n    const hasGpsAlt = state.loc && Number.isFinite(state.loc.altitude);\n    const gpsFt = hasGpsAlt ? state.loc.altitude * M_TO_FT : 0;\n    return { userFt: gpsFt\x2C targetFt: gpsFt\x2C usedGpsFallback: hasGpsAlt\x2C profileFt: null\x2C blindFt: 0 };\n  }\n\n  async function updateContext() {\n    const user = state.loc\x2C target = state.target;\n    if (!user && !target) { updateWeatherUI(); return; }\n    const seq = ++state.contextSeq;\n    const isCurrent = () => seq === state.contextSeq;\n\n    const p = target\n      ? (user ? midpointGeodesic(user\x2C target) : { lat: target.lat\x2C lng: target.lng })\n      : { lat: user.lat\x2C lng: user.lng };\n\n    // --- Weather: add pressure\x2C gusts\x2C and a second wind level for shear fitting ---\n    const wKey = `weather:${p.lat.toFixed(2)}\x2C${p.lng.toFixed(2)}`;\n    const wUrl = 'https://api.open-meteo.com/v1/forecast' +\n      `?latitude=${p.lat.toFixed(5)}&longitude=${p.lng.toFixed(5)}` +\n      '&current=temperature_2m\x2Crelative_humidity_2m\x2Cwind_speed_10m\x2Cwind_direction_10m\x2C' +\n      'wind_gusts_10m\x2Csurface_pressure\x2Cpressure_msl\x2Cwind_speed_80m\x2Cwind_direction_80m\x2Csunset' +\n      '&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=auto';\n    try {\n      const w = await cachedJSON(wKey\x2C wUrl\x2C WEATHER_TTL);\n      if (!isCurrent()) return;\n      const cur = w.data.current || {};\n      const u10 = num(cur.wind_speed_10m\x2C 0);\n      const u80 = num(cur.wind_speed_80m\x2C NaN);\n      const alpha = Number.isFinite(u80) ? fitShearAlpha(u10\x2C u80) : null;\n      // Prefer station-level surface_pressure; otherwise reduce MSL to station level.\n      let pHpa = num(cur.surface_pressure\x2C NaN);\n      if (!Number.isFinite(pHpa)) {\n        const msl = num(cur.pressure_msl\x2C NaN);\n        const e0 = state.context.elevation;\n        if (Number.isFinite(msl) && e0)\n          pHpa = stationPressureFromMSL(msl * 100\x2C e0.userFt * FT_TO_M\x2C\n            (num(cur.temperature_2m\x2C 70) - 32) / 1.8) / 100;\n      }\n      const sunsetMs = cur.sunset ? Date.parse(cur.sunset) : NaN;\n      state.context.weather = {\n        tempF: num(cur.temperature_2m\x2C STD_TEMP_F)\x2C\n        rh: num(cur.relative_humidity_2m\x2C STD_RH)\x2C\n        windMph: u10\x2C\n        windFromDeg: norm(num(cur.wind_direction_10m\x2C 0))\x2C\n        gustMph: num(cur.wind_gusts_10m\x2C NaN)\x2C\n        pressureHpa: Number.isFinite(pHpa) ? pHpa : NaN\x2C\n        shearAlpha: Number.isFinite(alpha) ? alpha : NaN\x2C\n        wind80Mph: Number.isFinite(u80) ? u80 : NaN\x2C\n        sunsetMs: Number.isFinite(sunsetMs) ? sunsetMs : NaN\x2C\n      };\n      state.context.offlineWeather = !!w.offline;\n      state.context.weatherTs = w.ts;\n    } catch {\n      if (!isCurrent()) return;\n      state.context.weather = null;\n      state.context.offlineWeather = true;\n    }\n\n    // --- Elevation: 9-point profile along the shot line ---\n    if (user && target) {\n      // Key rounded to ~110 m (toFixed(3)) instead of ~11 m: terrain deltas\n      // at that scale are a few feet\x2C irrelevant next to shot dispersion\x2C\n      // and the coarse grid lets adjacent holes share cached profiles\n      // instead of triggering a fresh fetch on every hole change.\n      const eKey = `elev:${user.lat.toFixed(3)}\x2C${user.lng.toFixed(3)}:` +\n        `${target.lat.toFixed(3)}\x2C${target.lng.toFixed(3)}`;\n      const g = geodesicInverse(user\x2C target);\n      const pts = [];\n      for (let i = 0; i < ELEV_PROFILE_N; i++)\n        pts.push(geodesicDirect(user\x2C g.az1\x2C (g.s * i) / (ELEV_PROFILE_N - 1)));\n      const eUrl = 'https://api.open-meteo.com/v1/elevation' +\n        `?latitude=${pts.map((q) => q.lat.toFixed(5)).join('\x2C')}` +\n        `&longitude=${pts.map((q) => q.lng.toFixed(5)).join('\x2C')}`;\n      try {\n        const e = await cachedJSON(eKey\x2C eUrl\x2C ELEV_TTL);\n        if (!isCurrent()) return;\n        const arr = Array.isArray(e.data.elevation) ? e.data.elevation : [];\n        const gpsAltM = state.loc && Number.isFinite(state.loc.altitude) ? state.loc.altitude : null;\n        const userM = Number.isFinite(arr[0]) ? arr[0] : gpsAltM;\n        const lastIdx = arr.length - 1;\n        const targetM = Number.isFinite(arr[lastIdx]) ? arr[lastIdx] : userM;\n        const profileFt = arr.filter(Number.isFinite).map((m) => m * M_TO_FT);\n        // Blind-shot detection: max terrain height above the straight sight line.\n        let blindFt = 0;\n        if (profileFt.length >= 3) {\n          const u = profileFt[0]\x2C t = profileFt[profileFt.length - 1]\x2C n = profileFt.length - 1;\n          for (let i = 1; i < n; i++) {\n            const sight = u + ((t - u) * i) / n;\n            blindFt = Math.max(blindFt\x2C profileFt[i] - sight);\n          }\n        }\n        state.context.elevation = {\n          userFt: Number.isFinite(userM) ? userM * M_TO_FT : 0\x2C\n          targetFt: Number.isFinite(targetM) ? targetM * M_TO_FT\n            : Number.isFinite(userM) ? userM * M_TO_FT : 0\x2C\n          usedGpsFallback: !Number.isFinite(arr[0]) && gpsAltM !== null\x2C\n          profileFt: profileFt.length ? profileFt : null\x2C\n          blindFt: Math.max(0\x2C blindFt)\x2C\n        };\n        state.context.offlineElevation = !!e.offline;\n        state.context.elevTs = e.ts;\n      } catch {\n        if (!isCurrent()) return;\n        const gpsFt = state.loc && Number.isFinite(state.loc.altitude)\n          ? state.loc.altitude * M_TO_FT : 0;\n        state.context.elevation = {\n          userFt: gpsFt\x2C targetFt: gpsFt\x2C\n          usedGpsFallback: state.loc && Number.isFinite(state.loc.altitude)\x2C\n          profileFt: null\x2C blindFt: 0\x2C\n        };\n        state.context.offlineElevation = true;\n      }\n    }\n    if (!isCurrent()) return;\n    updateWeatherUI();\n    if (state.target) calculateRange();\n  }\n\n  function updateWeatherUI() {\n    const w = getWeatherOrNeutral()\x2C e = getElevationOrNeutral();\n    const windArrow = $('windArrow');\n    const windCompass = $('windCompass');\n    if (state.context.weather && w.windMph >= 1) {\n      const gust = Number.isFinite(w.gustMph) && w.gustMph > w.windMph + 2\n        ? `\u2013${Math.round(w.gustMph)}` : '';\n      // Arrow points where the wind is blowing TOWARD.\n      const towardDeg = (w.windFromDeg + 180) % 360;\n      els.windMetric.textContent = `${fmt(w.windMph)}${gust} mph`;\n      els.windSubMetric.textContent = `from ${bearingToCompass(w.windFromDeg)}`;\n      if (windCompass) {\n        windCompass.hidden = false;\n        const sheetNeedle = $('windNeedle');\n        if (sheetNeedle) {\n          sheetNeedle.style.transform = `rotate(${towardDeg}deg)`;\n        }\n      }\n      // Map wind pill: same arrow + speed/direction\x2C visible without opening\n      // the sheet. Same rotation math as the sheet arrow so the two can\n      // never disagree.\n      if (els.windPill) {\n        const pillNeedle = $('windPillNeedle');\n        if (pillNeedle) {\n          pillNeedle.style.transform = `rotate(${towardDeg}deg)`;\n        }\n        if (els.windPillText) {\n          els.windPillText.textContent =\n            `${Math.round(w.windMph)}${gust} mph \xb7 from ${bearingToCompass(w.windFromDeg)}`;\n        }\n        els.windPill.hidden = false;\n      }\n    } else {\n      els.windMetric.textContent = state.context.weather ? `${fmt(w.windMph)} mph` : 'Neutral';\n      els.windSubMetric.textContent = '';\n      if (windCompass) windCompass.hidden = true;\n      // Wind pill stays visible even when neutral/no data (user: reassurance\n      // that it isn't broken) \u2014 shows a calm state instead of disappearing.\n      if (els.windPill) {\n        const pillNeedle = $('windPillNeedle');\n        if (pillNeedle) pillNeedle.style.transform = 'rotate(0deg)';\n        if (els.windPillText) {\n          els.windPillText.textContent = state.context.weather\n            ? `${fmt(w.windMph)} mph \xb7 calm`\n            : 'Calm';\n        }\n        els.windPill.hidden = false;\n      }\n    }\n    els.tempMetric.textContent = state.context.weather\n      ? `${fmt(w.tempF)}\xb0 / ${fmt(w.rh)}%` : `${STD_TEMP_F}\xb0 / ${STD_RH}%`;\n    if (state.context.elevation) {\n      const diff = e.targetFt - e.userFt;\n      els.elevMetric.textContent = `${diff >= 0 ? '+' : ''}${fmt(diff)} ft`;\n    } else els.elevMetric.textContent = '0 ft';\n\n    const bits = [];\n    if (!state.context.weather) bits.push('Neutral');\n    if (state.context.offlineWeather) bits.push('Cached wx');\n    if (state.context.offlineElevation) bits.push('Cached elev');\n    // Daylight budget: quiet clock when there's time\x2C a warning inside 45\n    // minutes of a live round.\n    if (Number.isFinite(w.sunsetMs)) {\n      const minsLeft = Math.round((w.sunsetMs - Date.now()) / 60000);\n      if (minsLeft > 0 && minsLeft <= 180) {\n        if (minsLeft <= 45 && roundStatus() !== 'idle') {\n          bits.push(`\u26a0 ${minsLeft} min light`);\n        } else {\n          const t = new Date(w.sunsetMs).toLocaleTimeString([]\x2C {\n            hour: 'numeric'\x2C\n            minute: '2-digit'\x2C\n          });\n          bits.push(`sunset ${t}`);\n        }\n      }\n    }\n    // Density ratio is the single most informative status number for a golfer.\n    const rho = airDensity({\n      tempF: w.tempF\x2C rh: w.rh\x2C\n      altitudeFt: (e.targetFt + e.userFt) / 2\x2C\n      pressureHpa: w.pressureHpa\x2C\n    });\n    bits.push(`\u03c1 ${fmt(rho / RHO_STD * 100)}%`);\n    if (Number.isFinite(w.pressureHpa)) bits.push('baro');\n    if (!state.context.offlineWeather && !state.context.offlineElevation &&\n      state.context.weather) bits.push('Live');\n    els.weatherStatus.textContent = bits.join(' \xb7 ');\n\n    // Keep the wind detail popover live while it is open.\n    if (windPopIsOpen()) renderWindPop();\n  }\n\n  function stampText() {\n    const wt = state.context.weatherTs ? new Date(state.context.weatherTs).toLocaleTimeString() : '\u2014';\n    const et = state.context.elevTs ? new Date(state.context.elevTs).toLocaleTimeString() : '\u2014';\n    const c = state.lastCalc;\n    const model = c && Number.isFinite(c.rhoKgM3)\n      ? ` \xb7 \u03c1=${fmt(c.rhoKgM3\x2C 4)} kg/m\xb3 (${fmt(c.densityRatio * 100\x2C 1)}% of std)` : '';\n    const solver = c && c.solverReached === false ? ' \xb7 target above apex (extrapolated)' : '';\n    return `Weather as of ${wt}${state.context.offlineWeather ? ' (offline)' : ''}` +\n      ` \xb7 Elevation as of ${et}${state.context.offlineElevation ? ' (offline)' : ''}` +\n      `${model}${solver} \xb7 3-DOF RK4 trajectory solve\x2C lie assumed neutral (0 yd).`;\n  }\n  // ============================================================\n  //  BLOCK 11 \u2014 WIND LABELING + TIP SCORING\n  //  Replaces: bearingToCompass\x2C windRelative\x2C caddyTips\x2C coachTips\n  // ============================================================\n\n  const COMPASS_32 = ['N'\x2C 'NbE'\x2C 'NNE'\x2C 'NEbN'\x2C 'NE'\x2C 'NEbE'\x2C 'ENE'\x2C 'EbN'\x2C 'E'\x2C 'EbS'\x2C 'ESE'\x2C 'SEbE'\x2C\n    'SE'\x2C 'SEbS'\x2C 'SSE'\x2C 'SbE'\x2C 'S'\x2C 'SbW'\x2C 'SSW'\x2C 'SWbS'\x2C 'SW'\x2C 'SWbW'\x2C 'WSW'\x2C 'WbS'\x2C\n    'W'\x2C 'WbN'\x2C 'WNW'\x2C 'NWbW'\x2C 'NW'\x2C 'NWbN'\x2C 'NNW'\x2C 'NbW'];  // 32-point mariner's compass \u2014 Bowditch\x2C American Practical Navigator\x2C Table of Compass Points\n  // SIGNATURE PRESERVED; optional second arg selects 32-point resolution (11.25\xb0 bins).\n  function bearingToCompass(bearing\x2C points) {\n    const b = norm(num(bearing\x2C 0));\n    if (points === 32) return COMPASS_32[Math.round(b / 11.25) % 32];\n    return COMPASS_16[Math.round(b / 22.5) % 16];\n  }\n\n  /**\n   * SIGNATURE PRESERVED: windRelative(windFromDeg\x2C shotBearing\x2C speedMph)\n   *   -> { along\x2C cross\x2C primary\x2C fromLabel }\n   * BUG FIX: the old implementation computed `cross` from the wind's TOWARD vector\x2C giving\n   * it the OPPOSITE sign to windComponents().crosswindMph. Both now use one convention:\n   *   along > 0 => tailwind   (unchanged)\n   *   cross > 0 => wind FROM the right => ball pushed LEFT => aim RIGHT  (was inverted)\n   */\n  const WIND_CALM_MPH = 1.5;         // below this the wind is inside model and gauge noise \u2014 WMO-No. 8 anemometer starting threshold\n  function windRelative(windFromDeg\x2C shotBearing\x2C speedMph) {\n    const { headwindMph\x2C crosswindMph } = windComponents({\n      windMph: speedMph\x2C windFromDeg\x2C bearingDeg: shotBearing\x2C\n    });\n    const along = -headwindMph;          // + = tail\x2C matching the original meaning\n    const cross = crosswindMph;          // + = from the right => aim right\n    const a = Math.abs(along)\x2C c = Math.abs(cross);\n    let primary;\n    if (num(speedMph\x2C 0) < WIND_CALM_MPH) primary = 'calm';\n    else if (a >= c) primary = along > 0 ? 'tail' : 'head';\n    else primary = cross > 0 ? 'cross\u2192' : 'cross\u2190';\n    return { along\x2C cross\x2C primary\x2C fromLabel: bearingToCompass(windFromDeg) };\n  }\n\n  /**\n   * SIGNATURE PRESERVED: caddyTips(ctx\x2C max = 2) -> string[]\n   * ctx keys used by the existing caller are unchanged (plays\x2C along\x2C cross\x2C elevFt\x2C gap\x2C\n   * longerName\x2C beyondLongest\x2C accYd). New optional keys are additive.\n   *\n   * Scoring is now an estimated stroke cost\x2C so ranking is meaningful rather than ordinal.\n   */\n  const TIP_STROKE_PER_YD_ERROR = 0.011;  // marginal strokes per yard of proximity error near a green \u2014 differentiated from Broadie (2014) proximity-to-strokes curves\n  const TIP_MIN_SCORE = 0.012;            // suppress tips worth less than ~0.012 strokes; below this it is noise\n  function caddyTips(ctx\x2C max = 2) {\n    const plays = num(ctx.plays\x2C 0);\n    const along = num(ctx.along\x2C 0)\x2C cross = num(ctx.cross\x2C 0);\n    const elevFt = num(ctx.elevFt\x2C 0)\x2C accYd = num(ctx.accYd\x2C 0);\n    const gap = ctx.gap == null ? null : num(ctx.gap\x2C 0);\n    const aimYd = num(ctx.aimYd\x2C 0)\x2C gustYd = num(ctx.gustYd\x2C 0);\n    const densityRatio = num(ctx.densityRatio\x2C 1);\n    const apexFt = num(ctx.apexFt\x2C NaN)\x2C descentDeg = num(ctx.descentDeg\x2C NaN);\n    const blindFt = num(ctx.blindFt\x2C 0);\n    const S = TIP_STROKE_PER_YD_ERROR;\n\n    const TIPS = [\n      {\n        id: 'headwind'\x2C cat: 'wind'\x2C\n        score: () => (along < -3 ? Math.abs(num(ctx.windAdjYd\x2C along * -1.5)) * S : 0)\x2C\n        text: () => `~${Math.abs(Math.round(along))} mph into you \u2014 that is worth about ${Math.abs(Math.round(num(ctx.windAdjYd\x2C 0)))} yd of club. Swing ~80%: forcing it adds spin and balloons the ball short.`\n      }\x2C\n      {\n        id: 'tailwind'\x2C cat: 'wind'\x2C\n        score: () => (along > 5 ? Math.abs(num(ctx.windAdjYd\x2C 0)) * S * 1.2 : 0)\x2C\n        text: () => `Helping wind takes ~${Math.abs(Math.round(num(ctx.windAdjYd\x2C 0)))} yd off and kills spin \u2014 the ball will not stop. Land it short of the flag and plan for release.`\n      }\x2C\n      {\n        id: 'cross'\x2C cat: 'wind'\x2C\n        score: () => (Math.abs(aimYd) >= 2 ? Math.abs(aimYd) * S * 0.8 : 0)\x2C\n        text: () => {\n          const lr = cross > 0 ? 'right-to-left across you' : 'left-to-right across you';\n          const side = aimYd > 0 ? 'right' : 'left';\n          return `~${Math.abs(Math.round(cross))} mph ${lr} \u2014 start it ~${Math.abs(aimYd)} yd ${side} of the pin (${fmt(Math.abs(num(ctx.aimDeg\x2C 0))\x2C 1)}\xb0) and let it ride back. Do not fight it.`;\n        }\n      }\x2C\n      {\n        id: 'gust'\x2C cat: 'wind'\x2C\n        score: () => (gustYd >= 4 ? gustYd * S * 0.9 : 0)\x2C\n        text: () => `Gusting \u2014 the same swing is worth \xb1${Math.round(gustYd)} yd depending on when you pull the trigger. Wait for a lull or take the extra club and swing easy.`\n      }\x2C\n      {\n        id: 'uphill'\x2C cat: 'elev'\x2C\n        score: () => (elevFt > 6 ? Math.abs(num(ctx.elevAdjYd\x2C elevFt / 3)) * S : 0)\x2C\n        text: () => `Plays ~${Math.abs(Math.round(num(ctx.elevAdjYd\x2C elevFt / 3)))} yd uphill \u2014 already in your number. Take enough club; uphill shots land steeper and stop faster.`\n      }\x2C\n      {\n        id: 'downhill'\x2C cat: 'elev'\x2C\n        score: () => (elevFt < -6 ? Math.abs(num(ctx.elevAdjYd\x2C elevFt / 3)) * S : 0)\x2C\n        text: () => `Plays ~${Math.abs(Math.round(num(ctx.elevAdjYd\x2C elevFt / 3)))} yd downhill \u2014 club down\x2C and expect a shallower landing angle and more roll.`\n      }\x2C\n      {\n        id: 'blind'\x2C cat: 'elev'\x2C\n        score: () => (blindFt > BLIND_CLEARANCE_FT ? 0.05 : 0)\x2C\n        text: () => `Terrain rises ~${Math.round(blindFt)} ft above your sight line \u2014 this is a blind shot. Pick an aim point on the horizon before you address the ball.`\n      }\x2C\n      {\n        id: 'density'\x2C cat: 'air'\x2C\n        score: () => (Math.abs(densityRatio - 1) > 0.03\n          ? Math.abs(num(ctx.altitudeAdjYd\x2C 0) + num(ctx.tempAdjYd\x2C 0)) * S : 0)\x2C\n        text: () => densityRatio < 1\n          ? `Thin air (${fmt(densityRatio * 100)}% of standard density) \u2014 the ball is carrying ~${Math.abs(Math.round(num(ctx.altitudeAdjYd\x2C 0) + num(ctx.tempAdjYd\x2C 0)))} yd farther than your stock numbers.`\n          : `Heavy air (${fmt(densityRatio * 100)}% of standard density) \u2014 costs ~${Math.abs(Math.round(num(ctx.altitudeAdjYd\x2C 0) + num(ctx.tempAdjYd\x2C 0)))} yd. Take the extra club.`\n      }\x2C\n      {\n        id: 'between'\x2C cat: 'club'\x2C\n        score: () => (gap !== null && gap > 3 && gap <= 16 ? 0.04 : 0)\x2C\n        text: () => `Between clubs \u2014 take the ${ctx.longerName} and smooth it. Most amateur approach misses are short\x2C and pin-high is rarely a bad result.`\n      }\x2C\n      {\n        id: 'stock'\x2C cat: 'club'\x2C\n        score: () => (gap !== null && Math.abs(gap) <= 3 ? 0.018 : 0)\x2C\n        text: () => `Stock ${ctx.longerName} number \u2014 commit and make your normal swing.`\n      }\x2C\n      {\n        id: 'wedge'\x2C cat: 'club'\x2C\n        score: () => (plays > 20 && plays < 60 ? 0.045 : 0)\x2C\n        text: () => `Partial wedge \u2014 control distance with swing length\x2C never by decelerating. Pick a stock 3/4 or 1/2 carry you have actually practiced.`\n      }\x2C\n      {\n        id: 'steep'\x2C cat: 'flight'\x2C\n        score: () => (Number.isFinite(descentDeg) && descentDeg > 48 && plays > 60 ? 0.02 : 0)\x2C\n        text: () => `Steep ${fmt(descentDeg)}\xb0 descent \u2014 this one will stop quickly. You can fly it at the flag.`\n      }\x2C\n      {\n        id: 'shallow'\x2C cat: 'flight'\x2C\n        score: () => (Number.isFinite(descentDeg) && descentDeg < 35 && plays > 120 ? 0.03 : 0)\x2C\n        text: () => `Shallow ${fmt(descentDeg)}\xb0 descent \u2014 the ball will run out. Land it short and use the ground.`\n      }\x2C\n      {\n        id: 'layup'\x2C cat: 'strategy'\x2C\n        score: () => (ctx.beyondLongest ? 0.10 : 0)\x2C\n        text: () => `Beyond your longest club \u2014 lay up to a full-wedge number rather than forcing a hero shot. Expected strokes favour the layup here.`\n      }\x2C\n      {\n        id: 'accuracy'\x2C cat: 'strategy'\x2C\n        score: () => (accYd > ACCURACY_WARN_YD ? accYd * S * 0.6 : 0)\x2C\n        text: () => `GPS is only \xb1${fmt(accYd)} yd \u2014 that is real distance uncertainty on top of your swing. Favour the centre of the green.`\n      }\x2C\n      {\n        id: 'missbias'\x2C cat: 'pattern'\x2C\n        score: () => (ctx.lateralBiasYd != null && Math.abs(ctx.lateralBiasYd) >= 6 ? 0.06 : 0)\x2C\n        text: () => {\n          const b = ctx.lateralBiasYd;\n          const dir = b > 0 ? 'right' : 'left';\n          return `Your tracked pattern: misses with ${ctx.biasClubName} average ${Math.abs(Math.round(b))} yd ${dir}. Start this one at the ${b > 0 ? 'left' : 'right'} edge and let the bias work back to centre.`;\n        }\n      }\x2C\n    ];\n    const seen = new Set();\n    return TIPS.map((t) => {\n      let s = 0;\n      try { s = t.score(); } catch { s = 0; }\n      return { ...t\x2C s: Number.isFinite(s) ? s : 0 };\n    })\n      .filter((t) => t.s > TIP_MIN_SCORE)\n      .sort((a\x2C b) => b.s - a.s)\n      .filter((t) => (seen.has(t.cat) ? false : seen.add(t.cat)))\n      .slice(0\x2C max)\n      .map((t) => { try { return t.text(); } catch { return null; } })\n      .filter(Boolean);\n  }\n\n  /**\n   * SIGNATURE PRESERVED: coachTips(ctx) -> string[]\n   * Now driven by the posterior model: reports which clubs have enough data to trust\x2C\n   * which are still prior-dominated\x2C and where the bag has gaps or overlaps.\n   */\n  const COACH_TRUST_N = 8;           // shots per club before the posterior clearly dominates the prior at \u03bd\u2080=6\n  const GAP_IDEAL_YD = 12;           // target spacing between adjacent clubs\x2C yd \u2014 standard fitting practice for a full bag\n  const GAP_OVERLAP_FRAC = 0.55;     // adjacent clubs whose gap is under this fraction of their combined \u03c3 are redundant\n  function coachTips(ctx) {\n    const tips = [];\n    const { total\x2C clubs: clubCount } = shotDataSummary();\n    const desc = sortedClubsDesc();\n\n    if (!total) {\n      tips.push(\n        'No tracked shots yet. Start Round mode\x2C choose a club\x2C tap Start shot\x2C walk to your ball\x2C then tap Finish shot. Each accepted shot improves your distance and dispersion model.'\n      );\n      tips.push(`Until then Caddy uses a skill prior of about ${fmt(priorRelSigma(150) * 100\x2C 1)}% relative dispersion. Real data typically beats that within 10 shots per club.`);\n      return tips;\n    }\n    tips.push(`${total} shot${total === 1 ? '' : 's'} logged across ${clubCount} club${clubCount === 1 ? '' : 's'}. Posterior dispersion is now driving your club choices.`);\n\n    // Which clubs need data most? Rank by prior weight still remaining.\n    const thin = desc.map((c) => ({ c\x2C st: clubStats(c.id) }))\n      .filter((o) => (o.st.nEff || 0) < COACH_TRUST_N)\n      .sort((a\x2C b) => (a.st.nEff || 0) - (b.st.nEff || 0));\n    if (thin.length) {\n      const names = thin.slice(0\x2C 3).map((o) => o.c.name).join('\x2C ');\n      tips.push(`Thinnest data: ${names}. About ${COACH_TRUST_N} tracked shots each and the model stops guessing for them.`);\n    }\n\n    // Is any club's stock number contradicted by the data?\n    for (const c of desc) {\n      const st = clubStats(c.id);\n      if ((st.nEff || 0) < SHOT_MIN_TRUST_N || !Number.isFinite(st.ciLo)) continue;\n      const stock = num(c.yards\x2C 0);\n      if (stock > 0 && (stock < st.ciLo || stock > st.ciHi)) {\n        tips.push(`${c.name} is set to ${stock} yd but your tracked carry is ${fmt(st.meanPost)} yd (95% CI ${fmt(st.ciLo)}\u2013${fmt(st.ciHi)}). Update it in the Clubs tab.`);\n        break;\n      }\n    }\n    // Trend detection.\n    for (const c of desc) {\n      const st = clubStats(c.id);\n      if (Number.isFinite(st.trendYdPer30d) && Math.abs(st.trendYdPer30d) >= 3) {\n        tips.push(st.trendYdPer30d > 0\n          ? `${c.name} is trending ~${fmt(st.trendYdPer30d\x2C 1)} yd longer per month \u2014 you are gaining speed.`\n          : `${c.name} is trending ~${fmt(-st.trendYdPer30d\x2C 1)} yd shorter per month \u2014 worth checking strike or equipment.`);\n        break;\n      }\n    }\n    // Gapping.\n    const gaps = gapAnalysis();\n    const bad = gaps.find((g) => g.verdict !== 'ok');\n    if (bad) tips.push(bad.note);\n    return tips;\n  }\n  // ============================================================\n  //  BLOCK 12 \u2014 SHOT CAPTURE & REJECTION\n  //  Replaces: gpsAccMeters\x2C fixIsUsable\x2C finishShot\n  // ============================================================\n\n  const SHOT_SNR_MIN = 4.0;          // require the measured displacement to exceed 4\u03c3 of its own uncertainty\n  const SHOT_LATERAL_MAX_DEG = 45;   // beyond this off-line the "shot" is a re-tee or a walk\x2C not a swing\n  const SHOT_DWELL_MS = 1500;        // require the fix to have settled this long before trusting a capture\n\n  function gpsAccMeters() {\n    return state.loc && Number.isFinite(state.loc.accuracy) ? state.loc.accuracy : Infinity;\n  }\n  function fixIsUsable() {\n    if (!state.loc || state.locStale) return false;\n    if (gpsAccMeters() > ROUND_GPS_OK_M) return false;\n    // Also require the player to be roughly still: a fix captured mid-stride carries a\n    // velocity-lag bias of (speed x filter lag)\x2C several yards at walking pace.\n    return kalman.speedMps() < 1.4;\n  }\n  // 1\u03c3 uncertainty\x2C in yards\x2C of a distance measured between two independent fixes.\n  function shotDistanceSigmaYd(accAm\x2C accBm) {\n    const sa = num(accAm\x2C ROUND_GPS_OK_M) * GPS_ACC_TO_SIGMA;\n    const sb = num(accBm\x2C ROUND_GPS_OK_M) * GPS_ACC_TO_SIGMA;\n    return Math.sqrt(sa * sa + sb * sb) * M_TO_YD;\n  }\n\n  // SIGNATURE PRESERVED: finishShot(discard)\n  function finishShot(discard) {\n    const rs = state.roundSession;\n    if (!rs || !rs.pending) return;\n    if (!discard && !fixIsUsable()) {\n      setNotice('Need a good\x2C settled GPS fix to measure the shot. Stand still for a moment\x2C or discard.'\x2C 'danger');\n      haptic(12);\n      return;\n    }\n    const p = rs.pending;\n    const endPt = { lat: state.loc.lat\x2C lng: state.loc.lng };\n    const distanceYd = haversineMeters(p.startPt\x2C endPt) * M_TO_YD;\n    const bearingDeg = initialBearingDeg(p.startPt\x2C endPt);\n\n    // Signed lateral offset from the intended line via the exact cross-track projection.\n    let lateralYd = null;\n    if (p.intendedBearing != null && distanceYd > 0) {\n      const aimPt = geodesicDirect(p.startPt\x2C p.intendedBearing\x2C distanceYd * YD_TO_M);\n      lateralYd = Math.round(-crossTrackYd(p.startPt\x2C aimPt\x2C endPt));\n    }\n\n    const club = state.clubs.find((c) => c.id === p.clubId);\n    const baseline = club ? num(club.yards\x2C 0) : 0;\n\n    // Statistical rejection instead of a fixed 8 yd floor.\n    const sigYd = shotDistanceSigmaYd(p.startAcc\x2C gpsAccMeters());\n    const belowNoise = distanceYd < Math.max(ROUND_MIN_SHOT_YD\x2C SHOT_SNR_MIN * sigYd);\n    const wayOffLine = p.intendedBearing != null &&\n      Math.abs(angleDiff(bearingDeg\x2C p.intendedBearing)) > SHOT_LATERAL_MAX_DEG;\n    const doDiscard = !!discard || belowNoise;\n\n    let counted = false;\n    if (!doDiscard && p.clubId && !wayOffLine)\n      counted = logShot(p.clubId\x2C distanceYd\x2C baseline\x2C lateralYd\x2C gpsAccMeters());\n\n    if (!Array.isArray(rs.shots)) rs.shots = [];\n    rs.shots.push({\n      clubId: p.clubId\x2C startPt: p.startPt\x2C endPt\x2C\n      distanceYd: Math.round(distanceYd)\x2C\n      bearingDeg: Math.round(bearingDeg)\x2C\n      intendedBearing: p.intendedBearing == null ? null : Math.round(p.intendedBearing)\x2C\n      lateralYd\x2C hole: rs.hole\x2C ts: Date.now()\x2C\n      discarded: doDiscard\x2C counted\x2C\n    });\n    rs.pending = null;\n    rs.status = 'active';\n    saveRoundSession();\n    renderRoundShotUI();\n    releaseWakeLock();\n\n    if (belowNoise && !discard)\n      setNotice(`Only ${Math.round(distanceYd)} yd \u2014 inside GPS noise (\xb1${fmt(sigYd)} yd). Logged as non-counting.`\x2C 'greenish');\n    else if (doDiscard)\n      setNotice('Shot discarded \u2014 kept in history\x2C excluded from your model.'\x2C 'greenish');\n    else if (wayOffLine)\n      setNotice(`${Math.round(distanceYd)} yd but ${Math.round(Math.abs(angleDiff(bearingDeg\x2C p.intendedBearing)))}\xb0 off line \u2014 recorded\x2C excluded from distance stats.`\x2C 'greenish');\n    else if (counted) {\n      const st = clubStats(p.clubId);\n      setNotice(`${club ? club.name : 'Shot'}: ${Math.round(distanceYd)} yd (\xb1${fmt(sigYd)} yd GPS). ` +\n        `Carry model now ${fmt(st.meanPost)} \xb1 ${fmt(st.sigmaPost)} yd from ${st.n} shot${st.n === 1 ? '' : 's'}.`\x2C 'greenish');\n    } else\n      setNotice(`${Math.round(distanceYd)} yd recorded (outside normal range \u2014 excluded from club stats).`\x2C 'greenish');\n\n    renderPendingShot();\n    hapticPattern('shotFinish');\n    if (state.target && state.loc) calculateRange();\n  }\n  // ============================================================\n  //  BLOCK 13 \u2014 PRACTICE ANALYTICS + GAPPING\n  //  Replaces: renderPracticeSection.  Adds: gapAnalysis.\n  // ============================================================\n\n  /**\n   * Gapping analysis. A gap is "bad" not at a fixed yardage but relative to the\n   * dispersion of the two clubs bracketing it: if the gap exceeds the combined\n   * predictive spread you have a distance you cannot cover; if it is far smaller\x2C\n   * the two clubs are statistically indistinguishable and one is wasted.\n   */\n  function gapAnalysis() {\n    const desc = sortedClubsDesc();\n    const out = [];\n    for (let i = 0; i < desc.length - 1; i++) {\n      const hi = desc[i]\x2C lo = desc[i + 1];\n      const gap = hi.yards - lo.yards;\n      const sHi = clubSigmaDistYd(hi)\x2C sLo = clubSigmaDistYd(lo);\n      const sComb = Math.sqrt(sHi * sHi + sLo * sLo);\n      // Probability that a shot aimed at the midpoint misses both clubs' comfortable range.\n      const mid = (hi.yards + lo.yards) / 2;\n      const pMid = Math.max(\n        1 - normCdf((mid - lo.yards) / Math.max(EPS\x2C sLo))\x2C\n        normCdf((mid - hi.yards) / Math.max(EPS\x2C sHi))\n      );\n      let verdict = 'ok'\x2C note = '';\n      if (gap > 1.9 * sComb && gap > GAP_IDEAL_YD * 1.6) {\n        verdict = 'gap';\n        note = `${gap} yd between ${hi.name} and ${lo.name} is wider than your dispersion (\xb1${fmt(sComb)} yd) can bridge \u2014 around ${Math.round(mid)} yd you have no comfortable club.`;\n      } else if (gap < GAP_OVERLAP_FRAC * sComb) {\n        verdict = 'overlap';\n        note = `${hi.name} and ${lo.name} are only ${gap} yd apart versus \xb1${fmt(sComb)} yd of spread \u2014 statistically the same club. One slot is wasted.`;\n      }\n      out.push({ hi\x2C lo\x2C gap\x2C sComb\x2C pMid\x2C verdict\x2C note });\n    }\n    return out;\n  }\n\n  // SIGNATURE PRESERVED: renderPracticeSection()\n  function renderPracticeSection() {\n    const { total\x2C clubs: clubCount } = shotDataSummary();\n    const pc = document.getElementById('practiceShots');\n    const pcl = document.getElementById('practiceClubs');\n    const pb = document.getElementById('practiceBreakdown');\n    const chip = document.getElementById('practiceSessionChip');\n\n    if (pc) pc.textContent = String(total);\n    if (pcl) pcl.textContent = String(clubCount);\n    if (chip) chip.textContent = total ? 'Active' : 'No session';\n    if (!pb) return;\n\n    const desc = sortedClubsDesc();\n    if (!total || !desc.length) {\n      pb.innerHTML = '<div class="hint">Track shots to see per-club posterior carry\x2C dispersion and gapping here.</div>';\n      return;\n    }\n    const rows = [];\n    for (const c of desc) {\n      const st = clubStats(c.id);\n      if (!st.n) continue;\n      const disp = clubDispersionYd(c);\n      const rel = st.meanPost > 0 ? (st.sigmaPost / st.meanPost) * 100 : NaN;\n      const ci = Number.isFinite(st.ciLo) ? `${fmt(st.ciLo)}\u2013${fmt(st.ciHi)}` : '\u2014';\n      const flag = num(c.yards\x2C 0) > 0 && Number.isFinite(st.ciLo) &&\n        (c.yards < st.ciLo || c.yards > st.ciHi) ? ' \u26a0\ufe0e' : '';\n      rows.push(\n        `<div class="break-row"><span>${escapeHtml(c.name)}${flag}</span>` +\n        `<b>${fmt(st.meanPost)} \xb1${fmt(st.sigmaPost\x2C 1)} yd \xb7 ${fmt(rel\x2C 1)}% \xb7 ` +\n        `n=${st.n} (n<sub>eff</sub> ${fmt(st.nEff\x2C 1)}) \xb7 CI ${ci} \xb7 band \xb1${disp}</b></div>`\n      );\n      if (Number.isFinite(st.lateralSigma))\n        rows.push(`<div class="break-row"><span style="opacity:.6">\u21b3 lateral \u03c3</span>` +\n          `<b style="opacity:.75">\xb1${fmt(st.lateralSigma\x2C 1)} yd (${fmt((st.lateralSigma / Math.max(1\x2C st.meanPost)) * 100\x2C 1)}%)</b></div>`);\n      if (Number.isFinite(st.trendYdPer30d) && Math.abs(st.trendYdPer30d) >= 1.5)\n        rows.push(`<div class="break-row"><span style="opacity:.6">\u21b3 trend</span>` +\n          `<b style="opacity:.75">${st.trendYdPer30d > 0 ? '+' : ''}${fmt(st.trendYdPer30d\x2C 1)} yd / 30 d</b></div>`);\n    }\n    const gaps = gapAnalysis().filter((g) => g.verdict !== 'ok');\n    if (gaps.length) {\n      rows.push('<div class="break-row" style="margin-top:6px"><span><b>\u2014 Gapping \u2014</b></span><b></b></div>');\n\n      // Visual band chart: every club's coverage band drawn to scale across\n      // the bag's yardage range\x2C so overlaps and dead zones are SEEN.\n      const descAll = sortedClubsDesc();\n      const scaleMax = Math.max(...descAll.map((x) => x.yards)) * 1.08 || 300;\n      const chart = descAll\n        .filter((c) => c.yards > 0)\n        .map((c) => {\n          const st = clubStats(c.id);\n          const meanC =\n            Number.isFinite(st.meanPost) && st.n >= SHOT_MIN_TRUST_N\n              ? st.meanPost\n              : c.yards;\n          const bandYd = clubDispersionYd(c);\n          const lo = Math.max(0\x2C meanC - bandYd);\n          const hi = meanC + bandYd;\n          const lft = clamp((lo / scaleMax) * 100\x2C 0\x2C 97);\n          const wdt = clamp(\n            ((hi - lo) / scaleMax) * 100\x2C\n            3\x2C\n            100 - lft\n          );\n          const flagged = gaps.some(\n            (g) => g.hi.id === c.id || g.lo.id === c.id\n          );\n          return (\n            `<div class="gap-chart-row${flagged ? ' flag' : ''}" title="${escapeHtml(\n              c.name\n            )}: covers ~${Math.round(lo)}\u2013${Math.round(hi)} yd">` +\n            `<span class="gap-chart-name">${escapeHtml(c.name)}</span>` +\n            `<span class="gap-track"><span class="gap-band" style="left:${lft.toFixed(\n              1\n            )}%;width:${wdt.toFixed(1)}%"></span></span>` +\n            `<b class="gap-chart-yd">${Math.round(meanC)}</b></div>`\n          );\n        })\n        .join('');\n      rows.push(`<div class="gap-chart">${chart}</div>`);\n\n      for (const g of gaps)\n        rows.push(`<div class="break-row"><span>${escapeHtml(g.hi.name)} \u2192 ${escapeHtml(g.lo.name)}</span>` +\n          `<b>${g.gap} yd \xb7 ${g.verdict === 'gap' ? 'too wide' : 'redundant'}</b></div>`);\n    }\n    pb.innerHTML = rows.length ? rows.join('')\n      : '<div class="hint">No shots tracked yet.</div>';\n  }\n  // ============================================================\n  //  BLOCK 14 \u2014 ROUND STATISTICS\n  //  Replaces: summarizeRound\x2C renderStats\n  // ============================================================\n\n  const STATS_CONF = 0.90;             // reporting confidence for rate intervals; 90% is the right call at ~14 samples\n  const HISTORY_HALFLIFE_ROUNDS = 8;   // exponential recency half-life for history averages\x2C rounds\n  const PUTTS_PAR_BASELINE = 1.75;     // Tour putts per green hit in regulation \u2014 Broadie\x2C Every Shot Counts (2014) ch.5\n\n  /**\n   * SIGNATURE PRESERVED: summarizeRound(round) -> all original keys\x2C plus extras.\n   * Original keys: played\x2C totalScore\x2C puttRows\x2C totalPutts\x2C firRows\x2C firMade\x2C girRows\x2C girMade.\n   */\n  function summarizeRound(round) {\n    const rows = Array.isArray(round) ? round : [];\n    const played = rows.filter((r) => r.score !== '' && Number.isFinite(Number(r.score)));\n    const totalScore = played.reduce((s\x2C r) => s + num(r.score\x2C 0)\x2C 0);\n    const puttRows = rows.filter((r) => r.putts !== '' && Number.isFinite(Number(r.putts)));\n    const totalPutts = puttRows.reduce((s\x2C r) => s + num(r.putts\x2C 0)\x2C 0);\n    const firRows = rows.filter((r) => r.fir === 'Y' || r.fir === 'N');\n    const firMade = firRows.filter((r) => r.fir === 'Y').length;\n    const girRows = rows.filter((r) => r.gir === 'Y' || r.gir === 'N');\n    const girMade = girRows.filter((r) => r.gir === 'Y').length;\n\n    // Putts split by whether the green was hit \u2014 the single most diagnostic split available\n    // from this scorecard\x2C because putts on missed greens conflate chipping with putting.\n    const girHoles = rows.filter((r) => r.gir === 'Y' && r.putts !== '' && Number.isFinite(Number(r.putts)));\n    const nonGirHoles = rows.filter((r) => r.gir === 'N' && r.putts !== '' && Number.isFinite(Number(r.putts)));\n    const puttsOnGir = girHoles.length ? girHoles.reduce((s\x2C r) => s + num(r.putts\x2C 0)\x2C 0) / girHoles.length : null;\n    const puttsOffGir = nonGirHoles.length ? nonGirHoles.reduce((s\x2C r) => s + num(r.putts\x2C 0)\x2C 0) / nonGirHoles.length : null;\n    const scores = played.map((r) => num(r.score\x2C 0));\n    const scoreSd = scores.length >= 2\n      ? Math.sqrt(scores.reduce((a\x2C b) => a + (b - totalScore / scores.length) ** 2\x2C 0) / (scores.length - 1)) : null;\n    // Unbiased full-round projection (over the course's hole count) with SE.\n    const roundLen = getCourseHoleCount();\n    const proj = played.length ? (totalScore / played.length) * roundLen : null;\n    const projSe = played.length >= 2 && scoreSd != null\n      ? roundLen * (scoreSd / Math.sqrt(played.length)) *\n      Math.sqrt(Math.max(0\x2C (roundLen - played.length) / Math.max(1\x2C roundLen - 1)))\n      : null;\n\n    // Scoring averages by par. Outside a live session the course lookup\n    // falls back to par 4 \u2014 legacy scorecards get approximate splits.\n    const courseNow = getCurrentCourse();\n    const parSplits = {};\n    rows.forEach((r\x2C i) => {\n      const sc = Number(r.score);\n      if (!Number.isFinite(sc) || sc <= 0) return;\n      const par = clamp(\n        Math.round(num(courseNow?.holes?.[i]?.par\x2C 4))\x2C\n        3\x2C\n        6\n      );\n      if (par > 5) return;\n      parSplits[par] = parSplits[par] || { n: 0\x2C total: 0 };\n      parSplits[par].n += 1;\n      parSplits[par].total += sc;\n    });\n\n    return {\n      played: played.length\x2C totalScore\x2C\n      puttRows: puttRows.length\x2C totalPutts\x2C\n      firRows: firRows.length\x2C firMade\x2C\n      girRows: girRows.length\x2C girMade\x2C\n      // extras\n      firCI: wilsonInterval(firMade\x2C firRows.length\x2C STATS_CONF)\x2C\n      girCI: wilsonInterval(girMade\x2C girRows.length\x2C STATS_CONF)\x2C\n      puttsOnGir\x2C puttsOffGir\x2C scoreSd\x2C\n      projected18: proj\x2C projected18Se: projSe\x2C\n      threePutts: puttRows.filter((r) => num(r.putts\x2C 0) >= 3).length\x2C\n      onePutts: puttRows.filter((r) => num(r.putts\x2C 0) === 1).length\x2C\n      totalPen: rows.reduce((a\x2C r) => a + (Number(r.penalties) || 0)\x2C 0)\x2C\n      parSplits\x2C\n    };\n  }\n\n  // Direction of your misses across ALL tracked shots with lateral data:\n  // the share finishing right of the intended line (+ = right).\n  function missDirectionSummary() {\n    const log = loadShotLog();\n    const vals = [];\n    for (const k of Object.keys(log)) {\n      for (const e of (log[k] || []).map(normalizeShotEntry)) {\n        if (e && Number.isFinite(e.l)) vals.push(e.l);\n      }\n    }\n    if (!vals.length) return null;\n    const right = vals.filter((v) => v > 0).length;\n    return {\n      n: vals.length\x2C\n      right\x2C\n      rightPct: Math.round((right / vals.length) * 100)\x2C\n    };\n  }\n\n  // SIGNATURE PRESERVED: renderStats()\n  function renderStats() {\n    const s = summarizeRound(state.round);\n    els.statScore.textContent = s.played ? `${s.totalScore}` : '\u2014';\n    els.statPutts.textContent = s.puttRows ? `${s.totalPutts}` : '\u2014';\n    els.statFir.textContent = s.firRows ? `${Math.round(s.firCI.p * 100)}%` : '\u2014';\n    els.statGir.textContent = s.girRows ? `${Math.round(s.girCI.p * 100)}%` : '\u2014';\n\n    const avgScore = s.played ? s.totalScore / s.played : null;\n    const avgPutts = s.puttRows ? s.totalPutts / s.puttRows : null;\n    const pctCI = (ci) => ci && ci.n\n      ? `${ci.n ? `${Math.round(ci.p * 100)}%` : '\u2014'} (${Math.round(ci.lo * 100)}\u2013${Math.round(ci.hi * 100)}%\x2C n=${ci.n})`\n      : '\u2014';\n\n    // Hole count for labels/projections \u2014 matches the active course layout.\n    const roundLen = getCourseHoleCount();\n\n    const rows = [\n      ['Holes entered'\x2C `${s.played} / ${roundLen}`]\x2C   // v-fix(holes-18) v1.5.2 (audit #6)\n      ['Avg score / hole'\x2C avgScore === null ? '\u2014' : fmt(avgScore\x2C 2)]\x2C\n      ['Score SD / hole'\x2C s.scoreSd === null ? '\u2014' : fmt(s.scoreSd\x2C 2)]\x2C\n      [`Projected ${roundLen}`\x2C s.projected18 === null ? '\u2014'\n        : `${fmt(s.projected18\x2C 1)}${s.projected18Se ? ` \xb1 ${fmt(s.projected18Se\x2C 1)}` : ''}`]\x2C\n      ['Avg putts / hole'\x2C avgPutts === null ? '\u2014' : fmt(avgPutts\x2C 2)]\x2C\n      ['Putts when GIR'\x2C s.puttsOnGir === null ? '\u2014'\n        : `${fmt(s.puttsOnGir\x2C 2)} (Tour ${PUTTS_PAR_BASELINE})`]\x2C\n      ['Putts when missed'\x2C s.puttsOffGir === null ? '\u2014' : fmt(s.puttsOffGir\x2C 2)]\x2C\n      ['1-putts / 3-putts'\x2C s.puttRows ? `${s.onePutts} / ${s.threePutts}` : '\u2014']\x2C\n      ['Penalty strokes'\x2C String(s.totalPen || 0)]\x2C\n      ...([3\x2C 4\x2C 5]\n        .filter((p) => s.parSplits && s.parSplits[p] && s.parSplits[p].n)\n        .map((p) => [\n          `Avg score \xb7 Par ${p}`\x2C\n          `${fmt(s.parSplits[p].total / s.parSplits[p].n\x2C 2)} over ${s.parSplits[p].n\n          } hole${s.parSplits[p].n === 1 ? '' : 's'}`\x2C\n        ]))\x2C\n      [`Fairways (${Math.round(STATS_CONF * 100)}% CI)`\x2C pctCI(s.firCI)]\x2C\n      [`Greens (${Math.round(STATS_CONF * 100)}% CI)`\x2C pctCI(s.girCI)]\x2C\n      [\n        'Offline tendency'\x2C\n        (() => {\n          const m = missDirectionSummary();\n          return m\n            ? `${m.rightPct}% right of line \xb7 ${m.n} tracked shot${m.n === 1 ? '' : 's'}`\n            : '\u2014';\n        })()\x2C\n      ]\x2C\n    ];\n\n    const hist = state.history || [];\n    if (hist.length) {\n      // Recency-weighted history: an eight-round half-life keeps averages responsive.\n      const w = hist.map((_\x2C i) => Math.pow(0.5\x2C (hist.length - 1 - i) / HISTORY_HALFLIFE_ROUNDS));\n      const wAvg = (vals) => {\n        const pairs = vals.map((v\x2C i) => [v\x2C w[i]]).filter(([v]) => Number.isFinite(v));\n        if (!pairs.length) return null;\n        const sw = pairs.reduce((a\x2C [\x2C ww]) => a + ww\x2C 0);\n        return pairs.reduce((a\x2C [v\x2C ww]) => a + v * ww\x2C 0) / sw;\n      };\n      const scores = hist.map((h) => h.totalScore);\n      const putts = hist.map((h) => h.totalPutts);\n      const firPct = hist.map((h) => (h.firRows ? (100 * h.firMade) / h.firRows : NaN));\n      const girPct = hist.map((h) => (h.girRows ? (100 * h.girMade) / h.girRows : NaN));\n      const valid = scores.filter(Number.isFinite);\n      // Robust trend in score over rounds.\n      const idx = scores.map((_\x2C i) => i).filter((i) => Number.isFinite(scores[i]));\n      const ts = idx.length >= 4 ? theilSen(idx\x2C idx.map((i) => scores[i])) : null;\n\n      rows.push(['\u2014 History \u2014'\x2C `${hist.length} round${hist.length > 1 ? 's' : ''}`]);\n      rows.push(['Best score'\x2C valid.length ? Math.min(...valid) : '\u2014']);\n      rows.push(['Recent avg score'\x2C wAvg(scores) === null ? '\u2014' : fmt(wAvg(scores)\x2C 1)]);\n      rows.push(['Recent avg putts'\x2C wAvg(putts) === null ? '\u2014' : fmt(wAvg(putts)\x2C 1)]);\n      rows.push(['Recent avg FIR'\x2C wAvg(firPct) === null ? '\u2014' : `${fmt(wAvg(firPct))}%`]);\n      rows.push(['Recent avg GIR'\x2C wAvg(girPct) === null ? '\u2014' : `${fmt(wAvg(girPct))}%`]);\n      if (ts) rows.push(['Trend'\x2C `${ts.slope >= 0 ? '+' : ''}${fmt(ts.slope\x2C 2)} strokes / round`]);\n      const spark = sparklineRow(scores.slice(-15));\n      if (spark) rows.push(['Recent scores'\x2C spark]);\n    }\n    els.statsBreakdown.innerHTML = rows\n      .map(([k\x2C v]) =>\n        v && v.__raw\n          ? `<div class="break-row"><span>${escapeHtml(k)}</span><b>${v.html}</b></div>`\n          : `<div class="break-row"><span>${escapeHtml(k)}</span><b>${escapeHtml(v)}</b></div>`\n      )\n      .join('');\n  }\n\n  // Inline SVG trend line for recent scores. Lower-is-better golf scoring is\n  // inverted so an improving player watches the line CLIMB. Returns a raw-\n  // flagged object because it carries trusted\x2C self-generated markup.\n  function sparklineRow(values\x2C width = 116\x2C height = 26) {\n    const pts = (values || []).filter(Number.isFinite);\n    if (pts.length < 2) return null;\n    const min = Math.min(...pts);\n    const max = Math.max(...pts);\n    const span = max - min || 1;\n    const stepX = width / (pts.length - 1);\n    const yFor = (v) => height - 3 - ((max - v) / span) * (height - 6);\n    const coords = pts\n      .map((v\x2C i) => `${(i * stepX).toFixed(1)}\x2C${yFor(v).toFixed(1)}`)\n      .join(' ');\n    const parts = coords.split(' ');\n    const last = parts[parts.length - 1].split('\x2C');\n    const html =\n      `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" ` +\n      `style="vertical-align:-7px;margin-right:7px;color:var(--green)">` +\n      `<polyline points="${coords}" fill="none" stroke="currentColor" stroke-width="2" ` +\n      `stroke-linecap="round" stroke-linejoin="round"/>` +\n      `<circle cx="${last[0]}" cy="${last[1]}" r="2.8" fill="currentColor"/></svg>` +\n      `${min}\u2013${max}`;\n    return { __raw: true\x2C html };\n  }\n  // ============================================================\n  //  BLOCK 15 \u2014 RANGE PIPELINE\n  //  Replaces: calculateRange\x2C renderBreakdown\n  // ============================================================\n\n  // Sanity bound: a real golf target is never farther than this from the\n  // player. Anything beyond is a stale/fallback point (e.g. a caddy:lastTarget\n  // restored from a previous venue\x2C or a geocoded course centroid when\n  // scorecard mapping failed) \u2014 never compute yardage against it.\n  const MAX_SANE_TARGET_YD = 1200;\n\n  function calculateRange() {\n    const staleTargetYd =\n      state.loc && state.target\n        ? haversineMeters(state.loc\x2C state.target) * M_TO_YD\n        : null;\n    const targetInvalid =\n      !state.loc ||\n      !state.target ||\n      (staleTargetYd != null &&\n        (staleTargetYd <= 0 || staleTargetYd > MAX_SANE_TARGET_YD));\n    if (targetInvalid) {\n      if (state.target) {\n        // Drop the bogus target so it can't leak into GPS ticks or persist.\n        state.target = null;\n        try { localStorage.removeItem('caddy:lastTarget'); } catch { }\n      }\n      els.rawYards.textContent = '\u2014';\n      els.rawLabel.textContent = 'Map a target';\n      if (els.aimChip) els.aimChip.hidden = true;\n      if (els.bearingChip) els.bearingChip.hidden = true;\n      els.playsLikeYards.textContent = '\u2014';\n      els.playsLikeYards.classList.remove('pl-long'\x2C 'pl-short');\n      els.clubRecommendation.textContent = 'No valid target';\n      els.clubRecommendationSub.textContent =\n        'Course map unavailable \u2014 tap the green on the map for distances.';\n      renderCaddyTips([]);\n      updateAdvice([]\x2C 'neutral');\n      renderFcb();\n      clearDispersionZone();\n      tintTargetPin('neutral');\n      renderElevProfile({}\x2C els.rangeBreakdown);\n      return;\n    }\n    const w = getWeatherOrNeutral()\x2C e = getElevationOrNeutral();\n    const meanAltM = ((e.targetFt + e.userFt) / 2) * FT_TO_M;\n    const horizontalYd = haversineMeters(state.loc\x2C state.target\x2C meanAltM) * M_TO_YD;\n    const bearing = initialBearingDeg(state.loc\x2C state.target);\n\n    const calc = playsLike({\n      horizontalYd\x2C bearingDeg: bearing\x2C\n      elevDiffFt: e.targetFt - e.userFt\x2C\n      courseAltitudeFt: (e.targetFt + e.userFt) / 2\x2C\n      tempF: w.tempF\x2C rh: w.rh\x2C\n      windMph: w.windMph\x2C windFromDeg: w.windFromDeg\x2C\n      pressureHpa: w.pressureHpa\x2C gustMph: w.gustMph\x2C shearAlpha: w.shearAlpha\x2C\n      latDeg: state.loc.lat\x2C lieYd: 0\x2C\n    });\n    state.lastCalc = calc;\n    // Stamp the throttle reference so GPS ticks know this position is\n    // already covered (see the gate in onPosition).\n    state.lastCalcLoc = { lat: state.loc.lat\x2C lng: state.loc.lng };\n    state.lastCalcAt = Date.now();\n\n    els.rawYards.textContent = fmt(horizontalYd);\n    // Short\x2C static label \u2014 the aim and bearing chips carry the detail so\n    // the big number stays scannable at a glance.\n    els.rawLabel.textContent = 'actual yds';\n    if (els.bearingChip) {\n      if (els.bearingChipArrow) {\n        els.bearingChipArrow.style.transform = `rotate(${Math.round(bearing)}deg)`;\n      }\n      if (els.bearingChipText) {\n        els.bearingChipText.textContent = `${bearingToCompass(bearing)} \xb7 ${Math.round(bearing)}\xb0`;\n      }\n      els.bearingChip.hidden = false;\n    }\n    setAimChip();\n    els.playsLikeYards.textContent = fmt(calc.playsLikeYd);\n\n    // Condition tint on the plays-like tile: amber when the environment\n    // stretches the shot past the raw number\x2C blue when it shortens it \u2014\n    // readable at cart-distance without parsing either number.\n    if (horizontalYd >= 25) {\n      const plDeltaPct = (calc.playsLikeYd - horizontalYd) / horizontalYd;\n      els.playsLikeYards.classList.toggle('pl-long'\x2C plDeltaPct >= 0.03);\n      els.playsLikeYards.classList.toggle('pl-short'\x2C plDeltaPct <= -0.03);\n    } else {\n      els.playsLikeYards.classList.remove('pl-long'\x2C 'pl-short');\n    }\n\n    els.playsLikeYards.title = calc.extended\n      ? 'Approximate yardage beyond the calibrated carry range'\n      : '';\n\n    els.playsLikeYards.setAttribute(\n      'aria-label'\x2C\n      calc.extended\n        ? `${fmt(calc.playsLikeYd)} yards\x2C approximate`\n        : `${fmt(calc.playsLikeYd)} yards`\n    );\n    updateLine();\n    renderFcb();\n\n    const accYd = state.loc.accuracy ? state.loc.accuracy * M_TO_YD : 999;\n\n    if (horizontalYd <= 3) setNotice('Very close target \u2014 no full shot needed.'\x2C 'greenish');\n    else if (horizontalYd < 20) setNotice('Very close \u2014 chip or putt; no full swing.'\x2C 'greenish');\n    else if (state.locStale)\n      setNotice('Using last-known location (stale). Tap the GPS pill for a fresh fix.'\x2C 'danger');\n    else if (accYd > ACCURACY_WARN_YD)\n      setNotice(`GPS accuracy is \xb1${fmt(accYd)} yd (worse than ${ACCURACY_WARN_YD} yd). Yardage may be unreliable.`\x2C 'danger');\n    else if (calc.solverReached === false)\n      setNotice('Target sits above the ball flight apex for this distance \u2014 the number is extrapolated. Treat it as a minimum.'\x2C 'danger');\n    else if (e.blindFt > BLIND_CLEARANCE_FT)\n      setNotice(`Blind shot \u2014 terrain rises ~${Math.round(e.blindFt)} ft above your sight line. Pick a horizon aim point.`\x2C 'greenish');\n    else if (state.context.offlineWeather || state.context.offlineElevation)\n      setNotice('Using cached/offline weather or elevation where available. Neutral defaults fill any gaps.'\x2C 'greenish');\n    else\n      setNotice('Tap another point to move the target. Long-press the green (or Set Front/Back) for edge yardages.'\x2C 'greenish');\n\n    const geo = greenGeometry();\n    const hasGreen =\n      geo && (geo.front != null || geo.back != null || geo.center != null);\n\n    // FCB should influence strategy only when the selected pin is on the green.\n    // A target short of the green is a layup target and must retain its own yardage.\n    const useGreenStrategy = hasGreen && targetIsOnMarkedGreen(geo);\n\n    let rec;\n    let smart = null;\n    let smartTips = [];\n    let verdict = 'neutral';\n\n    if (useGreenStrategy) {\n      smart = recommendSmart(calc.playsLikeYd\x2C geo\x2C bearing\x2C accYd\x2C {\n        strokeIndex: getCurrentHoleData()?.strokeIndex || null\x2C\n      });\n\n      rec = {\n        main: smart.main\x2C\n        sub: smart.sub\x2C\n      };\n\n      smartTips = smart.tips;\n      verdict = smart.verdict;\n    } else {\n      // Target-only recommendation: selected pin always wins.\n      rec = recommendClub(calc.playsLikeYd);\n\n      // Still explain the green relationship in advice\x2C without changing club.\n      const greenContextTip = hasGreen ? targetToGreenTip() : null;\n      if (greenContextTip) smartTips.push(greenContextTip);\n    }\n\n    // Hazard awareness: imported bunkers/water projected onto THIS line.\n    hazardTips(calc.horizontalYd).forEach((t) => smartTips.push(t));\n\n    // Named-club layup coaching when the target is beyond the bag.\n    const longestClub = sortedClubsDesc()[0];\n    if (longestClub && calc.playsLikeYd > longestClub.yards * 1.08) {\n      const lay = smartLayupTip(geo);\n      if (lay) smartTips.push(lay);\n    }\n    // Use the optimizer's actual winning club when green strategy is active.\n    // Otherwise use the selected-target recommendation.\n    const recClub =\n      smart && smart.club\n        ? smart.club\n        : sortedClubsAsc().find((c) => c.yards >= calc.playsLikeYd) ||\n        sortedClubsDesc()[0];\n\n    state.lastRecClubId = recClub\n      ? recClub.id\n      : state.lastRecClubId;\n\n    // Standing on a fresh tee? Lead with the hole brief and tuck the club\n    // recommendation underneath it.\n    const brief = holeBrief();\n    const kickerEl = $('recKicker');\n    if (brief) {\n      rec = {\n        main: brief.main\x2C\n        sub: rec.main\n          ? `${brief.sub} \xb7 Suggested opener: ${rec.main}`\n          : brief.sub\x2C\n      };\n      if (kickerEl) kickerEl.textContent = brief.kicker;\n      verdict = 'neutral';\n    } else if (kickerEl) {\n      kickerEl.textContent = 'Recommended shot';\n    }\n\n    els.clubRecommendation.textContent = rec.main;\n    let sub = rec.sub;\n    if (calc.extended)\n      sub = 'Beyond calibrated carry \u2014 estimate for layup planning. ' + sub;\n    const g = selectedClubGuidance(calc.playsLikeYd);\n    if (g) sub += ' \xb7 ' + g;\n\n    // Gust-aware club range: when gusts materially exceed the sustained\n    // number\x2C the honest recommendation is a RANGE\x2C not one club.\n    let gustRangeTxt = '';\n    if (\n      Number.isFinite(w.gustMph) &&\n      w.windMph >= 5 &&\n      w.gustMph > w.windMph + 4 &&\n      calc.gustYd >= 4\n    ) {\n      const ascAll = sortedClubsAsc();\n      const pick = (yd) => {\n        const hit = ascAll.find((c) => c.yards >= yd);\n        return hit ? hit.name : null;\n      };\n      const loName = pick(Math.max(20\x2C calc.playsLikeYd - calc.gustYd));\n      const hiName = pick(calc.playsLikeYd + calc.gustYd);\n      if (loName && hiName && loName !== hiName)\n        gustRangeTxt = ` Gusts to ${Math.round(\n          w.gustMph\n        )} mph: anywhere from ${loName} to ${hiName} depending on timing.`;\n      else if (loName)\n        gustRangeTxt = ` Gusts to ${Math.round(\n          w.gustMph\n        )} mph \u2014 take the ${loName} and swing easy; timing is worth \xb1${Math.round(\n          calc.gustYd\n        )} yd.`;\n    }\n\n    els.clubRecommendationSub.textContent = sub + gustRangeTxt;\n    setVerdict(verdict);\n    renderShotPlan({\n      calc\x2C\n      wind: windRelative(w.windFromDeg\x2C bearing\x2C w.windMph)\x2C\n      elevation: e\x2C\n      accuracyYd: accYd\x2C\n      smart\x2C\n      verdict\x2C\n    });\n\n    // Front / Middle / Back club trio \u2014 deep greens solved at a glance.\n    // Yardages are converted to the plays-like scale before picking clubs so\n    // the trio agrees with the headline recommendation in the same wind.\n    if (\n      els.shotPlanChips &&\n      geo &&\n      Number.isFinite(geo.front) &&\n      Number.isFinite(geo.center) &&\n      Number.isFinite(geo.back)\n    ) {\n      const scale =\n        horizontalYd > 0 ? calc.playsLikeYd / horizontalYd : 1;\n      const clubFor = (yd) => {\n        const hit = sortedClubsAsc().find((c) => c.yards >= yd * scale);\n        return hit ? hit.name : null;\n      };\n      const trio = [\n        ['F'\x2C clubFor(geo.front)]\x2C\n        ['M'\x2C clubFor(geo.center)]\x2C\n        ['B'\x2C clubFor(geo.back)]\x2C\n      ];\n      if (trio.every(([\x2C n]) => n)) {\n        els.shotPlanChips.insertAdjacentHTML(\n          'beforeend'\x2C\n          trio\n            .map(\n              ([k\x2C n]) =>\n                `<span class="rec-chip">${k}&nbsp;<b style="font-weight:900">${escapeHtml(\n                  n\n                )}</b></span>`\n            )\n            .join('')\n        );\n      }\n    }\n    const ascC = sortedClubsAsc();\n    const longerC = ascC.find((c) => c.yards >= calc.playsLikeYd);\n    const longestC = sortedClubsDesc()[0];\n    const wr = windRelative(w.windFromDeg\x2C bearing\x2C w.windMph);\n    const baseTips = caddyTips({\n      plays: calc.playsLikeYd\x2C\n      along: wr.along\x2C cross: wr.cross\x2C\n      elevFt: calc.elevDiffFt\x2C\n      gap: longerC ? longerC.yards - calc.playsLikeYd : null\x2C\n      longerName: longerC ? longerC.name : ''\x2C\n      beyondLongest: longestC && calc.playsLikeYd > longestC.yards * 1.08\x2C\n      accYd\x2C\n      // new context consumed by the upgraded tip engine\n      aimYd: calc.aimYd\x2C aimDeg: calc.aimDeg\x2C gustYd: calc.gustYd\x2C\n      windAdjYd: calc.windAdjYd\x2C elevAdjYd: calc.elevAdjYd\x2C\n      tempAdjYd: calc.tempAdjYd\x2C altitudeAdjYd: calc.altitudeAdjYd\x2C\n      densityRatio: calc.densityRatio\x2C apexFt: calc.apexFt\x2C\n      descentDeg: calc.descentDeg\x2C blindFt: e.blindFt\x2C\n      lateralBiasYd: recClub ? clubLateralBiasYd(recClub.id) : null\x2C\n      biasClubName: recClub ? recClub.name : ''\x2C\n    }\x2C 3);\n\n    if (state.prefs.mode === 'range') {\n      const cTips = coachTips({ clubCount: Object.keys(loadShotLog()).length });\n      renderCaddyTips([]);\n      updateAdvice(cTips\x2C 'neutral'\x2C { main: rec.main\x2C sub: rec.sub\x2C plays: calc.playsLikeYd });\n    } else {\n      // `smartTips` contains either true green-strategy advice or the\n      // selected-target-versus-green explanation for an intentional layup.\n      const tips = [...smartTips\x2C ...baseTips]\n        .filter(Boolean)\n        .slice(0\x2C 4);\n\n      // Tips live in the map popover.\n      renderCaddyTips([]);\n\n      updateAdvice(tips\x2C verdict\x2C {\n        main: rec.main\x2C\n        sub: els.shotAction?.textContent || rec.sub\x2C\n        plays: calc.playsLikeYd\x2C\n      });\n    }\n\n    renderBreakdown(calc\x2C els.rangeBreakdown);\n    renderElevProfile(e\x2C els.rangeBreakdown);\n    els.rangeStamp.textContent = stampText();\n    renderClubChips(calc.playsLikeYd);\n\n    // Pin tint + landing spread for the recommended club (verdict-aware).\n    tintTargetPin(useGreenStrategy ? verdict : 'neutral');\n    renderDispersionZone(bearing\x2C recClub);\n  }\n\n  // SIGNATURE PRESERVED: renderBreakdown(calc\x2C el)\n  function renderBreakdown(calc\x2C el) {\n    if (!calc || !el) return;\n    const sgn = (v\x2C d = 1) => `${v >= 0 ? '+' : ''}${fmt(v\x2C d)}`;\n    const windKind = calc.headwindMph >= 0 ? 'head' : 'tail';\n    const rows = [\n      ['Horizontal (WGS-84 geodesic)'\x2C `${fmt(calc.horizontalYd\x2C 1)} yd`]\x2C\n      ['Bearing'\x2C `${bearingToCompass(calc.bearingDeg\x2C 32)} (${fmt(calc.bearingDeg\x2C 1)}\xb0)`]\x2C\n      ['Elevation'\x2C `${sgn(calc.elevAdjYd)} yd (${sgn(calc.elevDiffFt\x2C 0)} ft)`]\x2C\n      [`Wind (${windKind})`\x2C\n      `${sgn(calc.windAdjYd)} yd (${fmt(Math.abs(calc.headwindMph)\x2C 1)} mph ${windKind}\x2C from ${bearingToCompass(calc.windFromDeg)})`]\x2C\n      ['Crosswind aim'\x2C\n        Math.abs(calc.crosswindMph) < PHYSICS.MIN_CROSSWIND_MPH\n          ? 'minimal'\n          : `${fmt(Math.abs(calc.crosswindMph)\x2C 1)} mph \u2014 ${calc.crossFrom} ${Math.abs(calc.aimYd)} yd (${fmt(Math.abs(calc.aimDeg)\x2C 1)}\xb0)`]\x2C\n      ['Temperature'\x2C `${sgn(calc.tempAdjYd)} yd (${fmt(calc.tempF)}\xb0F)`]\x2C\n      ['Altitude'\x2C `${sgn(calc.altitudeAdjYd)} yd (${fmt(calc.courseAltitudeFt)} ft)`]\x2C\n      ['Humidity'\x2C `${sgn(calc.humidityAdjYd\x2C 2)} yd (${fmt(calc.rh)}% RH)`]\x2C\n      ['Air density'\x2C `${fmt(calc.rhoKgM3\x2C 4)} kg/m\xb3 \xb7 ${fmt(calc.densityRatio * 100\x2C 1)}% of standard`]\x2C\n      ['Lie'\x2C `${sgn(calc.lieYd)} yd (neutral)`]\x2C\n      ['Plays-like'\x2C `${fmt(calc.playsLikeYd)} yd`]\x2C\n    ];\n    if (Number.isFinite(calc.apexFt))\n      rows.push(['Apex / flight'\x2C `${fmt(calc.apexFt)} ft \xb7 ${fmt(calc.flightTimeS\x2C 2)} s`]);\n    if (Number.isFinite(calc.descentDeg))\n      rows.push(['Descent / landing'\x2C `${fmt(calc.descentDeg\x2C 1)}\xb0 at ${fmt(calc.landSpeedMph)} mph`]);\n    if (calc.rolloutYd > 0)\n      rows.push(['Est. rollout'\x2C `${fmt(calc.rolloutYd\x2C 1)} yd (medium turf)`]);\n    if (calc.gustYd > 0)\n      rows.push(['Gust exposure'\x2C `\xb1${fmt(calc.gustYd\x2C 1)} yd`]);\n    if (calc.extended)\n      rows.push(['Carry range'\x2C 'beyond calibrated \u2014 estimate only']);\n    el.innerHTML = rows\n      .map(([k\x2C v]) => `<div class="break-row"><span>${escapeHtml(k)}</span><b>${escapeHtml(v)}</b></div>`)\n      .join('');\n  }\n\n  // Mini terrain profile along the CURRENT shot line (Pro Mode breakdown).\n  // Consumes the 9-point open-meteo profile that was fetched but never shown.\n  function renderElevProfile(e\x2C el) {\n    if (!el) return;\n    const old = document.getElementById('elevProfileChart');\n    if (old) old.remove();\n    const prof = Array.isArray(e.profileFt) ? e.profileFt : null;\n    if (!prof || prof.length < 3) return;\n\n    const W = 240\x2C H = 46;\n    const min = Math.min(...prof);\n    const max = Math.max(...prof);\n    const span = max - min || 1;\n    const stepX = W / (prof.length - 1);\n    const coords = prof\n      .map(\n        (v\x2C i) =>\n          `${(i * stepX).toFixed(1)}\x2C${(\n            H - 4 -\n            ((v - min) / span) * (H - 10)\n          ).toFixed(1)}`\n      )\n      .join(' ');\n    const diff = prof[prof.length - 1] - prof[0];\n    const blindTxt =\n      Number.isFinite(e.blindFt) && e.blindFt > BLIND_CLEARANCE_FT\n        ? ` \xb7 blind +${Math.round(e.blindFt)} ft`\n        : '';\n\n    const wrap = document.createElement('div');\n    wrap.id = 'elevProfileChart';\n    wrap.innerHTML =\n      `<div class="break-row" style="border-bottom:0"><span>Terrain profile</span>` +\n      `<b>${diff >= 0 ? '+' : ''}${Math.round(diff)} ft${blindTxt}</b></div>` +\n      `<svg width="100%" height="${H}" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" ` +\n      `style="color:var(--green);background:rgba(15\x2C122\x2C67\x2C.06);border-radius:10px;display:block">` +\n      `<polyline points="${coords}" fill="none" stroke="currentColor" stroke-width="2" ` +\n      `stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>`;\n    el.appendChild(wrap);\n  }\n  // ============================================================\n  //  BLOCK 16 \u2014 MANUAL CALCULATOR\n  //  Replaces: initManualCalc (entire function)\n  // ============================================================\n\n  function initManualCalc() {\n    // v1.7.1: the manual plays-like calculator was REMOVED from Prep per\n    // James (the Prep studio + hole flow covers it). Guard: without the\n    // markup\x2C this becomes a no-op instead of crashing boot.\n    if (!els.manualCalcBtn || !els.prefillBtn || !els.manualYards) return;\n    els.prefillBtn.addEventListener('click'\x2C () => {\n      const w = getWeatherOrNeutral()\x2C\n        e = getElevationOrNeutral();\n      if (state.loc && state.target) {\n        els.manualYards.value = Math.round(\n          haversineMeters(state.loc\x2C state.target) * M_TO_YD\n        );\n        els.manualBearing.value = Math.round(\n          initialBearingDeg(state.loc\x2C state.target)\n        );\n        els.manualElevDiff.value = Math.round(e.targetFt - e.userFt);\n        els.manualAltitude.value = Math.round((e.targetFt + e.userFt) / 2);\n      }\n      if (state.context.weather) {\n        els.manualTemp.value = Math.round(w.tempF);\n        els.manualRh.value = Math.round(w.rh);\n        els.manualWindSpeed.value = Math.round(w.windMph);\n        els.manualWindDir.value = Math.round(w.windFromDeg);\n      }\n    });\n\n    els.manualCalcBtn.addEventListener('click'\x2C () => {\n      const horizontalYd = num(els.manualYards.value\x2C NaN);\n      if (!Number.isFinite(horizontalYd) || horizontalYd < 0) {\n        alert('Enter horizontal yards.');\n        return;\n      }\n      // Pull live barometer / wind-shear / latitude when available. These are not\n      // exposed as manual inputs\x2C but passing them keeps the manual calculator on\n      // the same physics as the map. All three degrade safely to NaN defaults.\n      const w = getWeatherOrNeutral();\n      const calc = playsLike({\n        horizontalYd\x2C\n        bearingDeg: num(els.manualBearing.value\x2C 0)\x2C\n        elevDiffFt: num(els.manualElevDiff.value\x2C 0)\x2C\n        courseAltitudeFt: num(els.manualAltitude.value\x2C 0)\x2C\n        tempF: num(els.manualTemp.value\x2C STD_TEMP_F)\x2C\n        rh: num(els.manualRh.value\x2C STD_RH)\x2C\n        windMph: num(els.manualWindSpeed.value\x2C 0)\x2C\n        windFromDeg: num(els.manualWindDir.value\x2C 0)\x2C\n        pressureHpa: w.pressureHpa\x2C\n        shearAlpha: w.shearAlpha\x2C\n        latDeg: state.loc ? state.loc.lat : STD_LAT\x2C\n        lieYd: 0\x2C\n      });\n      const rec = recommendClub(calc.playsLikeYd);\n      els.manualRec.textContent = `${fmt(calc.playsLikeYd)} yd \xb7 ${rec.main}`;\n      let sub = rec.sub;\n      const g = selectedClubGuidance(calc.playsLikeYd);\n      if (g) sub += ' \xb7 ' + g;\n      // aimYd is SIGNED (+ = aim right). The old `calc.aimYd > 0` test silently\n      // dropped this line for every right-to-left crosswind.\n      if (Math.abs(calc.aimYd) > 0)\n        sub += ` \xb7 Crosswind ${fmt(Math.abs(calc.crosswindMph)\x2C 1)} mph \u2014 aim ${Math.abs(calc.aimYd)\n          } yd ${calc.aimYd > 0 ? 'right' : 'left'} (${fmt(\n            Math.abs(calc.aimDeg)\x2C\n            1\n          )}\xb0).`;\n      els.manualRecSub.textContent = sub;\n      renderBreakdown(calc\x2C els.manualBreakdown);\n    });\n  }\n  // ============================================================\n  //  BLOCK 16a \u2014 COURSE NAME SEARCH (round setup)\n  //  Case-insensitive substring match on golf-course names within a fixed\n  //  radius of the last known location. Feeds the SAME select-and-import\n  //  pipeline as the nearby list\x2C so scorecard fetching is identical.\n  // ============================================================\n\n  // Escape a user string for safe embedding in an Overpass QL regex\n  // literal: QL string-quoting first (backslash\x2C quote)\x2C then regex\n  // metacharacters. Prevents both query breakage and regex injection.\n  function osmEscapeQueryString(s) {\n    return String(s)\n      .replace(/\\\\\\\\/g\x2C '\\\\\\\\\\\\\\\\')\n      .replace(/"/g\x2C '\\\\"')\n      .replace(/([.*+?^${}()\\[\\]])/g\x2C '\\\\$1');\n  }\n\n  // Free-text course lookup via Photon (komoot's OSM geocoder). Returns the\n  // same {id\x2C osmType\x2C osmId\x2C name\x2C lat\x2C lng\x2C source} shape the Overpass\n  // path produces\x2C so both feed the shared select-and-import pipeline.\n  // Bias toward the player's location\x2C but don't hard-reject distant\n  // matches \u2014 a typed name is intent.\n  async function photonCourseSearch(term\x2C loc) {\n    const params = new URLSearchParams({\n      q: term\x2C\n      limit: String(COURSE_SEARCH_MAX_RESULTS * 2)\x2C\n      lang: 'en'\x2C\n      // Ask Photon to pre-filter to golf courses; the client-side kind\n      // check below stays as a safety net.\n      osm_tag: 'leisure:golf_course'\x2C\n    });\n    if (loc) {\n      params.set('lat'\x2C loc.lat.toFixed(5));\n      params.set('lon'\x2C loc.lng.toFixed(5));\n    }\n\n    const ctrl = new AbortController();\n    const timer = setTimeout(() => ctrl.abort()\x2C 8000);\n    try {\n      const res = await fetch(`${PHOTON_GEOCODER_URL}?${params}`\x2C {\n        signal: ctrl.signal\x2C\n        cache: 'no-store'\x2C\n      });\n      if (!res.ok) throw new Error('HTTP ' + res.status);\n      const json = await res.json();\n      const features = Array.isArray(json.features) ? json.features : [];\n      const seen = new Set();\n      return features\n        .map((f) => {\n          const p = f.properties || {};\n          const c = f.geometry && f.geometry.coordinates;\n          const name = String(p.name || '').trim();\n          const kind = `${p.osm_key}:${p.osm_value}`;\n          if (\n            !name ||\n            !Array.isArray(c) ||\n            !Number.isFinite(Number(c[0])) ||\n            !Number.isFinite(Number(c[1])) ||\n            !/golf|sport|^leisure:(pitch|track)$/.test(kind)\n          ) {\n            return null;\n          }\n          return {\n            id: `osm:${p.osm_type || 'n'}:${p.osm_id}`\x2C\n            osmType: p.osm_type || null\x2C\n            osmId: Number(p.osm_id)\x2C\n            name\x2C\n            lat: Number(c[1])\x2C\n            lng: Number(c[0])\x2C\n            source: 'openstreetmap'\x2C\n          };\n        })\n        .filter(Boolean)\n        .filter((course) => {\n          const key = `${course.name.toLowerCase()}|${course.lat.toFixed(4)}|${course.lng.toFixed(4)}`;\n          if (seen.has(key)) return false;\n          seen.add(key);\n          return true;\n        })\n        .sort(\n          (a\x2C b) =>\n            haversineMeters(loc || { lat: 0\x2C lng: 0 }\x2C a) -\n            haversineMeters(loc || { lat: 0\x2C lng: 0 }\x2C b)\n        )\n        .slice(0\x2C COURSE_SEARCH_MAX_RESULTS);\n    } finally {\n      clearTimeout(timer);\n    }\n  }\n\n  function renderCourseSearchResults() {\n    if (!els.nearbyCourseList || !els.nearbyCourseStatus) return;\n\n    if (state.courseSearchLoading) {\n      const q = els.courseSearchInput\n        ? els.courseSearchInput.value.trim()\n        : '';\n      els.nearbyCourseStatus.textContent = `Searching courses named \u201c${q}\u201d\u2026`;\n      els.nearbyCourseList.innerHTML = '';\n      return;\n    }\n\n    const results = Array.isArray(state.courseSearchResults)\n      ? state.courseSearchResults\n      : [];\n\n    if (!results.length) {\n      els.nearbyCourseStatus.textContent =\n        state.courseSearchError ||\n        `No matches within ${Math.round(COURSE_SEARCH_RADIUS_M / 1000)} km.`;\n      els.nearbyCourseList.innerHTML = state.courseSearchError\n        ? '<button class="ghost-btn" id="courseSearchRetryBtn" type="button">Try again</button>'\n        : '';\n      const retryBtn = document.getElementById('courseSearchRetryBtn');\n      if (retryBtn) {\n        retryBtn.addEventListener('click'\x2C () => {\n          state.courseSearchError = null;\n          runCourseSearch();\n        });\n      }\n      return;\n    }\n\n    const sel = state.selectedNearbyCourse;\n    if (\n      sel &&\n      results.some((c) => c.id === sel.id) &&\n      state.nearbyCourseLoadingScorecard\n    ) {\n      // v1.0.70 premium loader card (shared with the map pill).\n      if (!renderNearbyScorecardLoader(els.nearbyCourseStatus)) {\n        els.nearbyCourseStatus.textContent =\n          'Course selected \u2014 loading mapped scorecard data\u2026';\n      }\n    } else {\n      maploadStopPhases('nearby');\n      els.nearbyCourseStatus.textContent = `${results.length} match${results.length === 1 ? '' : 'es'\n        } \u2014 tap one to load its scorecard.`;\n    }\n\n    els.nearbyCourseList.innerHTML = results\n      .map((course\x2C index) => courseButtonHtml(course\x2C index))\n      .join('');\n\n    els.nearbyCourseList\n      .querySelectorAll('.nearby-course-option')\n      .forEach((button) => {\n        button.addEventListener('click'\x2C () => {\n          const course =\n            state.courseSearchResults[Number(button.dataset.index)];\n          if (course) selectNearbyCourse(course);\n        });\n      });\n  }\n\n  // Shared free-text course lookup: Photon geocoder first (sub-second)\x2C\n  // Overpass regex lookup as automatic fallback when Photon comes back\n  // empty or fails. Used by BOTH the round-setup nearby list and the Prep\n  // course picker\x2C so there is exactly one network code path.\n  async function courseNameSearch(term\x2C loc) {\n    const { lat\x2C lng } = loc;\n    const cacheKey =\n      OSM_CACHE_PREFIX +\n      `search:${COURSE_SEARCH_RADIUS_M}:${lat.toFixed(2)}\x2C${lng.toFixed(\n        2\n      )}:${term.toLowerCase()}`;\n    const pat = osmEscapeQueryString(term);\n    const query = `\n    [out:json][timeout:20];\n    (\n      nwr["leisure"="golf_course"]["name"~"${pat}"\x2Ci](around:${COURSE_SEARCH_RADIUS_M}\x2C${lat}\x2C${lng});\n      nwr["golf"="course"]["name"~"${pat}"\x2Ci](around:${COURSE_SEARCH_RADIUS_M}\x2C${lat}\x2C${lng});\n    );\n    out center tags ${COURSE_SEARCH_FETCH_LIMIT};\n  `;\n\n    let results = [];\n    try {\n      results = await photonCourseSearch(term\x2C loc);\n    } catch (photonError) {\n      console.warn('Photon search failed\x2C falling back to Overpass:'\x2C photonError);\n    }\n\n    if (!results.length) {\n      const data = await overpassFetch(query\x2C {\n        timeoutMs: 12000\x2C\n        cacheKey\x2C\n        cacheTtlMs: COURSE_SEARCH_TTL_MS\x2C\n      });\n\n      const seen = new Set();\n      results = (Array.isArray(data) ? data : [])\n        .map((item) => {\n          const name = String(item.tags?.name || '').trim();\n          const point = item.center || item;\n\n          if (\n            !name ||\n            !Number.isFinite(Number(point.lat)) ||\n            !Number.isFinite(Number(point.lon))\n          ) {\n            return null;\n          }\n\n          return {\n            id: `osm:${item.type}:${item.id}`\x2C\n            osmType: item.type\x2C\n            osmId: Number(item.id)\x2C\n            name\x2C\n            lat: Number(point.lat)\x2C\n            lng: Number(point.lon)\x2C\n            source: 'openstreetmap'\x2C\n          };\n        })\n        .filter(Boolean)\n        .filter((course) => {\n          const key = `${course.name.toLowerCase()}|${course.lat.toFixed(\n            4\n          )}|${course.lng.toFixed(4)}`;\n          if (seen.has(key)) return false;\n          seen.add(key);\n          return true;\n        })\n        .sort(\n          (a\x2C b) =>\n            haversineMeters(loc\x2C a) - haversineMeters(loc\x2C b)\n        )\n        .slice(0\x2C COURSE_SEARCH_MAX_RESULTS);\n    }\n\n    return results;\n  }\n\n  async function runCourseSearch() {\n    if (!els.courseSearchInput) return;\n    const term = els.courseSearchInput.value.trim();\n\n    // Below minimum length: exit search mode and restore the nearby view.\n    if (term.length < COURSE_SEARCH_MIN_CHARS) {\n      state.courseSearchActive = false;\n      state.courseSearchLoading = false;\n      state.courseSearchError = null;\n      state.courseSearchResults = [];\n      state._courseSearchSeq++;\n      renderNearbyCourses();\n      return;\n    }\n\n    state.courseSearchActive = true;\n    const mySeq = ++state._courseSearchSeq;\n\n    if (!state.loc) {\n      state.courseSearchLoading = false;\n      state.courseSearchError = null;\n      state.courseSearchResults = [];\n      renderCourseSearchResults(); // prints the needs-location message\n      return;\n    }\n\n    state.courseSearchLoading = true;\n    state.courseSearchError = null;\n    renderCourseSearchResults();\n\n    try {\n      const results = await courseNameSearch(term\x2C state.loc);\n\n      // Drop the answer if the query it belongs to is no longer current.\n      if (mySeq !== state._courseSearchSeq) return;\n      state.courseSearchResults = results;\n      state.courseSearchError = null;\n    } catch (error) {\n      console.warn('Course name search failed:'\x2C error);\n      if (mySeq !== state._courseSearchSeq) return;\n      state.courseSearchResults = [];\n      state.courseSearchError =\n        error && error.name === 'AbortError'\n          ? 'Search is taking too long right now.'\n          : 'Name search is unavailable right now.';\n    } finally {\n      if (mySeq === state._courseSearchSeq) {\n        state.courseSearchLoading = false;\n        if (state.courseSearchActive) renderCourseSearchResults();\n      }\n    }\n  }\n  // ============================================================\n  //  BLOCK 16b \u2014 HOLE PLANNER (prep mode)\n  //  Study any saved course offline: hole list + a written plan per hole.\n  //  Reads ONLY stored course geometry \u2014 no network\x2C no GPS required\x2C so\n  //  it works the night before at home.\n  // ============================================================\n\n  const PLAN_MAX_SEQ_CLUBS = 4;\n\n  // Ephemeral prep course: a course found via name search that is mapped\n  // for planning but NOT saved. Lives only for this session \u2014 the save\n  // bar promotes it into state.courseProfiles via saveCourseProfile.\n  let prepEphemeralCourse = null;\n  const PREP_EPHEMERAL_ID = '@prep-search';\n\n  // Courses available to the planner: an ephemeral searched course first\x2C\n  // then the active round's course\x2C then every saved profile.\n  function planCourseOptions() {\n    const opts = [];\n    if (prepEphemeralCourse) {\n      opts.push({\n        id: PREP_EPHEMERAL_ID\x2C\n        name: `${prepEphemeralCourse.name} \xb7 not saved`\x2C\n        course: prepEphemeralCourse\x2C\n      });\n    }\n    const active = state.roundSession ? getCurrentCourse() : null;\n    if (active) {\n      opts.push({\n        id: '@active'\x2C\n        name: `${active.name} \xb7 active round`\x2C\n        course: active\x2C\n      });\n    }\n    for (const c of state.courseProfiles || []) {\n      opts.push({\n        id: c.id\x2C\n        name: `${c.name} \xb7 ${teeDisplayName(c.teeName)}`\x2C\n        course: normalizeCourse(c)\x2C\n      });\n    }\n    return opts;\n  }\n\n  function getPlannerCourse() {\n    const id = state.planCourseId;\n    if (!id) return null;\n    const hit = planCourseOptions().find((o) => o.id === id);\n    return hit ? hit.course : null;\n  }\n\n  // Yardage resolution: imported tee-set number wins; otherwise compute\n  // tee\u2192green-center geometry. Returns a rounded number or null.\n  function planHoleYardage(hole) {\n    const typed = Number(hole.yards);\n    if (Number.isFinite(typed) && typed > 0) return Math.round(typed);\n    if (hole.teePoint && hole.greenCenter) {\n      const yd = haversineMeters(hole.teePoint\x2C hole.greenCenter) * M_TO_YD;\n      if (yd > 40 && yd < 900) return Math.round(yd);\n    }\n    return null;\n  }\n\n  function renderPlanner() {\n    if (!els.planCourseSelect) return;\n    const opts = planCourseOptions();\n    const prev = state.planCourseId || '';\n    els.planCourseSelect.innerHTML =\n      `<option value="">Choose a course\u2026</option>` +\n      opts\n        .map(\n          (o) =>\n            `<option value="${escapeHtml(o.id)}">${escapeHtml(o.name)}</option>`\n        )\n        .join('');\n    if (prev && opts.some((o) => o.id === prev)) {\n      els.planCourseSelect.value = prev;\n      renderPlannerCourse();\n    } else {\n      state.planCourseId = '';\n      if (els.planCourseCard) els.planCourseCard.hidden = true;\n    }\n  }\n\n  function renderPlannerCourse() {\n    const course = getPlannerCourse();\n    // The "not saved" bar only ever shows for an ephemeral searched course.\n    const ephemeralActive =\n      state.planCourseId === PREP_EPHEMERAL_ID && !!prepEphemeralCourse;\n    if (els.planSaveBar) els.planSaveBar.hidden = !ephemeralActive;\n    if (!course || !els.planCourseCard) {\n      if (els.planCourseCard) els.planCourseCard.hidden = true;\n      return;\n    }\n    els.planCourseCard.hidden = false;\n\n    const n = Number(course.holesCount) === 9 ? 9 : 18;\n    const mapped = (course.holes || []).filter(\n      (h) => h.source === 'openstreetmap'\n    ).length;\n\n    if (els.planCourseChip)\n      els.planCourseChip.textContent = `${n} holes`;\n    els.planCourseName.textContent = course.name || 'Course';\n    els.planCourseMeta.textContent = [\n      course.teeName || null\x2C\n      mapped ? `${mapped}/${n} mapped` : 'manual'\x2C\n    ]\n      .filter(Boolean)\n      .join(' \xb7 ');\n\n    els.planHoleList.innerHTML = (course.holes || [])\n      .slice(0\x2C n)\n      .map((h) => {\n        const yd = planHoleYardage(h);\n        const par = h.par || inferParFromYards(yd);\n        const haz = Array.isArray(h.hazards) ? h.hazards.length : 0;\n        const line = [\n          par ? `Par ${par}` : 'Par \u2014'\x2C\n          yd ? `${Math.round(yd)} yd` : null\x2C\n          h.strokeIndex ? `SI ${h.strokeIndex}` : null\x2C\n        ]\n          .filter(Boolean)\n          .join(' \xb7 ');\n        return `\n          <button class="plan-hole-row" type="button" data-hole="${h.number}">\n            <span class="plan-hole-num">${h.number}</span>\n            <span class="plan-hole-info">\n              <span class="plan-hole-line">${escapeHtml(line)}</span>\n              ${haz\n            ? `<span class="plan-hole-sub">${haz} hazard${haz === 1 ? '' : 's'\n            } marked</span>`\n            : ''\n          }\n            </span>\n            <span class="plan-hole-go">\u203a</span>\n          </button>`;\n      })\n      .join('');\n\n    els.planHoleList\n      .querySelectorAll('.plan-hole-row')\n      .forEach((btn) => {\n        btn.addEventListener('click'\x2C () =>\n          openHolePlan(Number(btn.dataset.hole))\n        );\n      });\n\n    // A stale detail card from a previous course selection is misleading \u2014\n    // collapse it whenever the course changes underneath.\n    if (els.planDetailCard) els.planDetailCard.hidden = true;\n  }\n\n  // Greedy club sequence from the long end of the bag\x2C mirroring the\n  // on-course hole-brief logic\x2C with an explicit finishing club.\n  function planClubSequence(totalYd) {\n    const yd = num(totalYd\x2C 0);\n    if (!(yd > 0)) return null;\n    const desc = sortedClubsDesc();\n    const asc = sortedClubsAsc();\n    if (!desc.length) return null;\n\n    const seq = [];\n    let remain = yd;\n    for (const c of desc) {\n      if (remain <= c.yards * 1.08) break;\n      if (seq.length >= PLAN_MAX_SEQ_CLUBS) break;\n      seq.push(c.name);\n      remain -= c.yards;\n      if (remain <= 30) break;\n    }\n\n    // Shorter than the bag: express as a percentage of the shortest club.\n    if (!seq.length) {\n      const s = asc[0];\n      if (s && s.yards > 0 && yd < s.yards * 0.95) {\n        const pct = clamp(Math.round((yd / s.yards) * 100)\x2C 20\x2C 95);\n        return { seq: []\x2C finisherName: `${s.name} \xb7 ${pct}% swing` };\n      }\n    }\n\n    const finisher = sortedClubsAsc().find(\n      (c) => c.yards >= Math.max(20\x2C remain)\n    );\n    const finisherName = finisher\n      ? finisher.name\n      : `${Math.round(Math.max(0\x2C remain))} yd partial`;\n    return { seq\x2C finisherName };\n  }\n\n  // Project stored hazards onto THIS hole's tee\u2192green line so the plan can\n  // say "water right\x2C ~180 yd out" instead of raw coordinates.\n  function planHazardsFor(hole) {\n    const list = Array.isArray(hole.hazards) ? hole.hazards : [];\n    const tee = hole.teePoint;\n    const green = hole.greenCenter;\n    return list.map((h) => {\n      const kind =\n        h.type === 'water'\n          ? 'Water'\n          : h.type === 'bunker'\n            ? 'Bunker'\n            : 'Hazard';\n      let sub = '';\n      if (\n        tee &&\n        green &&\n        h &&\n        Number.isFinite(h.lat) &&\n        Number.isFinite(h.lng)\n      ) {\n        const along = alongTrackYd(tee\x2C green\x2C h);\n        const cross = crossTrackYd(tee\x2C green\x2C h);\n        const side =\n          Math.abs(cross) < 8\n            ? 'on the line'\n            : cross > 0\n              ? 'right'\n              : 'left';\n        sub = `${side}\x2C ~${Math.max(0\x2C Math.round(along))} yd off the tee`;\n      }\n      return { type: h.type\x2C label: kind\x2C sub };\n    });\n  }\n\n  function planGreenInfo(hole) {\n    const tee = hole.teePoint;\n    if (!tee) return null;\n    const dist = (p) =>\n      p && Number.isFinite(p.lat)\n        ? Math.round(haversineMeters(tee\x2C p) * M_TO_YD)\n        : null;\n    const front = dist(hole.front);\n    const center = dist(hole.greenCenter);\n    const back = dist(hole.back);\n    const depth =\n      front != null && back != null ? Math.abs(back - front) : null;\n    return { front\x2C center\x2C back\x2C depth };\n  }\n\n  function planStrategy(depth\x2C par\x2C yd) {\n    const bits = [];\n    if (depth != null) {\n      if (depth >= 26)\n        bits.push(\n          `Deep green (~${Math.round(depth)} yd of room) \u2014 space to be aggressive; fire at the number.`\n        );\n      else if (depth <= 14)\n        bits.push(\n          `Shallow green (~${Math.round(depth)} yd) \u2014 distance control decides this hole\x2C not line. Favour the middle.`\n        );\n      else\n        bits.push(\n          `Green depth ~${Math.round(depth)} yd \u2014 a standard target.`\n        );\n    } else {\n      bits.push('Green edges are not mapped \u2014 play to the middle.');\n    }\n    if (par === 5 && yd)\n      bits.push(\n        'Three-shotter at most bags \u2014 decide your layup number NOW\x2C not off the second shot.'\n      );\n    if (par === 3) bits.push('One clean strike \u2014 commit fully to the yardage.');\n    return bits.join(' ');\n  }\n\n  function renderPlanDetail(course\x2C hole) {\n    const yd = planHoleYardage(hole);\n    const par = hole.par || inferParFromYards(yd);\n    const metaBits = [];\n    if (par) metaBits.push(`Par ${par}`);\n    if (yd) metaBits.push(`${Math.round(yd)} yd`);\n    if (hole.strokeIndex) metaBits.push(`stroke index ${hole.strokeIndex}`);\n    if (yd && !(Number(hole.yards) > 0))\n      metaBits.push('estimated from geometry');\n\n    const seq = planClubSequence(yd);\n    const hazards = planHazardsFor(hole);\n    const green = planGreenInfo(hole);\n\n    let html = '';\n    html += `<div class="plan-meta">${metaBits.length\n        ? metaBits.map(escapeHtml).join(' \xb7 ')\n        : 'Unmapped hole \u2014 add par/yards in round setup.'\n      }</div>`;\n\n    if (yd) {\n      if (seq) {\n        html +=\n          `<div class="plan-section">` +\n          `<div class="plan-section-title">Suggested sequence</div>` +\n          `<div class="plan-seq">${seq.seq.length\n            ? escapeHtml(seq.seq.join(' \u2192 ')) + ' \u2192 '\n            : ''\n          }<b>${escapeHtml(seq.finisherName)}</b></div>` +\n          `</div>`;\n      } else {\n        html +=\n          `<div class="plan-section">` +\n          `<div class="plan-section-title">Suggested sequence</div>` +\n          `<div class="plan-seq plan-dim">Add carry distances in the Clubs tab to get a sequence.</div>` +\n          `</div>`;\n      }\n    }\n\n    if (hazards.length) {\n      html +=\n        `<div class="plan-section">` +\n        `<div class="plan-section-title">Hazards</div>` +\n        hazards\n          .map(\n            (hz) =>\n              `<div class="plan-hazard${hz.type === 'water' ? ' water' : ''\n              }">` +\n              `<span class="plan-hazard-dot"></span>` +\n              `<span>${escapeHtml(hz.label)}</span>` +\n              (hz.sub\n                ? `<span class="plan-hazard-sub">${escapeHtml(hz.sub)}</span>`\n                : '') +\n              `</div>`\n          )\n          .join('') +\n        `</div>`;\n    } else {\n      html +=\n        `<div class="plan-section">` +\n        `<div class="plan-section-title">Hazards</div>` +\n        `<div class="plan-hazard plan-dim">None marked for this hole.</div>` +\n        `</div>`;\n    }\n\n    if (green && (green.front != null || green.center != null || green.back != null)) {\n      const tile = (k\x2C v) =>\n        `<div class="plan-green-tile"><i>${k}</i>${v != null ? v + ' yd' : '\u2014'\n        }</div>`;\n      html +=\n        `<div class="plan-section">` +\n        `<div class="plan-section-title">Green \xb7 measured from the tee</div>` +\n        `<div class="plan-green-grid">` +\n        tile('Front'\x2C green.front) +\n        tile('Middle'\x2C green.center) +\n        tile('Back'\x2C green.back) +\n        `</div></div>`;\n    }\n\n    html += `<div class="plan-strategy">${escapeHtml(\n      planStrategy(green ? green.depth : null\x2C par\x2C yd)\n    )}</div>`;\n\n    return html;\n  }\n\n  function openHolePlan(number) {\n    const course = getPlannerCourse();\n    if (!course || !els.planDetailCard) return;\n    const hole = (course.holes || [])[number - 1];\n    if (!hole) return;\n\n    els.planDetailTitle.textContent = `Hole ${number}`;\n    els.planDetailBody.innerHTML = renderPlanDetail(course\x2C hole);\n    els.planDetailCard.hidden = false;\n    try {\n      els.planDetailCard.scrollIntoView({\n        behavior: reduceMotion ? 'auto' : 'smooth'\x2C\n        block: 'nearest'\x2C\n      });\n    } catch { }\n    haptic(6);\n  }\n\n  /* ---------- Planner course search (ephemeral until saved) ----------\n     Reuses the round-setup search pipeline (courseNameSearch \u2192 Photon\n     with Overpass fallback) and the scorecard import pipeline\n     (fetchAutoCourseScorecard + buildAutoCourse). A picked course is\n     mapped and bound to the planner as EPHEMERAL \u2014 it is never written\n     to state.courseProfiles unless the user taps Save. */\n  let planSearchResults = [];\n  let planSearchSeq = 0;\n  let planSearchTimer = null;\n\n  function planSearchStatus(html) {\n    if (!els.planCourseSearchResults) return;\n    els.planCourseSearchResults.hidden = false;\n    els.planCourseSearchResults.innerHTML =\n      `<div class="prep-search-status">${html}</div>`;\n  }\n\n  function clearPlannerSearch() {\n    if (els.planCourseSearch) els.planCourseSearch.value = '';\n    if (els.planCourseSearchResults) {\n      els.planCourseSearchResults.hidden = true;\n      els.planCourseSearchResults.innerHTML = '';\n    }\n    planSearchResults = [];\n    planSearchSeq++;\n  }\n\n  async function runPlannerCourseSearch() {\n    if (!els.planCourseSearch || !els.planCourseSearchResults) return;\n    const term = els.planCourseSearch.value.trim();\n\n    // v-fix(search-keep) v1.7.1 (James: "unless I type three letters really\n    // fast it clears my input"): below min chars\x2C collapse the RESULTS \u2014\n    // never wipe the input value. Slow typers keep what they've typed.\n    if (term.length < COURSE_SEARCH_MIN_CHARS) {\n      planSearchResults = [];\n      planSearchSeq++;\n      if (els.planCourseSearchResults) {\n        els.planCourseSearchResults.hidden = true;\n        els.planCourseSearchResults.innerHTML = '';\n      }\n      return;\n    }\n    const mySeq = ++planSearchSeq;\n\n    if (!state.loc) {\n      planSearchStatus('Turn on location to search courses near you.');\n      planSearchResults = [];\n      return;\n    }\n\n    planSearchStatus(`Searching courses named \u201c${escapeHtml(term)}\u201d\u2026`);\n    try {\n      const results = await courseNameSearch(term\x2C state.loc);\n      if (mySeq !== planSearchSeq) return;\n      planSearchResults = results;\n      if (!results.length) {\n        planSearchStatus('No courses matched that name.');\n        return;\n      }\n      // v-fix(units) v1.7.1 (James: "courses in kilometers"): distances in\n      // miles \u2014 consistent with the rest of the app.\n      els.planCourseSearchResults.innerHTML = results\n        .map((c\x2C i) => {\n          const mi = haversineMeters(state.loc\x2C c) / 1609.344;\n          const dist = mi >= 0.19 ? `${mi.toFixed(mi < 10 ? 1 : 0)} mi` : `${Math.round(mi * 1760)} yd`;\n          return `\n            <button type="button" class="prep-search-row" data-idx="${i}">\n              <b>${escapeHtml(c.name)}</b>\n              <span>${dist} away \xb7 not saved</span>\n            </button>`;\n        })\n        .join('');\n    } catch (error) {\n      console.warn('Planner course search failed:'\x2C error);\n      if (mySeq !== planSearchSeq) return;\n      planSearchResults = [];\n      const msg =\n        error && error.name === 'AbortError'\n          ? 'Search is taking too long right now.'\n          : 'Name search is unavailable right now.';\n      planSearchStatus(\n        `${escapeHtml(msg)} <button type="button" class="ghost-btn" id="planSearchRetryBtn">Try again</button>`\n      );\n      const retry = document.getElementById('planSearchRetryBtn');\n      if (retry) retry.addEventListener('click'\x2C runPlannerCourseSearch);\n    }\n  }\n\n  function bindEphemeralCourse(course) {\n    prepEphemeralCourse = course;\n    state.planCourseId = PREP_EPHEMERAL_ID;\n    clearPlannerSearch();\n    renderPlanner();\n    renderPlannerCourse();\n    haptic(10);\n  }\n\n  async function pickPlannerSearchedCourse(candidate) {\n    if (!candidate) return;\n\n    // Already saved under this exact name? Just select the profile.\n    const saved = getSavedCourseMatch(candidate.name);\n    if (saved) {\n      prepEphemeralCourse = null;\n      state.planCourseId = saved.id;\n      clearPlannerSearch();\n      renderPlanner();\n      renderPlannerCourse();\n      haptic(8);\n      return;\n    }\n\n    planSearchStatus(`Mapping ${escapeHtml(candidate.name)}\u2026`);\n    try {\n      const elements = await fetchAutoCourseScorecard(candidate);\n      const course = normalizeCourse(buildAutoCourse(candidate\x2C elements));\n      // v-fix(map-empty) v1.7.1 (James: "it told me it couldn't map a golf\n      // course"): a course with ZERO mapped holes used to bind silently \u2014\n      // an empty-looking scorecard. Say so honestly and keep the search\n      // open so another course (or retry) is one tap away.\n      const mappedCount = (course.holes || []).filter(\n        (h) => h.source === 'openstreetmap'\n      ).length;\n      if (!mappedCount) {\n        planSearchResults = [];\n        planSearchStatus(\n          `${escapeHtml(candidate.name)} isn't mapped in OpenStreetMap yet \u2014 ` +\n          `no holes were found. Try another course\x2C or use the Play tab's ` +\n          `3D Green and trace its greens manually.`\n        );\n        return;\n      }\n      bindEphemeralCourse(course);\n    } catch (error) {\n      console.warn('Planner course mapping failed:'\x2C error);\n      planSearchResults = [];\n      // v-fix(map-err) v1.7.1: distinguish offline/timeouts from unmapped\x2C\n      // and KEEP the typed search term so a retry doesn't need retyping.\n      const offline = error && (error.name === 'AbortError' ||\n        /timeout|network|fetch/i.test(String(error && error.message)));\n      planSearchStatus(\n        (offline\n          ? `Couldn't reach the map service for ${escapeHtml(candidate.name)}.`\n          : `Couldn't map ${escapeHtml(candidate.name)} right now.`) +\n        ` <button type="button" class="ghost-btn" id="planSearchRetryBtn">Try again</button>`\n      );\n      const retry = document.getElementById('planSearchRetryBtn');\n      if (retry)\n        retry.addEventListener('click'\x2C () =>\n          pickPlannerSearchedCourse(candidate)\n        );\n    }\n  }\n\n  function savePlannerEphemeralCourse() {\n    if (!prepEphemeralCourse) return;\n    const name = prepEphemeralCourse.name;\n    const course = prepEphemeralCourse;\n    prepEphemeralCourse = null;\n    saveCourseProfile(course); // existing save path; re-renders planner\n    const savedProfile = getSavedCourseMatch(name);\n    state.planCourseId = savedProfile ? savedProfile.id : '';\n    clearPlannerSearch();\n    renderPlanner();\n    renderPlannerCourse();\n    haptic(12);\n  }\n\n  function wirePlannerCourseSearch() {\n    if (!els.planCourseSearch) return;\n\n    els.planCourseSearch.addEventListener('input'\x2C () => {\n      clearTimeout(planSearchTimer);\n      planSearchTimer = setTimeout(runPlannerCourseSearch\x2C 400); // debounce\n    });\n\n    els.planCourseSearchResults?.addEventListener('click'\x2C (e) => {\n      const btn = e.target.closest('.prep-search-row');\n      if (!btn) return;\n      pickPlannerSearchedCourse(planSearchResults[Number(btn.dataset.idx)]);\n    });\n\n    els.planSaveCourseBtn?.addEventListener('click'\x2C savePlannerEphemeralCourse);\n  }\n\n  function initPlanner() {\n    if (!els.planCourseSelect) return;\n    els.planCourseSelect.addEventListener('change'\x2C () => {\n      state.planCourseId = els.planCourseSelect.value || '';\n      renderPlannerCourse();\n      haptic(5);\n    });\n    wirePlannerCourseSearch();\n    renderPlanner();\n  }\n  // ============================================================\n  //  BLOCK 16c \u2014 GROUP SCORING\n  //  Partners + their scores ride on roundSession (groupPlayers /\n  //  groupScores). Player 1 is ALWAYS the user and is implicit \u2014 only\n  //  partners are stored. Nothing here ever writes to state.round\x2C which\n  //  is what keeps the personal stats pipeline clean.\n  // ============================================================\n\n  const GROUP_MAX_PARTNERS = 3; // 3 partners + you = a standard foursome\n\n  // Persisted playing-partner roster. Lives OUTSIDE any round so partners\n  // can be managed before starting and survive between rounds.\n  const GROUP_ROSTER_KEY = 'caddy:groupRoster:v1';\n\n  function loadGroupRoster() {\n    const v = load(GROUP_ROSTER_KEY\x2C []);\n    return Array.isArray(v)\n      ? v.filter(\n          (p) =>\n            p &&\n            typeof p.id === 'string' &&\n            typeof p.name === 'string'\n        )\n      : [];\n  }\n\n  function saveGroupRoster(list) {\n    save(\n      GROUP_ROSTER_KEY\x2C\n      Array.isArray(list) ? list.slice(0\x2C GROUP_MAX_PARTNERS) : []\n    );\n  }\n\n  // Pull a current/finished session's partners into the roster so the next\n  // round \u2014 and pre-round editing \u2014 keeps the same group.\n  function mergePartnersIntoRoster(players) {\n    if (!Array.isArray(players) || !players.length) return;\n    const roster = loadGroupRoster();\n    const seen = new Set(roster.map((p) => p.id));\n    for (const p of players) {\n      if (!p || typeof p.id !== 'string' || seen.has(p.id)) continue;\n      if (roster.length >= GROUP_MAX_PARTNERS) break;\n      roster.push({\n        id: p.id\x2C\n        name: String(p.name || 'Player').slice(0\x2C 24)\x2C\n      });\n      seen.add(p.id);\n    }\n    saveGroupRoster(roster);\n  }\n\n  function groupPartners() {\n    const rs = state.roundSession;\n    if (rs && Array.isArray(rs.groupPlayers)) return rs.groupPlayers;\n    // No live round: fall back to the saved roster so partners can be\n    // added/removed/renamed before starting and aren't lost between rounds.\n    return loadGroupRoster();\n  }\n\n  // Lazily create (and size to the course) a partner's score array.\n  function partnerScoreArray(partnerId) {\n    const rs = state.roundSession;\n    if (!rs) return [];\n    if (\n      !rs.groupScores ||\n      typeof rs.groupScores !== 'object'\n    ) {\n      rs.groupScores = {};\n    }\n    const n = getCourseHoleCount();\n    let arr = rs.groupScores[partnerId];\n    if (!Array.isArray(arr)) arr = [];\n    while (arr.length < n) arr.push('');\n    rs.groupScores[partnerId] = arr;\n    return arr;\n  }\n\n  function scoreDraftPartnerName() {\n    const pid = state._scorePartnerId || '';\n    if (!pid) return '';\n    const p = groupPartners().find((x) => x.id === pid);\n    return p ? p.name : '';\n  }\n\n  function groupTotals() {\n    const out = [];\n    for (const p of groupPartners()) {\n      const arr = partnerScoreArray(p.id);\n      let total = 0;\n      let thru = 0;\n      arr.forEach((v) => {\n        const n = Number(v);\n        if (Number.isFinite(n) && n > 0) {\n          total += n;\n          thru += 1;\n        }\n      });\n      out.push({ id: p.id\x2C name: p.name\x2C total: thru ? total : null\x2C thru });\n    }\n    return out;\n  }\n\n  function renderGroupUI() {\n    if (!els.groupTableWrap) return;\n    const partners = groupPartners();\n    if (els.groupCountChip) {\n      els.groupCountChip.textContent = partners.length\n        ? `${1 + partners.length} players`\n        : 'Solo';\n    }\n    renderGroupTable();\n  }\n\n  function renderGroupEditor() {\n    if (!els.groupEditorList) return;\n    const partners = groupPartners();\n    els.groupEditorList.innerHTML = partners\n      .map(\n        (p) => `\n        <div class="group-editor-row" data-id="${escapeHtml(p.id)}">\n          <input type="text" maxlength="24" value="${escapeHtml(p.name)}"\n            aria-label="Partner name" />\n          <button class="group-editor-remove" type="button"\n            aria-label="Remove ${escapeHtml(p.name)}">\u2715</button>\n        </div>`\n      )\n      .join('');\n\n    els.groupEditorList\n      .querySelectorAll('.group-editor-row')\n      .forEach((row) => {\n        const id = row.dataset.id;\n        const input = row.querySelector('input');\n        input.addEventListener('change'\x2C () => {\n          const name = input.value.trim() || 'Player';\n          // QA-003: renames must not collide with another partner either.\n          if (partnerNameTaken(name\x2C id)) {\n            setNotice(`"${name}" is already in the group.`\x2C 'danger');\n            haptic(12);\n            input.value =\n              groupPartners().find((x) => x.id === id)?.name || name;\n            return;\n          }\n          const rs = state.roundSession;\n          const inSession =\n            rs && Array.isArray(rs.groupPlayers)\n              ? rs.groupPlayers.find((x) => x.id === id)\n              : null;\n          if (inSession) {\n            inSession.name = name;\n            saveRoundSession();\n          }\n          const roster = loadGroupRoster();\n          const inRoster = roster.find((x) => x.id === id);\n          if (inRoster) {\n            inRoster.name = name;\n            saveGroupRoster(roster);\n          }\n          renderGroupUI();\n        });\n        row\n          .querySelector('.group-editor-remove')\n          .addEventListener('click'\x2C () => {\n            const p = groupPartners().find((x) => x.id === id);\n            if (\n              !p ||\n              !confirm(\n                `Remove ${p.name}${\n                  state.roundSession ? ' and their scores from this round' : ''\n                }?`\n              )\n            ) {\n              return;\n            }\n            if (\n              state.roundSession &&\n              Array.isArray(state.roundSession.groupPlayers)\n            ) {\n              state.roundSession.groupPlayers =\n                state.roundSession.groupPlayers.filter((x) => x.id !== id);\n              delete state.roundSession.groupScores[id];\n              if (state._scorePartnerId === id) state._scorePartnerId = '';\n              saveRoundSession();\n            }\n            saveGroupRoster(loadGroupRoster().filter((x) => x.id !== id));\n            renderGroupUI();\n            renderRound();\n            haptic(8);\n          });\n      });\n  }\n\n  function renderGroupTable() {\n    if (!els.groupTableWrap) return;\n    const partners = groupPartners();\n    const n = getCourseHoleCount();\n    const mine = getScorecardRows();\n\n    if (!partners.length) {\n      els.groupTableWrap.innerHTML =\n        '<div class="hint">No partners yet \u2014 add them above and their scores will appear beside yours.</div>';\n      return;\n    }\n\n    const inRound = !!state.roundSession;\n    const totalsById = {};\n    if (inRound)\n      groupTotals().forEach((g) => (totalsById[g.id] = g));\n\n    const holeHeads = Array.from({ length: n }\x2C (_\x2C i) => `<th>${i + 1}</th>`).join('');\n\n    const sumRow = (cells\x2C cls) =>\n      `<tr>${cells}</tr>`.replace('<tr>'\x2C `<tr${cls ? ` class="${cls}"` : ''}>`);\n\n    // Your row: read-only mirror of the main scorecard.\n    const yourCells = [\n      '<td>You</td>'\x2C\n      ...Array.from({ length: n }\x2C (_\x2C i) => {\n        const v = mine[i] ? mine[i].score : '';\n        return `<td>${v === '' ? '\xb7' : escapeHtml(v)}</td>`;\n      })\x2C\n    ].join('');\n    const yourTotal = summarizeRound(mine).totalScore;\n\n    const partnerRows = partners\n      .map((p) => {\n        const arr = inRound ? partnerScoreArray(p.id) : [];\n        const tot = totalsById[p.id];\n        // Every row needs the trailing Tot cell or the columns misalign\n        // against the header and your row.\n        const totalCell =\n          inRound && tot && tot.thru\n            ? `<td class="group-total">${tot.total}</td>`\n            : '<td>\xb7</td>';\n        const scoreCells = Array.from({ length: n }\x2C (_\x2C i) => {\n          if (!inRound) return '<td>\xb7</td>';\n          const v = arr[i];\n          return `<td><input type="number" inputmode="numeric" min="1" max="15"\n                value="${escapeHtml(v)}" data-pid="${escapeHtml(p.id)}"\n                data-i="${i}" aria-label="${escapeHtml(p.name)} hole ${i + 1}" /></td>`;\n        }).join('');\n        return `<tr class="group-partner-row" data-pid="${escapeHtml(\n          p.id\n        )}"><td class="group-name-cell">${escapeHtml(p.name)}</td>${scoreCells}${totalCell}</tr>`;\n      })\n      .join('');\n\n    const yourTotalCells =\n      yourCells + `<td class="group-total">${yourTotal || '\xb7'}</td>`;\n\n    els.groupTableWrap.innerHTML = `\n      <div class="group-table-scroll">\n        <table class="group-table">\n          <thead><tr><th>Hole</th>${holeHeads}<th>Tot</th></tr></thead>\n          <tbody>\n            ${sumRow(yourTotalCells)}\n            ${partnerRows}\n          </tbody>\n        </table>\n      </div>\n      ${\n        inRound\n          ? ''\n          : '<div class="hint" style="margin-top:6px">Start a round to enter partner scores.</div>'\n      }`;\n\n    els.groupTableWrap.querySelectorAll('input[data-pid]').forEach((inp) => {\n      inp.addEventListener('change'\x2C () => {\n        const arr = partnerScoreArray(inp.dataset.pid);\n        arr[Number(inp.dataset.i)] = sanitizeInt(inp.value);\n        saveRoundSession();\n        renderGroupTable();\n      });\n    });\n\n    // Tap a partner's name \u2192 rename (or long-press-style second option:\n    // remove) via the partner sheet \u2014 no separate editor list needed.\n    els.groupTableWrap\n      .querySelectorAll('.group-partner-row .group-name-cell')\n      .forEach((cell) => {\n        cell.addEventListener('click'\x2C () => {\n          const pid = cell.closest('.group-partner-row')?.dataset.pid;\n          if (pid) openPartnerSheet(pid);\n        });\n      });\n  }\n\n  function renderScoreSheetChips() {\n    if (!els.roundScoreChips) return;\n    const partners = groupPartners();\n    if (!partners.length) {\n      els.roundScoreChips.hidden = true;\n      els.roundScoreChips.innerHTML = '';\n      return;\n    }\n    els.roundScoreChips.hidden = false;\n    const cur = state._scorePartnerId || '';\n    const chip = (label\x2C pid) =>\n      `<button class="club-chip${cur === pid ? ' active' : ''}"\n        data-pid="${escapeHtml(pid)}" type="button">${escapeHtml(label)}</button>`;\n    els.roundScoreChips.innerHTML =\n      chip('You'\x2C '') + partners.map((p) => chip(p.name\x2C p.id)).join('');\n\n    els.roundScoreChips\n      .querySelectorAll('.club-chip')\n      .forEach((b) => {\n        b.addEventListener('click'\x2C () => {\n          state._scorePartnerId = b.dataset.pid || '';\n          // Stay on the hole being edited\x2C not the current hole.\n          state.roundScoreDraft = getRoundScoreDraftForHole(\n            state._scoreSheetHole || getCurrentHoleNumber()\n          );\n          // Repaint the chips so the tapped name gets the green .active\n          // state \u2014 the sheet re-render alone never touched these buttons.\n          renderScoreSheetChips();\n          renderRoundScoreSheet();\n          haptic(5);\n        });\n      });\n  }\n\n  function initGroupEvents() {\n    if (!els.addPartnerBtn) return;\n    // Premium path: the partner sheet (same one the options sheet uses)\x2C\n    // not the browser prompt. Adding mid-round goes straight to the\n    // session; the roster merge happens inside the sheet's commit.\n    els.addPartnerBtn.addEventListener('click'\x2C () => {\n      if (groupPartners().length >= GROUP_MAX_PARTNERS) {\n        setNotice(\n          `Maximum ${GROUP_MAX_PARTNERS} partners (foursome).`\x2C\n          'danger'\n        );\n        return;\n      }\n      openPartnerSheet();\n    });\n  }\n  // ============================================================\n  //  BLOCK 17 \u2014 SELF-CHECK (dev only; safe to ship\x2C costs nothing until called)\n  // ============================================================\n  window.__caddySelfTest = function () {\n    const out = [];\n    const ok = (name\x2C pass\x2C detail) => out.push(`${pass ? '\u2705' : '\u274c'} ${name}${detail ? ' \u2014 ' + detail : ''}`);\n\n    // 0. Onboarding gate: first-run shows\x2C set-flag stays quiet.\n    try {\n      const obPrev = localStorage.getItem(ONBOARD_KEY);\n      localStorage.removeItem(ONBOARD_KEY);\n      const showsFirstRun = shouldShowOnboard();\n      localStorage.setItem(ONBOARD_KEY\x2C '1');\n      const quietAfterSet = !shouldShowOnboard();\n      if (obPrev === null) localStorage.removeItem(ONBOARD_KEY);\n      else localStorage.setItem(ONBOARD_KEY\x2C obPrev);\n      ok('Onboarding gate: shows when key absent\x2C quiet once set'\x2C\n        showsFirstRun && quietAfterSet\x2C\n        `absent\u2192show=${showsFirstRun}\x2C set\u2192hide=${quietAfterSet}`);\n    } catch { /* storage unavailable in host */ }\n\n    // 1. Geodesy: meridian arc\x2C lat 40->41 on WGS-84.\n    // Simpson's rule on M(\u03c6)=a(1-e\xb2)/(1-e\xb2sin\xb2\u03c6)^1.5 over 40\xb0..41\xb0 gives 111046.6 m;\n    // cross-checks against the standard table value of 111.048 km per degree at 40.5\xb0.\n    const g = geodesicInverse({ lat: 40\x2C lng: -105 }\x2C { lat: 41\x2C lng: -105 });\n    ok('Vincenty meridian arc 40\xb0\u219241\xb0'\x2C Math.abs(g.s - 111046.6) < 5\x2C `${g.s.toFixed(1)} m (expect \u2248111047 m)`);\n\n    // 2. Direct/inverse round trip.\n    const p2 = geodesicDirect({ lat: 33.5\x2C lng: -84.4 }\x2C 73.2\x2C 4211.7);\n    const back = geodesicInverse({ lat: 33.5\x2C lng: -84.4 }\x2C p2);\n    ok('Geodesic direct/inverse round trip'\x2C Math.abs(back.s - 4211.7) < 1e-3 && Math.abs(angleDiff(back.az1\x2C 73.2)) < 1e-6\x2C\n      `\u0394s=${(back.s - 4211.7).toExponential(2)} m`);\n\n    // 3. Air density at CIPM reference: 20 \xb0C\x2C 101325 Pa\x2C 50% RH -> 1.1992 kg/m\xb3.\n    const rho = airDensityCIPM(20\x2C 101325\x2C 50);\n    ok('CIPM-2007 density @20\xb0C/101325Pa/50%RH'\x2C Math.abs(rho - 1.1992) < 0.0005\x2C `${rho.toFixed(5)} kg/m\xb3`);\n\n    // 4. Standard atmosphere: ISA at 5000 ft -> 843.1 hPa.\n    const pIsa = pressureFromISA(5000 * FT_TO_M) / 100;\n    ok('ISA pressure @5000 ft'\x2C Math.abs(pIsa - 843.1) < 1.0\x2C `${pIsa.toFixed(1)} hPa`);\n\n    // 5. Special functions.\n    ok('erf(1)'\x2C Math.abs(erf(1) - 0.8427007929) < 1e-9\x2C erf(1).toFixed(10));\n    ok('invNorm(0.975)'\x2C Math.abs(invNorm(0.975) - 1.959963985) < 1e-8\x2C invNorm(0.975).toFixed(9));\n    ok('tQuantile(0.975\x2C 10)'\x2C Math.abs(tQuantile(0.975\x2C 10) - 2.228138852) < 1e-6\x2C tQuantile(0.975\x2C 10).toFixed(9));\n    ok('chi2Inv(0.995\x2C 2)'\x2C Math.abs(chi2Inv(0.995\x2C 2) - 10.5966347) < 1e-5\x2C chi2Inv(0.995\x2C 2).toFixed(7));\n\n    // 6. Trajectory family monotone and physically plausible.\n    const F = referenceLaunchFamily();\n    let mono = true;\n    for (let i = 1; i < F.rows.length; i++) if (F.rows[i].carryYd <= F.rows[i - 1].carryYd) mono = false;\n    ok('Launch family monotone in carry'\x2C mono\x2C `${fmt(F.minCarry)}\u2013${fmt(F.maxCarry)} yd`);\n    const drv = [...F.rows].reverse().find((r) => !r.extended);\n    ok('Driver carry plausible (230\u2013320 yd)'\x2C drv.carryYd > 230 && drv.carryYd < 320\x2C `${drv.carryYd.toFixed(1)} yd`);\n\n    // 6b. Truncation guard. TRAJ_DT and the step budget are coupled: if dt shrinks\n    // without the cap rising\x2C long trajectories end mid-flight and the entire\n    // plays-like scale compresses \u2014 while the identity test below still passes.\n    const drvTraj = integrateTrajectory(\n      { speedMps: 167 * MPH_TO_MPS\x2C launchDeg: 10.9\x2C spinRadS: 2686 * RPM_TO_RADS\x2C aimOffsetDeg: 0 }\x2C\n      STILL_AIR_ENV\n    );\n    ok('Driver trajectory reaches the ground (not step-capped)'\x2C drvTraj.reached === true\x2C\n      `t=${drvTraj.timeS.toFixed(2)} s of ${(TRAJ_MAX_STEPS * TRAJ_DT).toFixed(1)} s budget`);\n    ok('Driver descent angle plausible (32\u201348\xb0)'\x2C\n      drvTraj.descentDeg > 32 && drvTraj.descentDeg < 48\x2C `${drvTraj.descentDeg.toFixed(1)}\xb0`);\n\n    // 7. Inverse solver identity: standard conditions must be a fixed point.\n    const idn = playsLike({\n      horizontalYd: 165\x2C bearingDeg: 0\x2C elevDiffFt: 0\x2C\n      courseAltitudeFt: 0\x2C tempF: STD_TEMP_F\x2C rh: STD_RH\x2C windMph: 0\x2C windFromDeg: 0\x2C latDeg: STD_LAT\n    });\n    ok('Plays-like identity in standard conditions'\x2C Math.abs(idn.playsLikeYd - 165) <= 1\x2C `${idn.playsLikeYd} yd`);\n\n    // 8. Monotonicity and direction of each physical effect at 165 yd.\n    const base = (o) => playsLike(Object.assign({\n      horizontalYd: 165\x2C bearingDeg: 0\x2C elevDiffFt: 0\x2C\n      courseAltitudeFt: 0\x2C tempF: STD_TEMP_F\x2C rh: STD_RH\x2C windMph: 0\x2C windFromDeg: 0\x2C latDeg: STD_LAT\n    }\x2C o)).playsLikeYd;\n    ok('Headwind plays longer'\x2C base({ windMph: 15\x2C windFromDeg: 0 }) > 165 + 6\x2C `${base({ windMph: 15\x2C windFromDeg: 0 })} yd`);\n    ok('Tailwind plays shorter'\x2C base({ windMph: 15\x2C windFromDeg: 180 }) < 165 - 3\x2C `${base({ windMph: 15\x2C windFromDeg: 180 })} yd`);\n    ok('Headwind costs more than tail gains (asymmetry)'\x2C\n      (base({ windMph: 15\x2C windFromDeg: 0 }) - 165) > (165 - base({ windMph: 15\x2C windFromDeg: 180 })));\n    ok('Uphill plays longer'\x2C base({ elevDiffFt: 30 }) > 165 + 6\x2C `${base({ elevDiffFt: 30 })} yd`);\n    ok('Altitude plays shorter'\x2C base({ courseAltitudeFt: 5280 }) < 165 - 6\x2C `${base({ courseAltitudeFt: 5280 })} yd`);\n    ok('Cold plays longer'\x2C base({ tempF: 40 }) > 165\x2C `${base({ tempF: 40 })} yd`);\n    ok('Humid plays marginally longer (shorter required)'\x2C base({ rh: 95 }) <= base({ rh: 5 }));\n\n    // 9. Wind sign convention consistency (the bug that was fixed).\n    const wc = windComponents({ windMph: 10\x2C windFromDeg: 90\x2C bearingDeg: 0 });\n    const wr = windRelative(90\x2C 0\x2C 10);\n    ok('windComponents/windRelative crosswind signs agree'\x2C Math.sign(wc.crosswindMph) === Math.sign(wr.cross)\x2C\n      `${wc.crosswindMph.toFixed(2)} vs ${wr.cross.toFixed(2)}`);\n    ok('Wind from the east on a north shot is from the right'\x2C wc.crosswindMph > 0);\n\n    // 10. Expected-strokes baselines sane and monotone.\n    ok('E[strokes] fairway monotone 100\u2192200 yd'\x2C expectedStrokes('fairway'\x2C 200) > expectedStrokes('fairway'\x2C 100));\n    ok('Rough costs more than fairway'\x2C expectedStrokes('rough'\x2C 150) > expectedStrokes('fairway'\x2C 150));\n    ok('E[strokes] 8 ft putt \u2248 1.5'\x2C Math.abs(expectedStrokes('green'\x2C 8 / 3) - 1.515) < 0.05);\n\n    // 11. Dispersion posterior shrinks with data.\n    const prior = formulaDispersionYd(165);\n    ok('Prior dispersion plausible at 165 yd'\x2C prior >= 8 && prior <= 22\x2C `\xb1${prior} yd`);\n\n    // 12. GPS fuser is not overconfident.\n    const fx = Array.from({ length: 10 }\x2C () => ({ lat: 33.5\x2C lng: -84.4\x2C accuracy: 10\x2C ts: Date.now() }));\n    const fused = weightedAverage(fx);\n    ok('Fused accuracy respects correlated-error floor'\x2C fused.accuracy >= GPS_CORRELATED_FRAC * 10\x2C\n      `\xb1${fused.accuracy.toFixed(2)} m from ten \xb110 m fixes`);\n\n    // 13. Hazard cost model: carry pricing\x2C off-line falloff.\n    const hzLine = [{ type: 'water'\x2C alongYd: 130\x2C crossYd: 0 }];\n    ok('Hazard cost is positive over water'\x2C hazardCostStrokes(135\x2C 0\x2C hzLine) > 0);\n    ok('Hazard cost is zero once carried'\x2C hazardCostStrokes(160\x2C 0\x2C hzLine) === 0);\n    ok('Hazard cost fades off-line'\x2C\n      hazardCostStrokes(135\x2C 0\x2C hzLine) > hazardCostStrokes(135\x2C 25\x2C hzLine));\n\n    // 14. End-to-end: water guarding a 150 yd target at 130 yd must change\n    // the plan (different club\x2C effort\x2C aim\x2C or advice) vs dry ground.\n    {\n      const sClubs = state.clubs\x2C sTarget = state.target\x2C sLoc = state.loc\x2C sCalc = state.lastCalc;\n      state.clubs = [\n        { id: 't1'\x2C name: '8-iron'\x2C yards: 145 }\x2C\n        { id: 't2'\x2C name: '7-iron'\x2C yards: 160 }\x2C\n      ];\n      state.target = { lat: 33.5\x2C lng: -84.4 };\n      state.loc = { lat: 33.49782\x2C lng: -84.4 }; // \u2248150 yd south of target\n      state.lastCalc = null;\n      const dry = recommendSmart(150\x2C null\x2C 0\x2C 0\x2C {});\n      const wet = recommendSmart(150\x2C null\x2C 0\x2C 0\x2C { hazards: hzLine });\n      ok('Water changes the plan vs dry ground'\x2C\n        wet.main !== dry.main ||\n        wet.eff !== dry.eff ||\n        (wet.aimLateral || 0) !== (dry.aimLateral || 0) ||\n        JSON.stringify(wet.tips) !== JSON.stringify(dry.tips)\x2C\n        `dry=${dry.main} / wet=${wet.main}`);\n      state.clubs = sClubs; state.target = sTarget; state.loc = sLoc; state.lastCalc = sCalc;\n    }\n\n    // 15. Scorecard tap-cycle logic: score steps\x2C FIR skips Y on par 3\x2C\n    // played-par basis is honest mid-round.\n    {\n      const sRound = state.round\x2C sSession = state.roundSession;\n      state.round = [\n        { hole: 1\x2C score: ''\x2C putts: ''\x2C fir: ''\x2C gir: '' }\x2C\n        { hole: 2\x2C score: ''\x2C putts: ''\x2C fir: ''\x2C gir: '' }\x2C\n        { hole: 3\x2C score: ''\x2C putts: ''\x2C fir: ''\x2C gir: '' }\x2C\n      ];\n      state.roundSession = {\n        course: { id: 't'\x2C name: 'T'\x2C holesCount: 3\x2C holes: [\n          { number: 1\x2C par: 4 }\x2C { number: 2\x2C par: 4 }\x2C { number: 3\x2C par: 3 }\x2C\n        ] }\x2C\n        hole: 1\x2C currentHole: 1\x2C status: 'active'\x2C scorecard: state.round\x2C\n      };\n      cycleRoundCell(0\x2C 'score'); // '' \u2192 1\n      cycleRoundCell(0\x2C 'score'); // 1 \u2192 2\n      ok('Score cycle steps upward'\x2C Number(state.round[0].score) === 2\x2C\n        `score=${state.round[0].score}`);\n      cycleRoundCell(0\x2C 'putts');\n      ok('Putts cycle starts at 0'\x2C Number(state.round[0].putts) === 0);\n      cycleRoundCell(1\x2C 'fir'); // par-4: '' \u2192 Y\n      ok('FIR cycle on par 4 starts at Y'\x2C state.round[1].fir === 'Y');\n      // Par-3 hole must skip the meaningless Y step.\n      cycleRoundCell(2\x2C 'fir');\n      ok('FIR cycle on par 3 skips Y'\x2C state.round[2].fir === 'N'\x2C\n        `fir=${state.round[2].fir}`);\n      // Score the second hole\x2C then played-par must count holes 1+2 only.\n      cycleRoundCell(1\x2C 'score'); // '' \u2192 1\n      const played = scoreParPlayed(state.roundSession.course\x2C state.round);\n      ok('Played-par basis counts only scored holes'\x2C played === 8\x2C\n        `parPlayed=${played}`);\n      state.round = sRound; state.roundSession = sSession;\n    }\n\n    // 16. Tee system: applyTeeSet rewrites yardages/tee points/pars\x2C\n    // saveCourseProfile keeps ONE profile per course name across tees\x2C\n    // and tee memory round-trips per course.\n    {\n      const sProfiles = state.courseProfiles;\n      try { localStorage.removeItem('caddy:courseTees'); } catch {}\n\n      const course = {\n        id: 'tee-test'\x2C name: 'Tee Test CC'\x2C teeName: 'Blue'\x2C\n        activeTeeSet: 'Blue'\x2C holesCount: 9\x2C\n        holes: Array.from({ length: 9 }\x2C (_\x2C i) => ({\n          number: i + 1\x2C par: 4\x2C yards: 300\x2C\n        }))\x2C\n        teeSets: [\n          { name: 'Blue'\x2C holes: { 1: { lat: 33.0\x2C lng: -84.0\x2C yards: 400 } } }\x2C\n          { name: 'White'\x2C holes: { 1: { lat: 33.001\x2C lng: -84.0\x2C yards: 360 } } }\x2C\n        ]\x2C\n      };\n      course.holes[0].parByTee = { White: 5 };\n\n      const applied = applyTeeSet(normalizeCourse(course)\x2C 'White');\n      const h1 = applied.holes[0];\n      ok('applyTeeSet swaps yardage + tee point'\x2C\n        h1.yards === 360 && h1.teePoint && h1.teePoint.lat === 33.001\x2C\n        `yards=${h1.yards} tee=${h1.teePoint && h1.teePoint.lat}`);\n      ok('applyTeeSet applies per-tee par'\x2C h1.par === 5\x2C `par=${h1.par}`);\n\n      // Saving the same course from two different tees must NOT fork\n      // duplicate profiles \u2014 one card per course.\n      state.courseProfiles = [];\n      saveCourseProfile(normalizeCourse({ ...course\x2C teeName: 'Blue' }));\n      saveCourseProfile(normalizeCourse({ ...course\x2C teeName: 'White' }));\n      ok('saveCourseProfile dedupes by course name'\x2C\n        state.courseProfiles.length === 1 &&\n        state.courseProfiles[0].teeName === 'White'\x2C\n        `profiles=${state.courseProfiles.length}`);\n\n      rememberCourseTees(applied);\n      const mem = load('caddy:courseTees'\x2C {})['tee test cc'];\n      ok('Tee memory persists per course'\x2C\n        !!mem && mem.activeTeeSet === 'White'\x2C\n        mem ? `set=${mem.activeTeeSet}` : 'missing');\n\n      state.courseProfiles = sProfiles;\n    }\n\n    // 17. Planner course search: ephemeral binding + save promotion.\n    {\n      const sProfiles = state.courseProfiles;\n      const sPlanId = state.planCourseId;\n      const sEphem = prepEphemeralCourse;\n      try {\n        state.courseProfiles = [];\n\n        const mkCourse = (id\x2C name) => normalizeCourse({\n          id\x2C name\x2C teeName: 'Regular tees'\x2C holesCount: 9\x2C\n          holes: Array.from({ length: 9 }\x2C (_\x2C i) => ({ number: i + 1\x2C par: 4\x2C yards: 320 }))\x2C\n        });\n\n        // Ephemeral course shows up as '@prep-search \xb7 not saved'.\n        prepEphemeralCourse = mkCourse('eph-test'\x2C 'Search Test GC');\n        state.planCourseId = PREP_EPHEMERAL_ID;\n        const opts = planCourseOptions();\n        ok('ephemeral searched course appears in planner options'\x2C\n          opts.some((o) => o.id === PREP_EPHEMERAL_ID && /not saved/.test(o.name))\x2C\n          opts.map((o) => o.id).join('\x2C'));\n\n        // holeInfo resolves through the ephemeral course too.\n        const info = window.CaddyPrep.holeInfo(1);\n        ok('holeInfo binds via ephemeral course'\x2C\n          !!info && info.number === 1\x2C\n          info ? `course=${info.courseName}` : 'null');\n\n        // Saving promotes it into courseProfiles and re-points the picker.\n        state.planCourseId = PREP_EPHEMERAL_ID;\n        savePlannerEphemeralCourse();\n        ok('save promotes ephemeral course into profiles'\x2C\n          state.courseProfiles.length === 1 &&\n            state.planCourseId === state.courseProfiles[0].id &&\n            prepEphemeralCourse === null\x2C\n          `profiles=${state.courseProfiles.length} planId=${state.planCourseId}`);\n\n        // Picking a name that matches a saved profile selects it \u2014 no dup.\n        pickPlannerSearchedCourse({ name: 'search test gc'\x2C lat: 33\x2C lng: -84 });\n        ok('picking a saved course name selects the profile (no dup)'\x2C\n          state.courseProfiles.length === 1 &&\n            state.planCourseId === state.courseProfiles[0].id\x2C\n          `profiles=${state.courseProfiles.length} planId=${state.planCourseId}`);\n      } finally {\n        state.courseProfiles = sProfiles;\n        state.planCourseId = sPlanId;\n        prepEphemeralCourse = sEphem;\n      }\n    }\n\n    // 17b. Start-round gate (v1.0.69): beginRound is the single choke\n    // point \u2014 while courseMappingState is 'mapping'/'failed' it must\n    // refuse and leave any existing session untouched.\n    {\n      const sSession = state.roundSession;\n      const sMap = state.courseMappingState;\n      try {\n        state.roundSession = null;\n        state.courseMappingState = 'mapping';\n        state.courseMappingName = 'Gate Test GC';\n        const refused = beginRound(makeCasualCourse()\x2C 1);\n        ok('beginRound refuses while scorecard mapping is in flight'\x2C\n          refused === null && state.roundSession === null\x2C\n          `returned=${JSON.stringify(refused)} session=${state.roundSession}`);\n\n        state.courseMappingState = 'idle';\n        beginRound(makeCasualCourse()\x2C 1);\n        const allowed = state.roundSession !== null;\n        state.roundSession = null;\n        ok('beginRound proceeds once mapping is idle'\x2C allowed\x2C\n          `session created=${allowed}`);\n      } finally {\n        state.roundSession = sSession;\n        state.courseMappingState = sMap;\n      }\n    }\n\n    // 17c. Collapsed detent band math (v1.0.69): the collapsed peek is a\n    // slim ~72px summary\x2C not the old 150px header \u2014 the sheet's collapsed\n    // offset must use the compact band so no dead slab shows.\n    {\n      const dragEl = els.sheetDrag;\n      const peekNode = els.sheet ? els.sheet.querySelector('.sheet-peek') : null;\n      const dragH = dragEl ? Number(dragEl.offsetHeight) || 130 : 130;\n      const peekH = peekNode ? Number(peekNode.offsetHeight) || 0 : 0;\n      const band = Math.min(120\x2C Math.max(56\x2C dragH - peekH)) || 72;\n      ok('Collapsed detent band stays slim (\u2264120px\x2C \u226556px)'\x2C\n        band >= 56 && band <= 120\x2C\n        `drag=${dragH}px peek=${peekH}px band=${band}px`);\n    }\n\n    console.log(out.join('\\n'));\n    return out;\n  };\n\n  /* ================= Overpass transport: mirrors + timeout + cache ================= */\n\n  // kumi.systems is gone (its redirect can turn a POST into a GET landing\n  // page) and api.de rate-limits browsers hard\x2C so friendlier mirrors lead.\n  const OVERPASS_ENDPOINTS = [\n    'https://overpass.private.coffee/api/interpreter'\x2C\n    'https://overpass.osm.jp/api/interpreter'\x2C\n    'https://overpass-api.de/api/interpreter'\x2C\n  ];\n  // Fire the next mirror if the current one hasn't answered within this\n  // window and let whichever finishes first win.\n  const OVERPASS_HEDGE_MS = 1800;\n  const OSM_CACHE_PREFIX = 'osm:v2:';                  // v2 == invalidates the old buggy data\n  const OSM_CACHE_TTL_MS = 7 * 24 * 3600 * 1000;\n  const OSM_CACHE_MAX_ENTRIES = 20;\n  // v1.0.70: after the hedged mirror round comes back empty or fully failed\x2C\n  // wait this long and re-query the primary once before concluding 'not found'.\n  const OVERPASS_RETRY_BACKOFF_MS = 1500;\n\n  function osmSleep(ms) {\n    return new Promise((r) => setTimeout(r\x2C ms));\n  }\n\n  function osmCacheGet(key) {\n    try {\n      const raw = localStorage.getItem(key);\n      if (!raw) return null;\n      const rec = JSON.parse(raw);\n      if (!rec || Date.now() - rec.t > rec.ttl) return null;\n      return rec.v;\n    } catch {\n      return null;\n    }\n  }\n\n  function osmCacheSet(key\x2C value\x2C ttl) {\n    const write = () =>\n      localStorage.setItem(key\x2C JSON.stringify({ t: Date.now()\x2C ttl\x2C v: value }));\n    try {\n      write();\n    } catch {\n      // Quota: evict oldest osm: entries\x2C retry once.\n      try {\n        const entries = [];\n        for (let i = 0; i < localStorage.length; i++) {\n          const k = localStorage.key(i);\n          if (k && k.startsWith(OSM_CACHE_PREFIX)) {\n            try {\n              entries.push({ k\x2C t: JSON.parse(localStorage.getItem(k)).t || 0 });\n            } catch { }\n          }\n        }\n        entries\n          .sort((a\x2C b) => a.t - b.t)\n          .slice(0\x2C Math.max(1\x2C entries.length - OSM_CACHE_MAX_ENTRIES))\n          .forEach((e) => localStorage.removeItem(e.k));\n        write();\n      } catch { }\n    }\n  }\n\n  /**\n   * Hedged mirror failover. Mirrors start sequentially; the next launches\n   * after OVERPASS_HEDGE_MS even if the current one is still working\x2C and\n   * whichever answers first wins. GET with `data=` is accepted by all\n   * mirrors and avoids the redirect problems of the old POST form.\n   * Returns an Array of elements with a non-enumerable `.meta` on it.\n   */\n  function overpassOnce(endpoint\x2C encodedQuery\x2C timeoutMs) {\n    const ctrl = new AbortController();\n    const timer = setTimeout(() => ctrl.abort()\x2C timeoutMs);\n    const separator = endpoint.includes('?') ? '&' : '?';\n\n    return fetch(`${endpoint}${separator}data=${encodedQuery}`\x2C {\n      method: 'GET'\x2C\n      mode: 'cors'\x2C\n      signal: ctrl.signal\x2C\n      cache: 'no-store'\x2C\n      headers: { Accept: 'application/json' }\x2C\n    })\n      .then(async (response) => {\n        if (response.status === 429 || response.status === 504) {\n          throw new Error(`Overpass is busy (${response.status}).`);\n        }\n        if (!response.ok) {\n          throw new Error(`Overpass HTTP ${response.status}.`);\n        }\n        const text = await response.text();\n        try {\n          return JSON.parse(text);\n        } catch {\n          throw new Error(\n            'Overpass returned an invalid response. Please try again.'\n          );\n        }\n      })\n      .finally(() => clearTimeout(timer));\n  }\n\n  /**\n   * v1.0.70 retry ladder: mirrors sometimes answer with a transiently EMPTY\n   * result (or fail outright) while an immediate retry succeeds. Run the\n   * hedged mirror round once; if it yields nothing\x2C back off briefly and\n   * re-query the primary before letting the caller conclude 'not found'.\n   * - attemptAll()  -> Promise<elements[]> (hedged mirrors; may resolve empty)\n   * - queryPrimary()-> Promise<elements[]> (single primary re-query)\n   * Resolves empty ONLY when every attempt agreed there is nothing there.\n   */\n  async function overpassRetryLadder({\n    attemptAll\x2C\n    queryPrimary\x2C\n    backoffMs = OVERPASS_RETRY_BACKOFF_MS\x2C\n    sleep = osmSleep\x2C\n  }) {\n    let firstError = null;\n    try {\n      const els = await attemptAll();\n      if (els.length) return els;\n    } catch (err) {\n      firstError = err;\n    }\n    console.warn(\n      'Overpass: ' +\n        (firstError\n          ? `all mirrors failed (${firstError.message})`\n          : 'all mirrors returned an empty result') +\n        ` \u2014 retrying primary once after ${backoffMs}ms`\n    );\n    await sleep(backoffMs);\n    try {\n      const els = await queryPrimary();\n      if (els.length) {\n        els.meta = Object.assign({}\x2C els.meta || {}\x2C { retried: true });\n      }\n      return els; // authoritative empty is a valid "not found"\n    } catch (retryError) {\n      throw firstError || retryError;\n    }\n  }\n\n  async function overpassFetch(query\x2C opts = {}) {\n    const {\n      timeoutMs = 45000\x2C\n      cacheKey = null\x2C\n      cacheTtlMs = OSM_CACHE_TTL_MS\x2C\n    } = opts;\n\n    if (cacheKey) {\n      const hit = osmCacheGet(cacheKey);\n      if (hit && Array.isArray(hit)) {\n        hit.meta = { cached: true\x2C endpoint: 'cache' };\n        return hit;\n      }\n    }\n\n    const encodedQuery = encodeURIComponent(query.trim());\n\n    // Hedged mirror round (unchanged behavior)\x2C wrapped so the retry\n    // ladder can re-query the primary if the round comes back empty.\n    const attemptMirrors = () =>\n      new Promise((resolve\x2C reject) => {\n      const total = OVERPASS_ENDPOINTS.length;\n      let nextIndex = 0;\n      let failures = 0;\n      let settled = false;\n      let hedgeTimer = null;\n      let lastError = null;\n\n      const finish = (fn\x2C value) => {\n        if (settled) return;\n        settled = true;\n        clearTimeout(hedgeTimer);\n        fn(value);\n      };\n\n      const launchNext = () => {\n        if (settled || nextIndex >= total) return;\n        const endpoint = OVERPASS_ENDPOINTS[nextIndex++];\n\n        clearTimeout(hedgeTimer);\n        if (nextIndex < total) {\n          hedgeTimer = setTimeout(launchNext\x2C OVERPASS_HEDGE_MS);\n        }\n\n        overpassOnce(endpoint\x2C encodedQuery\x2C timeoutMs).then(\n          (json) => {\n            const elements = Array.isArray(json.elements)\n              ? json.elements\n              : [];\n            elements.meta = {\n              endpoint\x2C\n              cached: false\x2C\n              remark: json.remark || null\x2C\n            };\n            if (cacheKey && elements.length) {\n              osmCacheSet(cacheKey\x2C elements\x2C cacheTtlMs);\n            }\n            finish(resolve\x2C elements);\n          }\x2C\n          (error) => {\n            lastError = error;\n            failures += 1;\n            console.warn(`Overpass failed at ${endpoint}`\x2C error);\n            if (nextIndex < total) launchNext();\n            else if (failures >= total) {\n              finish(\n                reject\x2C\n                lastError || new Error('All Overpass endpoints failed')\n              );\n            }\n          }\n        );\n      };\n\n      launchNext();\n      });\n\n    const queryPrimary = async () => {\n      const endpoint = OVERPASS_ENDPOINTS[0];\n      const json = await overpassOnce(endpoint\x2C encodedQuery\x2C timeoutMs);\n      const elements = Array.isArray(json.elements) ? json.elements : [];\n      elements.meta = {\n        endpoint\x2C\n        cached: false\x2C\n        remark: json.remark || null\x2C\n        retried: true\x2C\n      };\n      if (cacheKey && elements.length) {\n        osmCacheSet(cacheKey\x2C elements\x2C cacheTtlMs);\n      }\n      return elements;\n    };\n\n    return overpassRetryLadder({\n      attemptAll: attemptMirrors\x2C\n      queryPrimary\x2C\n      backoffMs: OVERPASS_RETRY_BACKOFF_MS\x2C\n    });\n  }\n\n  /* ================= OSM geometry helpers (planar\x2C lng convention) ================= */\n\n  const OSM_M_PER_DEG = 111320;\n  const OSM_YD_PER_M = 1.0936133;\n\n  function osmXY(lat\x2C lng\x2C refLat) {\n    return {\n      x: lng * OSM_M_PER_DEG * Math.cos((refLat * Math.PI) / 180)\x2C\n      y: lat * OSM_M_PER_DEG\x2C\n    };\n  }\n\n  function osmDistM(a\x2C b) {\n    const refLat = (a.lat + b.lat) / 2;\n    const pa = osmXY(a.lat\x2C a.lng\x2C refLat);\n    const pb = osmXY(b.lat\x2C b.lng\x2C refLat);\n    return Math.hypot(pa.x - pb.x\x2C pa.y - pb.y);\n  }\n\n  const osmDistYds = (a\x2C b) => osmDistM(a\x2C b) * OSM_YD_PER_M;\n\n  // Overpass geometry nodes are {lat\x2C lon}. Normalize to {lat\x2C lng}.\n  function osmGeomLatLng(g) {\n    return { lat: g.lat\x2C lng: g.lon != null ? g.lon : g.lng };\n  }\n\n  function osmPathLatLng(el) {\n    if (!el || !Array.isArray(el.geometry) || el.geometry.length < 2) return null;\n    return el.geometry.map(osmGeomLatLng);\n  }\n\n  function osmPathLengthYds(path) {\n    let m = 0;\n    for (let i = 1; i < path.length; i++) m += osmDistM(path[i - 1]\x2C path[i]);\n    return m * OSM_YD_PER_M;\n  }\n\n  // Closed-ring vertex list for areas (way\x2C or first outer member of a relation).\n  function osmRing(el) {\n    if (!el) return null;\n    if (el.type === 'way' && Array.isArray(el.geometry) && el.geometry.length >= 3) {\n      const pts = el.geometry.map(osmGeomLatLng);\n      const a = pts[0];\n      const b = pts[pts.length - 1];\n      if (Math.abs(a.lat - b.lat) < 1e-9 && Math.abs(a.lng - b.lng) < 1e-9) pts.pop();\n      return pts;\n    }\n    if (el.type === 'relation' && Array.isArray(el.members)) {\n      const outer = el.members.find(\n        (m) => m.role === 'outer' && Array.isArray(m.geometry)\n      );\n      if (outer) return osmRing({ type: 'way'\x2C geometry: outer.geometry });\n    }\n    return null;\n  }\n\n  // Replaces the old osmFeaturePoint. Node -> its coords; area -> ring centroid;\n  // last resort -> element.center (only for nearby-course candidates).\n  function osmFeaturePoint(element) {\n    if (!element) return null;\n    const eLng = element.lon != null ? element.lon : element.lng;\n    if (Number.isFinite(element.lat) && Number.isFinite(eLng)) {\n      return { lat: Number(element.lat)\x2C lng: Number(eLng) };\n    }\n    const ring = osmRing(element);\n    if (ring && ring.length) {\n      let la = 0;\n      let ln = 0;\n      ring.forEach((p) => {\n        la += p.lat;\n        ln += p.lng;\n      });\n      return { lat: la / ring.length\x2C lng: ln / ring.length };\n    }\n    if (element.center && Number.isFinite(element.center.lat)) {\n      const cLng =\n        element.center.lon != null ? element.center.lon : element.center.lng;\n      return { lat: Number(element.center.lat)\x2C lng: Number(cLng) };\n    }\n    return null;\n  }\n\n  function osmPointInRing(pt\x2C ring) {\n    const refLat = pt.lat;\n    const p = osmXY(pt.lat\x2C pt.lng\x2C refLat);\n    let inside = false;\n    for (let i = 0\x2C j = ring.length - 1; i < ring.length; j = i++) {\n      const a = osmXY(ring[i].lat\x2C ring[i].lng\x2C refLat);\n      const b = osmXY(ring[j].lat\x2C ring[j].lng\x2C refLat);\n      if (\n        a.y > p.y !== b.y > p.y &&\n        p.x < ((b.x - a.x) * (p.y - a.y)) / (b.y - a.y) + a.x\n      ) {\n        inside = !inside;\n      }\n    }\n    return inside;\n  }\n\n  // Min distance from a point to a polyline\x2C meters. Used to filter hazards.\n  function osmDistPointToPathM(pt\x2C path) {\n    const refLat = pt.lat;\n    const p = osmXY(pt.lat\x2C pt.lng\x2C refLat);\n    let best = Infinity;\n    for (let i = 1; i < path.length; i++) {\n      const a = osmXY(path[i - 1].lat\x2C path[i - 1].lng\x2C refLat);\n      const b = osmXY(path[i].lat\x2C path[i].lng\x2C refLat);\n      const dx = b.x - a.x;\n      const dy = b.y - a.y;\n      const len2 = dx * dx + dy * dy || 1e-9;\n      let t = ((p.x - a.x) * dx + (p.y - a.y) * dy) / len2;\n      t = Math.max(0\x2C Math.min(1\x2C t));\n      best = Math.min(\n        best\x2C\n        Math.hypot(p.x - (a.x + t * dx)\x2C p.y - (a.y + t * dy))\n      );\n    }\n    return best;\n  }\n\n  // ============================================================\n  //  OSM STANDARD BASEMAP (Option A) \u2014 worldwide\x2C no key\x2C no account\n  //  Themed-vector (Option C) will later swap this base layer.\n  // ============================================================\n  (() => {\n    function buildOsmStd() {\n      return L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png'\x2C {\n        attribution:\n          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'\x2C\n        maxZoom: 21\x2C\n        maxNativeZoom: 19\x2C\n        crossOrigin: true\x2C\n        updateWhenIdle: true\x2C\n        keepBuffer: 2\x2C\n        className: 'osm-std-tiles'\x2C\n      });\n    }\n    function ensureLayer() {\n      if (!state.mapReady || !state.layers || state.layers.osmstd) return;\n      state.layers.osmstd = buildOsmStd();\n    }\n\n    // Reassign LOCAL bindings (all one closure \u2014 no window.* needed).\n    const _initMap = initMap;\n    initMap = function () {\n      _initMap();\n      ensureLayer();\n    };\n\n    const _setMapLayer = setMapLayer;\n    setMapLayer = function (name\x2C silent) {\n      if (name !== 'osmstd') return _setMapLayer(name\x2C silent);\n      ensureLayer();\n      if (!state.mapReady) return;\n      const all = [state.layers.satellite\x2C state.layers.osmstd];\n      all.forEach((l) => {\n        if (l && state.map.hasLayer(l)) state.map.removeLayer(l);\n      });\n      state.layers.osmstd.addTo(state.map);\n      els.rangeWrap.classList.remove('is-sat');\n      state.prefs.mapLayer = 'osmstd';\n      save('caddy:prefs'\x2C state.prefs);\n      updateAimColor();\n      restyleShotLines();\n      if (state.loc && state.target) {\n        renderDispersionZone(\n          initialBearingDeg(state.loc\x2C state.target)\x2C\n          state.clubs.find((c) => c.id === state.lastRecClubId) || null\n        );\n      }\n      ['lineCasing'\x2C 'lineHalo'\x2C 'line'\x2C 'target'\x2C 'user'].forEach((k) => {\n        if (state.markers[k] && state.markers[k].bringToFront)\n          state.markers[k].bringToFront();\n      });\n    };\n\n    const _updateAimColor = updateAimColor;\n    updateAimColor = function () {\n      if (state.prefs.mapLayer === 'osmstd') {\n        document.documentElement.style.setProperty('--aim'\x2C '#1677ff');\n        return;\n      }\n      _updateAimColor();\n    };\n\n    const _isImagery = isImagery;\n    isImagery = function () {\n      if (state.prefs.mapLayer === 'osmstd') return false;\n      return _isImagery();\n    };\n  })();\n  /* ============================================================\n     PREMIUM MAP UI \u2014 wind detail popover\x2C distance rings\x2C live\n     shot line\x2C and the draggable shot-start flag.\n  ============================================================ */\n\n  /* ---------- Wind detail popover ---------- */\n  function windPopIsOpen() {\n    return !!els.windPop && !els.windPop.hidden;\n  }\n  function renderWindPop() {\n    if (!els.windPop || !els.windPopSpeed) return;\n    const w = getWeatherOrNeutral();\n    const hasLive = !!state.context.weather;\n    const towardDeg = (w.windFromDeg + 180) % 360;\n    const needle = $('windPopNeedle');\n    if (needle) needle.style.transform = `rotate(${towardDeg}deg)`;\n    els.windPopSpeed.textContent = hasLive ? `${fmt(w.windMph)} mph` : '\u2014';\n    els.windPopDir.textContent = hasLive\n      ? `from ${bearingToCompass(w.windFromDeg)}`\n      : 'no live wind';\n\n    let shot;\n    if (hasLive && w.windMph >= 1 && state.lastCalc) {\n      const c = state.lastCalc;\n      const h = c.headwindMph;\n      const x = c.crosswindMph;\n      if (Math.abs(h) >= Math.abs(x)) {\n        const amt = Math.round(Math.abs(c.windAdjYd));\n        shot = h >= 0\n          ? `~${amt} yd into you on this line.`\n          : `~${amt} yd helping on this line.`;\n      } else if (Math.abs(c.aimYd) > 0) {\n        shot = `~${Math.round(Math.abs(x))} mph across from the ${x > 0 ? 'right' : 'left'} \u2014 start it ${Math.abs(c.aimYd)} yd ${c.aimYd > 0 ? 'right' : 'left'}.`;\n      } else {\n        shot = `~${Math.round(Math.abs(x))} mph across \u2014 aim correction is minimal.`;\n      }\n    } else if (!hasLive) {\n      shot = 'No live wind \u2014 using standard conditions.';\n    } else {\n      shot = 'Calm conditions \u2014 play the number.';\n    }\n    els.windPopShot.textContent = hasLive || state.lastCalc\n      ? `This shot: ${shot}`\n      : 'Select a target to see what the wind does to this shot.';\n\n    const bits = [];\n    if (hasLive && Number.isFinite(w.gustMph) && w.gustMph > w.windMph + 2)\n      bits.push(`gusts to ${Math.round(w.gustMph)} mph`);\n    if (state.context.weatherTs)\n      bits.push(`as of ${new Date(state.context.weatherTs).toLocaleTimeString()}`);\n    else\n      bits.push('standard conditions');\n    if (state.context.offlineWeather) bits.push('cached');\n    els.windPopMeta.textContent = bits.join(' \xb7 ');\n  }\n  function openWindPop() {\n    if (!els.windPop) return;\n    renderWindPop();\n    els.windPopScrim.hidden = false;\n    els.windPop.hidden = false;\n    requestAnimationFrame(() => {\n      els.windPopScrim.classList.add('open');\n      els.windPop.classList.add('open');\n    });\n    closeAdvice();\n    haptic(6);\n  }\n  function closeWindPop() {\n    if (!els.windPop || els.windPop.hidden) return;\n    els.windPopScrim.classList.remove('open');\n    els.windPop.classList.remove('open');\n    setTimeout(() => {\n      if (!els.windPop.classList.contains('open')) {\n        els.windPop.hidden = true;\n        els.windPopScrim.hidden = true;\n      }\n    }\x2C reduceMotion ? 0 : 240);\n  }\n  function initWindPop() {\n    if (!els.windPill) return;\n    els.windPill.addEventListener('click'\x2C () => {\n      if (windPopIsOpen()) closeWindPop();\n      else openWindPop();\n    });\n    els.windPill.addEventListener('keydown'\x2C (e) => {\n      if (e.key === 'Enter' || e.key === ' ') {\n        e.preventDefault();\n        if (windPopIsOpen()) closeWindPop();\n        else openWindPop();\n      }\n    });\n    if (els.windPopClose) els.windPopClose.addEventListener('click'\x2C closeWindPop);\n    if (els.windPopScrim) els.windPopScrim.addEventListener('click'\x2C closeWindPop);\n    document.addEventListener('keydown'\x2C (e) => {\n      if (e.key === 'Escape' && windPopIsOpen()) closeWindPop();\n    });\n  }\n\n  /* ---------- Live shot line + draggable start flag ---------- */\n  const START_DRAG_MIN_YD = 2;\n  function startFlagIcon() {\n    return L.divIcon({\n      className: ''\x2C\n      html: `<div class="start-flag"><svg viewBox="0 0 24 24" fill="none"><path d="M12 21V4.5" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round"/><path d="M12 4.5h8.5l-3 3.2 3 3.2H12z" fill="#f5a623" stroke="#ffffff" stroke-width="1.1" stroke-linejoin="round"/></svg></div>`\x2C\n      iconSize: [24\x2C 24]\x2C\n      iconAnchor: [12\x2C 22]\x2C\n    });\n  }\n  function pendingStartMovedYd() {\n    const p = state.roundSession && state.roundSession.pending;\n    if (!p || !p.origStartPt) return 0;\n    return haversineMeters(p.origStartPt\x2C p.startPt) * M_TO_YD;\n  }\n  function syncResetStartChip() {\n    if (!els.roundResetStart) return;\n    els.roundResetStart.hidden = pendingStartMovedYd() < START_DRAG_MIN_YD;\n  }\n  function pendingLineLabelIcon(text) {\n    return L.divIcon({\n      className: ''\x2C\n      html: `<div class="pending-line-label">${text}</div>`\x2C\n      iconSize: [56\x2C 26]\x2C\n      iconAnchor: [28\x2C 13]\x2C\n    });\n  }\n  function updatePendingLine() {\n    const p = state.roundSession && state.roundSession.pending;\n    const ok = !!(p && state.mapReady && state.map && state.loc);\n    if (!ok) {\n      ['pendingLine'\x2C 'pendingLabel'].forEach((k) => {\n        if (state.markers[k] && state.map) {\n          try { state.map.removeLayer(state.markers[k]); } catch { }\n        }\n        state.markers[k] = null;\n      });\n      return;\n    }\n    const pts = [\n      [p.startPt.lat\x2C p.startPt.lng]\x2C\n      [state.loc.lat\x2C state.loc.lng]\x2C\n    ];\n    if (!state.markers.pendingLine)\n      state.markers.pendingLine = L.polyline(pts\x2C {\n        pane: 'shotLinePane'\x2C\n        color: '#f5a623'\x2C\n        weight: 4\x2C\n        opacity: 0.9\x2C\n        lineCap: 'round'\x2C\n        interactive: false\x2C\n      }).addTo(state.map);\n    else state.markers.pendingLine.setLatLngs(pts);\n\n    const d = haversineMeters(p.startPt\x2C state.loc) * M_TO_YD;\n    const mid = midpointGeodesic(p.startPt\x2C state.loc);\n    const icon = pendingLineLabelIcon(`${Math.round(d)} yd`);\n    if (!state.markers.pendingLabel)\n      state.markers.pendingLabel = L.marker([mid.lat\x2C mid.lng]\x2C {\n        icon\x2C\n        interactive: false\x2C\n        zIndexOffset: 880\x2C\n      }).addTo(state.map);\n    else {\n      state.markers.pendingLabel.setLatLng([mid.lat\x2C mid.lng]);\n      state.markers.pendingLabel.setIcon(icon);\n    }\n    if (els.roundLiveV && !els.roundLive.hidden)\n      els.roundLiveV.textContent = Math.round(d);\n  }\n  function renderPendingShot() {\n    const p = state.roundSession && state.roundSession.pending;\n    if (!p || !state.mapReady || !state.map) {\n      clearPendingShot();\n      return;\n    }\n    if (!p.origStartPt)\n      p.origStartPt = { lat: p.startPt.lat\x2C lng: p.startPt.lng };\n\n    if (!state.markers.startFlag) {\n      state.markers.startFlag = L.marker([p.startPt.lat\x2C p.startPt.lng]\x2C {\n        icon: startFlagIcon()\x2C\n        draggable: true\x2C\n        zIndexOffset: 860\x2C\n      }).addTo(state.map);\n      state.markers.startFlag.on('drag'\x2C () => {\n        const ll = state.markers.startFlag.getLatLng();\n        p.startPt = { lat: ll.lat\x2C lng: ll.lng };\n        updatePendingLine();\n      });\n      state.markers.startFlag.on('dragend'\x2C () => {\n        const ll = state.markers.startFlag.getLatLng();\n        p.startPt = { lat: ll.lat\x2C lng: ll.lng };\n        saveRoundSession();\n        updatePendingLine();\n        syncResetStartChip();\n        haptic(6);\n      });\n    } else {\n      state.markers.startFlag.setLatLng([p.startPt.lat\x2C p.startPt.lng]);\n    }\n    updatePendingLine();\n    syncResetStartChip();\n  }\n  function clearPendingShot() {\n    ['pendingLine'\x2C 'pendingLabel'\x2C 'startFlag'].forEach((k) => {\n      if (state.markers[k] && state.map) {\n        try { state.map.removeLayer(state.markers[k]); } catch { }\n      }\n      state.markers[k] = null;\n    });\n    if (els.roundResetStart) els.roundResetStart.hidden = true;\n  }\n  function resetPendingStart() {\n    const p = state.roundSession && state.roundSession.pending;\n    if (!p || !p.origStartPt) return;\n    p.startPt = { lat: p.origStartPt.lat\x2C lng: p.origStartPt.lng };\n    saveRoundSession();\n    renderPendingShot();\n    haptic(8);\n  }\n\n  /* ---------- Wire everything up ---------- */\n  initWindPop();\n  if (els.roundResetStart)\n    els.roundResetStart.addEventListener('click'\x2C resetPendingStart);\n\n  // Theme: 'dark' is the house default; Auto follows the OS. Persisted so\n  // the app opens the way the player left it.\n  if (!['light'\x2C 'dark'\x2C 'auto'].includes(state.prefs.theme)) {\n    state.prefs.theme = 'dark';\n  }\n  save('caddy:prefs'\x2C state.prefs);\n\n  // React when the system flips under an Auto setting.\n  if (THEME_MEDIA && THEME_MEDIA.addEventListener) {\n    THEME_MEDIA.addEventListener('change'\x2C (e) => {\n      systemDark = e.matches;\n      applyPrefs();\n    });\n  }\n\n  // ============================================================\n  //  BLOCK 18 \u2014 PREP ADD-ON BRIDGE (read-only API for prep.js)\n  //  The premium Prep studio lives in prep.js and reuses THIS closure's\n  //  physics + planner data so every number matches the rest of the app.\n  //  Strictly additive: nothing here mutates app state\x2C and deleting this\n  //  block restores the exact pre-bridge behavior.\n  // ============================================================\n  window.CaddyPrep = {\n    v: 1\x2C\n    playsLike\x2C\n    recommendClub\x2C\n    clubsDesc: () => sortedClubsDesc()\x2C\n    weather: () => getWeatherOrNeutral()\x2C\n    elevation: () => getElevationOrNeutral()\x2C\n    locLat: () =>\n      state.loc && Number.isFinite(state.loc.lat) ? state.loc.lat : STD_LAT\x2C\n    holeInfo(number) {\n      const course = getPlannerCourse();\n      if (!course) return null;\n      const hole = (course.holes || [])[number - 1];\n      if (!hole) return null;\n      const yd = planHoleYardage(hole);\n      const tee = hole.teePoint;\n      const green = hole.greenCenter;\n      const rawHz = Array.isArray(hole.hazards) ? hole.hazards : [];\n      // along/cross are the existing tee\u2192green projections (read-only);\n      // prep.js draws the hole diagram from these instead of re-deriving.\n      const hazards = planHazardsFor(hole).map((hz\x2C i) => {\n        const raw = rawHz[i];\n        let along = null\x2C cross = null;\n        if (\n          tee && green && raw &&\n          Number.isFinite(raw.lat) && Number.isFinite(raw.lng)\n        ) {\n          along = alongTrackYd(tee\x2C green\x2C raw);\n          cross = crossTrackYd(tee\x2C green\x2C raw);\n        }\n        return { type: hz.type\x2C label: hz.label\x2C sub: hz.sub\x2C along\x2C cross };\n      });\n      return {\n        number\x2C\n        courseName: course.name || 'Course'\x2C\n        par: hole.par || inferParFromYards(yd)\x2C\n        yards: yd\x2C\n        strokeIndex: hole.strokeIndex || null\x2C\n        hazards\x2C\n        green: planGreenInfo(hole)\x2C\n        // Green Maps: raw lat/lng for the elevation service (read-only).\n        teeLatLng: hole.teePoint\n          ? { lat: hole.teePoint.lat\x2C lng: hole.teePoint.lng } : null\x2C\n        greenLatLng: hole.greenCenter\n          ? { lat: hole.greenCenter.lat\x2C lng: hole.greenCenter.lng } : null\x2C\n        bearing:\n          hole.teePoint && hole.greenCenter\n            ? initialBearingDeg(hole.teePoint\x2C hole.greenCenter)\n            : null\x2C\n      };\n    }\x2C\n    // Pure bag sequence for a hole length. Same helper the planner uses;\n    // no writes\x2C no UI. null when yards or bag are missing.\n    clubSequence(totalYd) {\n      return planClubSequence(totalYd);\n    }\x2C\n    haptic\x2C\n  };\n\n  bootstrap();\n})();\n
