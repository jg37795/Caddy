script-source,133,C:\\Users\\wendy\\Desktop\\Caddy\\Caddy-main\\.gtds\\prep_tap_probe2.js,/* prep_tap_probe2.js \u2014 control: does the loop hang WITHOUT the tap?\n   Heartbeats every 200ms reveal when the loop stops servicing timers. */\n'use strict';\nconst fs = require('fs');\nconst path = require('path');\nconst { JSDOM } = require('jsdom');\n\nconst html = fs.readFileSync(path.join(__dirname\x2C '..'\x2C 'index.html')\x2C 'utf-8');\nconst dom = new JSDOM(html\x2C {\n  url: 'https://caddy.local/index.html'\x2C\n  runScripts: 'outside-only'\x2C\n  pretendToBeVisual: true\x2C\n});\nconst { window } = dom;\nglobal.window = window;\nglobal.document = window.document;\nglobal.navigator = window.navigator;\nglobal.location = window.location;\nglobal.localStorage = window.localStorage;\nglobal.HTMLElement = window.HTMLElement;\nglobal.SVGElement = window.SVGElement;\nglobal.Element = window.Element;\nglobal.Node = window.Node;\nglobal.MutationObserver = window.MutationObserver;\nglobal.getComputedStyle = window.getComputedStyle;\nglobal.requestAnimationFrame = (f) => window.requestAnimationFrame(f);\nglobal.alert = () => {};\nglobal.confirm = () => false;\nglobal.fetch = async () => { throw new Error('offline'); };\nwindow.fetch = global.fetch;\nif (!window.crypto) window.crypto = require('crypto').webcrypto;\n\nconst holes = [];\nfor (let i = 1; i <= 18; i++) {\n  holes.push({\n    number: i\x2C source: 'openstreetmap'\x2C par: 4\x2C yards: 320 + i * 9\x2C\n    teePoint: { lat: 41.5901 + i * 0.0007\x2C lng: -93.8831 + i * 0.0006 }\x2C\n    greenCenter: { lat: 41.5901 + i * 0.0007 + 0.0052\x2C lng: -93.8831 + i * 0.0006 + 0.0034 }\x2C\n    front: 320 + i * 9 - 12\x2C back: 320 + i * 9 + 12\x2C\n    hazards: []\x2C greenDepthYds: 24\x2C\n  });\n}\nwindow.localStorage.setItem('caddy:courseProfiles:v1'\x2C JSON.stringify([\n  { id: 'local:test1'\x2C name: 'Freeze Test GC'\x2C teeName: 'Blue'\x2C\n    source: 'openstreetmap'\x2C location: { lat: 41.593\x2C lng: -93.882 }\x2C\n    updatedAt: Date.now()\x2C holesCount: 18\x2C holes }]));\nwindow.localStorage.setItem('caddy:onboarded'\x2C '1');\n\nwindow.eval(fs.readFileSync(path.join(__dirname\x2C '..'\x2C 'app.js')\x2C 'utf-8'));\n\nlet beats = 0;\nconst hb = setInterval(() => { beats++; process.stdout.write(beats % 10 === 0 ? 'B' : '.'); }\x2C 200);\n\nsetTimeout(() => {\n  window.eval(fs.readFileSync(path.join(__dirname\x2C '..'\x2C 'prep.js')\x2C 'utf-8'));\n  const sel = window.document.getElementById('planCourseSelect');\n  sel.value = 'local:test1';\n  sel.dispatchEvent(new window.Event('change'));\n  const rows = window.document.querySelectorAll('.plan-hole-row');\n  console.log('\\n[probe] rows'\x2C rows.length\x2C '\u2014 tapping hole 5 NOW');\n  const t0 = Date.now();\n  rows[4].click();\n  console.log(`\\n[probe] click() returned after ${Date.now() - t0}ms`);\n\n  setTimeout(() => {\n    console.log('\\n[probe] T+1200ms \u2014 loop alive\x2C beats ='\x2C beats);\n    // Try a SECOND tap (the real killer?)\n    const t1 = Date.now();\n    rows[4].click();\n    console.log(`[probe] second click returned after ${Date.now() - t1}ms`);\n    setTimeout(() => {\n      console.log('[probe] T+2400ms \u2014 loop alive\x2C beats ='\x2C beats);\n      clearInterval(hb);\n      console.log('\\nVERDICT: no hang reproduced in jsdom');\n      process.exit(0);\n    }\x2C 1200);\n  }\x2C 1200);\n}\x2C 800);\n\nsetTimeout(() => {\n  console.log('\\n[probe] watchdog: loop blocked >8s. beats ='\x2C beats);\n  process.exit(2);\n}\x2C 9000);\n
