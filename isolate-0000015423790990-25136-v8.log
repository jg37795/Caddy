stener('pointermove'\x2C (e) => {\n      if (!dragging) return;\n      const dy = e.clientY - startY;\n      moved = Math.max(moved\x2C Math.abs(dy));\n      const now = performance.now();\n      vel = (e.clientY - lastY) / Math.max(1\x2C now - lastT);\n      lastY = e.clientY;\n      lastT = now;\n      setY(startT + dy\x2C false);\n      setReveal(curY);\n      // When auto-centering\x2C pan the dot live so it tracks the sheet the\n      // same way the pills fade \u2014 no end-of-drag jump.\n      followFrameDuringDrag();\n    });\n    function end(e) {\n      if (!dragging) return;\n      dragging = false;\n      try {\n        drag.releasePointerCapture(e.pointerId);\n      } catch { }\n      if (moved < 5) {\n        document.body.removeAttribute('data-dragging');\n        sheet.style.removeProperty('--fcb-reveal');\n        sheet.style.removeProperty('--detail-reveal');\n        wrap.style.removeProperty('--detail-reveal');\n        wrap.style.removeProperty('--rx-hero-fade');\n        cycleUp();\n        return;\n      }\n      const projected = clmp(curY + vel * 160\x2C 0\x2C maxY);\n      snapTo(nearestName(projected)\x2C true);\n    }\n    drag.addEventListener('pointerup'\x2C end);\n    drag.addEventListener('pointercancel'\x2C end);\n    drag.addEventListener('keydown'\x2C (e) => {\n      if (e.key === 'Enter' || e.key === ' ') {\n        e.preventDefault();\n        cycleUp();\n      } else if (e.key === 'ArrowUp') {\n        e.preventDefault();\n        const cur = document.body.getAttribute('data-detent') || 'collapsed';\n        snapTo(cur === 'collapsed' ? 'half' : 'full'\x2C true);\n      } else if (e.key === 'ArrowDown') {\n        e.preventDefault();\n        const cur = document.body.getAttribute('data-detent') || 'collapsed';\n        snapTo(cur === 'full' ? 'half' : 'collapsed'\x2C true);\n      }\n    });\n    window.addEventListener('resize'\x2C () => requestAnimationFrame(measure));\n    window.addEventListener('orientationchange'\x2C () =>\n      setTimeout(measure\x2C 250)\n    );\n    if (window.visualViewport) {\n      window.visualViewport.addEventListener('resize'\x2C () =>\n        requestAnimationFrame(measure)\n      );\n    }\n\n    state.sheet = {\n      measure\x2C\n      expand: () => snapTo('full'\x2C true)\x2C\n      half: () => snapTo('half'\x2C true)\x2C\n      collapse: () => snapTo('collapsed'\x2C true)\x2C\n    };\n    // Reopen at the detent last used (premium apps remember your state).\n    applyDetentAttr(\n      ['collapsed'\x2C 'half'\x2C 'full'].includes(state.prefs.sheetDetent)\n        ? state.prefs.sheetDetent\n        : 'collapsed'\n    );\n    requestAnimationFrame(() => requestAnimationFrame(measure));\n  }\n\n  // Measure ONLY the sheet's actual covered band\x2C from its visual (transformed) top.\n  function bottomObstructionPx() {\n    const mapEl = state.map && state.map.getContainer();\n    const sheetEl = els.sheet;\n    if (!mapEl || !sheetEl) return 0;\n    const mapR = mapEl.getBoundingClientRect();\n    const shR = sheetEl.getBoundingClientRect();\n    const covered = mapR.bottom - shR.top;\n    return clamp(covered\x2C 0\x2C Math.max(0\x2C mapR.height - 120));\n  }\n  // Keep the user pinned at the screen pixel captured when locking.\n  function holdLockedView(latlng\x2C animate) {\n    if (!state.map || !state.lockOffset) return;\n    const z = state.map.getZoom();\n    const size = state.map.getSize();\n    // Desired screen point for the user = center + saved offset.\n    const desiredPt = L.point(\n      size.x / 2 + state.lockOffset.x\x2C\n      size.y / 2 + state.lockOffset.y\n    );\n    const userPt = state.map.project([latlng.lat\x2C latlng.lng]\x2C z);\n    // Map center must shift so the user lands on desiredPt.\n    const centerPt = userPt.subtract(\n      desiredPt.subtract(L.point(size.x / 2\x2C size.y / 2))\n    );\n    state.map.setView(state.map.unproject(centerPt\x2C z)\x2C z\x2C { animate });\n  }\n  // Center `latlng` in the middle of the visible (un-obstructed) band.\n  function centerMapOn(latlng\x2C zoom\x2C animate) {\n    if (!state.map) return;\n    const z = zoom != null ? zoom : state.map.getZoom();\n    const dy = bottomObstructionPx() / 2;\n    const pt = state.map.project([latlng.lat\x2C latlng.lng]\x2C z);\n    const shifted = L.point(pt.x\x2C pt.y + dy);\n    state.map.setView(state.map.unproject(shifted\x2C z)\x2C z\x2C { animate });\n  }\n  function attachPressGesture(\n    el\x2C\n    { onTap\x2C onLongPress\x2C delay = 550\x2C moveTol = 10 }\n  ) {\n    let id = null\x2C\n      sx = 0\x2C\n      sy = 0\x2C\n      timer = null\x2C\n      moved = false\x2C\n      longFired = false;\n    let suppressUntil = 0;\n    const clear = () => {\n      clearTimeout(timer);\n      timer = null;\n    };\n\n    el.addEventListener('pointerdown'\x2C (e) => {\n      if (id !== null) return;\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\n      id = e.pointerId;\n      sx = e.clientX;\n      sy = e.clientY;\n      moved = false;\n      longFired = false;\n      try {\n        el.setPointerCapture(id);\n      } catch { }\n      timer = setTimeout(() => {\n        if (moved) return;\n        longFired = true;\n        suppressUntil = Date.now() + 700;\n        haptic(30);\n        onLongPress && onLongPress();\n      }\x2C delay);\n    });\n    el.addEventListener('pointermove'\x2C (e) => {\n      if (e.pointerId !== id || moved) return;\n      if (Math.hypot(e.clientX - sx\x2C e.clientY - sy) > moveTol) {\n        moved = true;\n        clear();\n      }\n    });\n    const finish = (e\x2C fireTap) => {\n      if (e.pointerId !== id) return;\n      clear();\n      try {\n        el.releasePointerCapture(id);\n      } catch { }\n      if (fireTap && !longFired && !moved) {\n        suppressUntil = Date.now() + 400;\n        onTap && onTap();\n      }\n      id = null;\n    };\n    el.addEventListener('pointerup'\x2C (e) => finish(e\x2C true));\n    el.addEventListener('pointercancel'\x2