n permuteDomain(domain\x2C allowSpecialUseDomain) {\n  const pubSuf = pubsuffix.getPublicSuffix(domain\x2C {\n    allowSpecialUseDomain: allowSpecialUseDomain\n  });\n\n  if (!pubSuf) {\n    return null;\n  }\n  if (pubSuf == domain) {\n    return [domain];\n  }\n\n  // Nuke trailing dot\n  if (domain.slice(-1) == ".") {\n    domain = domain.slice(0\x2C -1);\n  }\n\n  const prefix = domain.slice(0\x2C -(pubSuf.length + 1)); // ".example.com"\n  const parts = prefix.split(".").reverse();\n  let cur = pubSuf;\n  const permutations = [cur];\n  while (parts.length) {\n    cur = `${parts.shift()}.${cur}`;\n    permutations.push(cur);\n  }\n  return permutations;\n}\n\nexports.permuteDomain = permuteDomain;\n
