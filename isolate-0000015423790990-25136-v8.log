ue is the cube root of the value of this Decimal\x2C rounded to\x0d\n   * `precision` significant digits using rounding mode `rounding`.\x0d\n   *\x0d\n   *  cbrt(0)  =  0\x0d\n   *  cbrt(-0) = -0\x0d\n   *  cbrt(1)  =  1\x0d\n   *  cbrt(-1) = -1\x0d\n   *  cbrt(N)  =  N\x0d\n   *  cbrt(-I) = -I\x0d\n   *  cbrt(I)  =  I\x0d\n   *\x0d\n   * Math.cbrt(x) = (x < 0 ? -Math.pow(-x\x2C 1/3) : Math.pow(x\x2C 1/3))\x0d\n   *\x0d\n   */\x0d\n  P.cubeRoot = P.cbrt = function () {\x0d\n    var e\x2C m\x2C n\x2C r\x2C rep\x2C s\x2C sd\x2C t\x2C t3\x2C t3plusx\x2C\x0d\n      x = this\x2C\x0d\n      Ctor = x.constructor;\x0d\n\x0d\n    if (!x.isFinite() || x.isZero()) return new Ctor(x);\x0d\n    external = false;\x0d\n\x0d\n    // Initial estimate.\x0d\n    s = x.s * mathpow(x.s * x\x2C 1 / 3);\x0d\n\x0d\n     // Math.cbrt underflow/overflow?\x0d\n     // Pass x to Math.pow as integer\x2C then adjust the exponent of the result.\x0d\n    if (!s || Math.abs(s) == 1 / 0) {\x0d\n      n = digitsToString(x.d);\x0d\n      e = x.e;\x0d\n\x0d\n      // Adjust n exponent so it is a multiple of 3 away from x exponent.\x0d\n      if (s = (e - n.length + 1) % 3) n += (s == 1 || s == -2 ? '0' : '00');\x0d\n      s = mathpow(n\x2C 1 / 3);\x0d\n\x0d\n      // Rarely\x2C e may be one less than the result exponent value.\x0d\n      e = mathfloor((e + 1) / 3) - (e % 3 == (e < 0 ? -1 : 2));\x0d\n\x0d\n      if (s == 1 / 0) {\x0d\n        n = '5e' + e;\x0d\n      } else {\x0d\n        n = s.toExponential();\x0d\n        n = n.slice(0\x2C n.indexOf('e') + 1) + e;\x0d\n      }\x0d\n\x0d\n      r = new Ctor(n);\x0d\n      r.s = x.s;\x0d\n    } else {\x0d\n      r = new Ctor(s.toString());\x0d\n    }\x0d\n\x0d\n    sd = (e = Ctor.precision) + 3;\x0d\n\x0d\n    // Halley's method.\x0d\n    // TODO? Compare Newton's method.\x0d\n    for (;;) {\x0d\n      t = r;\x0d\n      t3 = t.times(t).times(t);\x0d\n      t3plusx = t3.plus(x);\x0d\n      r = divide(t3plusx.plus(x).times(t)\x2C t3plusx.plus(t3)\x2C sd 