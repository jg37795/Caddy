script-source,714,node:_tls_common,// Copyright Joyent\x2C Inc. and other Node contributors.\x0d\n//\x0d\n// Permission is hereby granted\x2C free of charge\x2C to any person obtaining a\x0d\n// copy of this software and associated documentation files (the\x0d\n// "Software")\x2C to deal in the Software without restriction\x2C including\x0d\n// without limitation the rights to use\x2C copy\x2C modify\x2C merge\x2C publish\x2C\x0d\n// distribute\x2C sublicense\x2C and/or sell copies of the Software\x2C and to permit\x0d\n// persons to whom the Software is furnished to do so\x2C subject to the\x0d\n// following conditions:\x0d\n//\x0d\n// The above copyright notice and this permission notice shall be included\x0d\n// in all copies or substantial portions of the Software.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C EXPRESS\x0d\n// OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\x0d\n// MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\x0d\n// NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM\x2C\x0d\n// DAMAGES OR OTHER LIABILITY\x2C WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR\x0d\n// OTHERWISE\x2C ARISING FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\x0d\n// USE OR OTHER DEALINGS IN THE SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst tls = require('tls');\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  JSONParse\x2C\x0d\n  ObjectCreate\x2C\x0d\n  StringPrototypeReplace\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_TLS_INVALID_PROTOCOL_VERSION\x2C\x0d\n    ERR_TLS_PROTOCOL_VERSION_CONFLICT\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  crypto: {\x0d\n    SSL_OP_CIPHER_SERVER_PREFERENCE\x2C\x0d\n    TLS1_VERSION\x2C\x0d\n    TLS1_1_VERSION\x2C\x0d\n    TLS1_2_VERSION\x2C\x0d\n    TLS1_3_VERSION\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('constants');\x0d\n\x0d\nconst {\x0d\n  validateInteger\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  configSecureContext\x2C\x0d\n} = require('internal/tls/secure-context');\x0d\n\x0d\nconst {\x0d\n  parseCertString\x2C\x0d\n} = require('internal/tls/parse-cert-string');\x0d\n\x0d\nfunction toV(which\x2C v\x2C def) {\x0d\n  if (v == null) v = def;\x0d\n  if (v === 'TLSv1') return TLS1_VERSION;\x0d\n  if (v === 'TLSv1.1') return TLS1_1_VERSION;\x0d\n  if (v === 'TLSv1.2') return TLS1_2_VERSION;\x0d\n  if (v === 'TLSv1.3') return TLS1_3_VERSION;\x0d\n  throw new ERR_TLS_INVALID_PROTOCOL_VERSION(v\x2C which);\x0d\n}\x0d\n\x0d\nconst {\x0d\n  SecureContext: NativeSecureContext\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nfunction SecureContext(secureProtocol\x2C secureOptions\x2C minVersion\x2C maxVersion) {\x0d\n  if (!(this instanceof SecureContext)) {\x0d\n    return new SecureContext(secureProtocol\x2C secureOptions\x2C minVersion\x2C\x0d\n                             maxVersion);\x0d\n  }\x0d\n\x0d\n  if (secureProtocol) {\x0d\n    if (minVersion != null)\x0d\n      throw new ERR_TLS_PROTOCOL_VERSION_CONFLICT(minVersion\x2C secureProtocol);\x0d\n    if (maxVersion != null)\x0d\n      throw new ERR_TLS_PROTOCOL_VERSION_CONFLICT(maxVersion\x2C secureProtocol);\x0d\n  }\x0d\n\x0d\n  this.context = new NativeSecureContext();\x0d\n  this.context.init(secureProtocol\x2C\x0d\n                    toV('minimum'\x2C minVersion\x2C tls.DEFAULT_MIN_VERSION)\x2C\x0d\n                    toV('maximum'\x2C maxVersion\x2C tls.DEFAULT_MAX_VERSION));\x0d\n\x0d\n  if (secureOptions) {\x0d\n    validateInteger(secureOptions\x2C 'secureOptions');\x0d\n    this.context.setOptions(secureOptions);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction createSecureContext(options) {\x0d\n  if (!options) options = {};\x0d\n\x0d\n  const {\x0d\n    honorCipherOrder\x2C\x0d\n    minVersion\x2C\x0d\n    maxVersion\x2C\x0d\n    secureProtocol\x2C\x0d\n  } = options;\x0d\n\x0d\n  let { secureOptions } = options;\x0d\n\x0d\n  if (honorCipherOrder)\x0d\n    secureOptions |= SSL_OP_CIPHER_SERVER_PREFERENCE;\x0d\n\x0d\n  const c = new SecureContext(secureProtocol\x2C secureOptions\x2C\x0d\n                              minVersion\x2C maxVersion);\x0d\n\x0d\n  configSecureContext(c.context\x2C options);\x0d\n\x0d\n  return c;\x0d\n}\x0d\n\x0d\n// Translate some fields from the handle's C-friendly format into more idiomatic\x0d\n// javascript object representations before passing them back to the user.  Can\x0d\n// be used on any cert object\x2C but changing the name would be semver-major.\x0d\nfunction translatePeerCertificate(c) {\x0d\n  if (!c)\x0d\n    return null;\x0d\n\x0d\n  // TODO(tniessen): can we remove parseCertString without breaking anything?\x0d\n  if (typeof c.issuer === 'string') c.issuer = parseCertString(c.issuer);\x0d\n  if (c.issuerCertificate != null && c.issuerCertificate !== c) {\x0d\n    c.issuerCertificate = translatePeerCertificate(c.issuerCertificate);\x0d\n  }\x0d\n  // TODO(tniessen): can we remove parseCertString without breaking anything?\x0d\n  if (typeof c.subject === 'string') c.subject = parseCertString(c.subject);\x0d\n  if (c.infoAccess != null) {\x0d\n    const info = c.infoAccess;\x0d\n    c.infoAccess = ObjectCreate(null);\x0d\n\x0d\n    // XXX: More key validation?\x0d\n    StringPrototypeReplace(info\x2C /([^\\n:]*):([^\\n]*)(?:\\n|$)/g\x2C\x0d\n                           (all\x2C key\x2C val) => {\x0d\n                             if (val.charCodeAt(0) === 0x22) {\x0d\n                               // The translatePeerCertificate function is only\x0d\n                               // used on internally created legacy certificate\x0d\n                               // objects\x2C and any value that contains a quote\x0d\n                               // will always be a valid JSON string literal\x2C\x0d\n                               // so this should never throw.\x0d\n                               val = JSONParse(val);\x0d\n                             }\x0d\n                             if (key in c.infoAccess)\x0d\n                               ArrayPrototypePush(c.infoAccess[key]\x2C val);\x0d\n                             else\x0d\n                               c.infoAccess[key] = [val];\x0d\n                           });\x0d\n  }\x0d\n  return c;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  SecureContext\x2C\x0d\n  createSecureContext\x2C\x0d\n  translatePeerCertificate\x2C\x0d\n};\x0d\n
