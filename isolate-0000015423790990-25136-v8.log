script-source,903,<unknown>,(() => {\n  'use strict';\n\n  const APP_VERSION = '1.17.0'; // JSON backup/restore via share sheet\x2C shot-log CSV\x2C remembered putts default\x2C verdict & shot-capture haptic vocabulary\n  const ACCURACY_WARN_YD = 25;\n  // Range-recalculation throttle (perf): GPS ticks only trigger the full\n  // plays-like solve when the player has genuinely moved. Sub-yard drift in\n  // the smoothed position can't change a golf number.\n  const RANGE_RECALC_MOVE_YD = 3; // movement (yd) required before a GPS-triggered recalculation runs\n  const USABLE_ACC_M = 30;\n  const APPROX_ACC_M = 500;\n  const WEATHER_TTL = 10 * 60 * 1000;\n  const ELEV_TTL = 30 * 24 * 60 * 60 * 1000;\n  const ONBOARD_KEY = 'caddy:onboarded';\n  const COURSE_PROFILES_KEY = 'caddy:courseProfiles:v1';\n  const LAST_ROUND_SETUP_KEY = 'caddy:lastRoundSetup:v1';\n  const NEARBY_COURSES_CACHE_KEY = 'caddy:nearbyCourses:v3';\n  const NEARBY_COURSES_TTL = 6 * 60 * 60 * 1000;\n  // Course name search (round setup): Photon geocoder FIRST (sub-second\x2C\n  // built for free-text place lookup)\x2C Overpass regex lookup as automatic\n  // fallback. Radius-bounded on purpose \u2014 unbounded name queries reliably\n  // time out on public Overpass mirrors.\n  const COURSE_SEARCH_RADIUS_M = 100000;\n  const COURSE_SEARCH_MIN_CHARS = 3;\n  const COURSE_SEARCH_DEBOUNCE_MS = 500;\n  const COURSE_SEARCH_TTL_MS = 24 * 60 * 60 * 1000;\n  const COURSE_SEARCH_FETCH_LIMIT = 60;   // fetched\x2C sorted by distance\x2C then trimmed\u2026\n  const COURSE_SEARCH_MAX_RESULTS = 12;   // \u2026to this many displayed\n  const PHOTON_GEOCODER_URL = 'https://photon.komoot.io/api/';\n  const LAST_PUTTS_KEY = 'caddy:lastPutts';\n  const NEARBY_COURSE_RADIUS_M = 12000;\n  const MAX_GPS_SPEED_MPS = 18;\n  const MAX_CONSECUTIVE_REJECTS = 3;\n  const REBASE_AFTER_MS = 20000;\n  const reduceMotion =\n    window.matchMedia &&\n    window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  const DEFAULT_CLUBS = [\n    ['Driver'\x2C 275]\x2C\n    ['3 Wood'\x2C 250]\x2C\n    ['2 Hybrid'\x2C 230]\x2C\n    ['5 Iron'\x2C 200]\x2C\n    ['6 Iron'\x2C 190]\x2C\n    ['7 Iron'\x2C 180]\x2C\n    ['8 Iron'\x2C 165]\x2C\n    ['9 Iron'\x2C 150]\x2C\n    ['PW'\x2C 135]\x2C\n    ['GW'\x2C 120]\x2C\n    ['50\xb0'\x2C 110]\x2C\n    ['54\xb0'\x2C 95]\x2C\n  ].map(([name\x2C yards]) => ({ id: cryptoId()\x2C name\x2C yards }));\n\n  const $ = (id) => document.getElementById(id);\n\n  const els = {\n    manifestLink: $('manifestLink')\x2C\n    proToggleSheet: $('proToggleSheet')\x2C\n    settingsBtn: $('settingsBtn')\x2C\n    recenterBtn: $('recenterBtn')\x2C\n    settingsSheet: $('settingsSheet')\x2C\n    settingsScrim: $('settingsScrim')\x2C\n    settingsDoneBtn: $('settingsDoneBtn')\x2C\n    replayOnboardBtn: $('replayOnboardBtn')\x2C\n    resetShotDataBtn: $('resetShotDataBtn')\x2C\n    shotDataDesc: $('shotDataDesc')\x2C\n    onboard: $('onboard')\x2C\n    obStartBtn: $('obStartBtn')\x2C\n    obNextBtn: $('obNextBtn')\x2C\n    obSkipBtn: $('obSkipBtn')\x2C\n    obStdBagBtn: $('obStdBagBtn')\x2C\n    obLaterBtn: $('obLaterBtn')\x2C\n    obDots: $('obDots')\x2C\n    findNearbyCoursesBtn: $('findNearbyCoursesBtn')\x2C\n    nearbyCourseStatus: $('nearbyCourseStatus')\x2C\n    nearbyCourseList: $('nearbyCourseList')\x2C\n    roundMapScoreBtn: $('roundMapScoreBtn')\x2C\n    roundScoreScrim: $('roundScoreScrim')\x2C\n    roundScoreSheet: $('roundScoreSheet')\x2C\n    roundScoreCloseBtn: $('roundScoreCloseBtn')\x2C\n    roundScoreTitle: $('roundScoreTitle')\x2C\n    roundScoreMeta: $('roundScoreMeta')\x2C\n    roundScoreValue: $('roundScoreValue')\x2C\n    roundScoreMinusBtn: $('roundScoreMinusBtn')\x2C\n    roundScorePlusBtn: $('roundScorePlusBtn')\x2C\n    roundPuttsOptions: $('roundPuttsOptions')\x2C\n    roundFirOptions: $('roundFirOptions')\x2C\n    roundGirOptions: $('roundGirOptions')\x2C\n    roundScoreSaveBtn: $('roundScoreSaveBtn')\x2C\n    roundScoreSaveNextBtn: $('roundScoreSaveNextBtn')\x2C\n    roundMapHud: $('roundMapHud')\x2C\n    roundMapCourse: $('roundMapCourse')\x2C\n    roundMapHole: $('roundMapHole')\x2C\n    roundMapScore: $('roundMapScore')\x2C\n    roundMapStatus: $('roundMapStatus')\x2C\n    roundMapPrevBtn: $('roundMapPrevBtn')\x2C\n    roundMapNextBtn: $('roundMapNextBtn')\x2C\n    roundSetupScrim: $('roundSetupScrim')\x2C\n    roundSetupSheet: $('roundSetupSheet')\x2C\n    roundSetupCloseBtn: $('roundSetupCloseBtn')\x2C\n    roundSetupCourseSelect: $('roundSetupCourseSelect')\x2C\n    roundSetupCourseName: $('roundSetupCourseName')\x2C\n    roundSetupTeeName: $('roundSetupTeeName')\x2C\n    roundSetupStartHole: $('roundSetupStartHole')\x2C\n    roundSetupPars: $('roundSetupPars')\x2C\n    roundSetupSaveCourse: $('roundSetupSaveCourse')\x2C\n    roundSetupStartBtn: $('roundSetupStartBtn')\x2C\n    roundCourseName: $('roundCourseName')\x2C\n    roundHoleNumber: $('roundHoleNumber')\x2C\n    roundHoleMeta: $('roundHoleMeta')\x2C\n    roundScoreSummary: $('roundScoreSummary')\x2C\n    roundHoleStrip: $('roundHoleStrip')\x2C\n    roundPrevHoleBtn: $('roundPrevHoleBtn')\x2C\n    gpsChip: $('gpsChip')\x2C\n    gpsDot: $('gpsDot')\x2C\n    gpsText: $('gpsText')\x2C\n    roundFabWrap: $('roundFabWrap')\x2C\n    roundFab: $('roundFab')\x2C\n    roundFabIc: $('roundFabIc')\x2C\n    roundFabText: $('roundFabText')\x2C\n    roundFabClub: $('roundFabClub')\x2C\n    roundFabClubName: $('roundFabClubName')\x2C\n    roundClubPop: $('roundClubPop')\x2C\n    roundLive: $('roundLive')\x2C\n    roundLiveV: $('roundLiveV')\x2C\n    roundLiveL: $('roundLiveL')\x2C\n    advicePill: $('advicePill')\x2C\n    advicePillIc: $('advicePillIc')\x2C\n    advicePillCount: $('advicePillCount')\x2C\n    advicePop: $('advicePop')\x2C\n    advicePopScrim: $('advicePopScrim')\x2C\n    advicePopClose: $('advicePopClose')\x2C\n    advicePopBody: $('advicePopBody')\x2C\n    advicePopTitle: $('advicePopTitle')\x2C\n    rawYards: $('rawYards')\x2C\n    rawLabel: $(