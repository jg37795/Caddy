script-source,736,node:internal/assert/calltracker,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  Error\x2C\x0d\n  FunctionPrototype\x2C\x0d\n  ReflectApply\x2C\x0d\n  SafeSet\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_UNAVAILABLE_DURING_EXIT\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst AssertionError = require('internal/assert/assertion_error');\x0d\nconst {\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst noop = FunctionPrototype;\x0d\n\x0d\nclass CallTracker {\x0d\n\x0d\n  #callChecks = new SafeSet();\x0d\n\x0d\n  calls(fn\x2C exact = 1) {\x0d\n    if (process._exiting)\x0d\n      throw new ERR_UNAVAILABLE_DURING_EXIT();\x0d\n    if (typeof fn === 'number') {\x0d\n      exact = fn;\x0d\n      fn = noop;\x0d\n    } else if (fn === undefined) {\x0d\n      fn = noop;\x0d\n    }\x0d\n\x0d\n    validateUint32(exact\x2C 'exact'\x2C true);\x0d\n\x0d\n    const context = {\x0d\n      exact\x2C\x0d\n      actual: 0\x2C\x0d\n      // eslint-disable-next-line no-restricted-syntax\x0d\n      stackTrace: new Error()\x2C\x0d\n      name: fn.name || 'calls'\x0d\n    };\x0d\n    const callChecks = this.#callChecks;\x0d\n    callChecks.add(context);\x0d\n\x0d\n    return function() {\x0d\n      context.actual++;\x0d\n      if (context.actual === context.exact) {\x0d\n        // Once function has reached its call count remove it from\x0d\n        // callChecks set to prevent memory leaks.\x0d\n        callChecks.delete(context);\x0d\n      }\x0d\n      // If function has been called more than expected times\x2C add back into\x0d\n      // callchecks.\x0d\n      if (context.actual === context.exact + 1) {\x0d\n        callChecks.add(context);\x0d\n      }\x0d\n      return ReflectApply(fn\x2C this\x2C arguments);\x0d\n    };\x0d\n  }\x0d\n\x0d\n  report() {\x0d\n    const errors = [];\x0d\n    for (const context of this.#callChecks) {\x0d\n      // If functions have not been