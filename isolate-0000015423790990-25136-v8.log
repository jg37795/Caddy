script-source,138,C:\\Users\\wendy\\Desktop\\Caddy\\Caddy-main\\node_modules\\url-parse\\index.js,'use strict';\n\nvar required = require('requires-port')\n  \x2C qs = require('querystringify')\n  \x2C controlOrWhitespace = /^[\\x00-\\x20\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+/\n  \x2C CRHTLF = /[\\n\\r\\t]/g\n  \x2C slashes = /^[A-Za-z][A-Za-z0-9+-.]*:\\/\\//\n  \x2C port = /:\\d+$/\n  \x2C protocolre = /^([a-z][a-z0-9.+-]*:)?(\\/\\/)?([\\\\/]+)?([\\S\\s]*)/i\n  \x2C windowsDriveLetter = /^[a-zA-Z]:/;\n\n/**\n * Remove control characters and whitespace from the beginning of a string.\n *\n * @param {Object|String} str String to trim.\n * @returns {String} A new string representing `str` stripped of control\n *     characters and whitespace from its beginning.\n * @public\n */\nfunction trimLeft(str) {\n  return (str ? str : '').toString().replace(controlOrWhitespace\x2C '');\n}\n\n/**\n * These are the parse rules for the URL parser\x2C it informs the parser\n * about:\n *\n * 0. The char it Needs to parse\x2C if it's a string it should be done using\n *    indexOf\x2C RegExp using exec and NaN means set as current value.\n * 1. The property we should set when parsing this value.\n * 2. Indication if it's backwards or forward parsing\x2C when set as number it's\n *    the value of extra chars that should be split off.\n * 3. Inherit from location if non existing in the parser.\n * 4. `toLowerCase` the resulting value.\n */\nvar rules = [\n  ['#'\x2C 'hash']\x2C                        // Extract from the back.\n  ['?'\x2C 'query']\x2C                       // Extract from the back.\n  function sanitize(address\x2C url) {     // Sanitize what is left of the address\n    return isSpecial(url.protocol) ? address.replace(/\\\\/g\x2C '/') : address;\n  }\x2C\n  ['/'\x2C 'pathname']\x2C                    // Extract from the back.\n  ['@'\x2C 'auth'\x2C 1]\x2C                     // Extract from the front.\n  [NaN\x2C 'host'\x2C undefined