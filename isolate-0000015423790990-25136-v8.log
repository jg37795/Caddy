uest } = require('_http_client');\x0d\nlet debug = require('internal/util/debuglog').debuglog('https'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { URL\x2C urlToHttpOptions\x2C searchParamsSymbol } = require('internal/url');\x0d\n\x0d\nfunction Server(opts\x2C requestListener) {\x0d\n  if (!(this instanceof Server)) return new Server(opts\x2C requestListener);\x0d\n\x0d\n  if (typeof opts === 'function') {\x0d\n    requestListener = opts;\x0d\n    opts = undefined;\x0d\n  }\x0d\n  opts = { ...opts };\x0d\n\x0d\n  if (!opts.ALPNProtocols) {\x0d\n    // http/1.0 is not defined as Protocol IDs in IANA\x0d\n    // https://www.iana.org/assignments/tls-extensiontype-values\x0d\n    //       /tls-extensiontype-values.xhtml#alpn-protocol-ids\x0d\n    opts.ALPNProtocols = ['http/1.1'];\x0d\n  }\x0d\n\x0d\n  FunctionPrototypeCall(storeHTTPOptions\x2C this\x2C opts);\x0d\n  FunctionPrototypeCall(tls.Server\x2C this\x2C opts\x2C _connectionListener);\x0d\n\x0d\n  this.httpAllowHalfOpen = false;\x0d\n\x0d\n  if (requestListener) {\x0d\n    this.addListener('request'\x2C requestListener);\x0d\n  }\x0d\n\x0d\n  this.addListener('tlsClientError'\x2C function addListener(err\x2C conn) {\x0d\n    if (!this.emit('clientError'\x2C err\x2C conn))\x0d\n      conn.destroy(err);\x0d\n  });\x0d\n\x0d\n  this.timeout = 0;\x0d\n  this.keepAliveTimeout = 5000;\x0d\n  this.maxHeadersCount = null;\x0d\n  this.headersTimeout = 60 * 1000; // 60 seconds\x0d\n  this.requestTimeout = 0;\x0d\n}\x0d\nObjectSetPrototypeOf(Server.prototype\x2C tls.Server.prototype);\x0d\nObjectSetPrototypeOf(Server\x2C tls.Server);\x0d\n\x0d\nServer.prototype.setTimeout = HttpServer.prototype.setTimeout;\x0d\n\x0d\n/**\x0d\n * Creates a new `https.Server` instance.\x0d\n * @param {{\x0d\n *   IncomingMessage?: IncomingMessage;\x0d\n *   ServerResponse?: ServerResponse;\x0d\n *   insecureHTTPParser?: boolean;\x0d\n *   maxHeaderSize?: number;\x0d\n *   }} [opts]\x0d\n * @param {Function} [requestListener]\x0d\n * @returns {Server}\x0d\n */\x0d\nfunction createServer(opts\x2C requestListener) {\x0d\n  return new Server(opts\x2C requestListener);\x0d\n}\x0d\n\x0d\n\x0d\n// HTTPS agents.\x0d\n\x0d\nfunction createConnection(port\x2C host\x2C options) {\x0d\n  if (port !== null && typeof port === 'object') {\x0d\n    options = port;\x0d\n  } else if (host !== null && typeof host === 'object') {\x0d\n    options = { ...host };\x0d\n  } else if (options === null || typeof options !== 'object') {\x0d\n    options = {};\x0d\n  } else {\x0d\n    options = { ...options };\x0d\n  }\x0d\n\x0d\n  if (typeof port === 'number') {\x0d\n    options.port = port;\x0d\n  }\x0d\n\x0d\n  if (typeof host === 'string') {\x0d\n    options.host = host;\x0d\n  }\x0d\n\x0d\n  debug('createConnection'\x2C options);\x0d\n\x0d\n  if (options._agentKey) {\x0d\n    const session = this._getSession(options._agentKey);\x0d\n    if (session) {\x0d\n      debug('reuse session for %j'\x2C options._agentKey);\x0d\n      options = {\x0d\n        session\x2C\x0d\n        ...options\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const socket = tls.connect(options);\x0d\n\x0d\n  if (options._agentKey) {\x0d\n    // Cache new session for reuse\x0d\n    socket.on('session'\x2C (session) => {\x0d\n      this._cacheSession(options._agentKey\x2C session);\x0d\n    });\x0d\n\x0d\n    // Evict session on error\x0d\n    socket.once('close'\x2C (err) => {\x0d\n      if (err)\x0d\n        this._evictSession(options._agentKey);\x0d\n    });\x0d\n  }\x0d\n\x0d\n  return socket;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates a new `HttpAgent` instance.\x0d\n * @param {{\x0d\n *   keepAlive?: boolean;\x0d\n *   keepAliveMsecs?: number;\x0d\n *   maxSockets?: number;\x0d\n *   maxTotalSockets?: number;\x0d\n *   maxFreeSockets?: number;\x0d\n *   scheduling?: string;\x0d\n *   timeout?: number;\x0d\n *   maxCachedSessions?: number;\x0d\n *   servername?: string;\x0d\n *   }} [options]\x0d\n * @returns {Agent}\x0d\n */\x0d\nfunction Agent(options) {\x0d\n  if (!(this instanceof Agent))\x0d\n    return new Agent(options);\x0d\n\x0d\n  FunctionPrototypeCall(HttpAgent\x2C this\x2C options);\x0d\n  this.defaultPort = 443;\x0d\n  this.protocol = 'https:';\x0d\n  this.maxCachedSessions = this.options.maxCachedSessions;\x0d\n  if (this.maxCachedSessions === undefined)\x0d\n    this.maxCachedSessions = 100;\x0d\n\x0d\n  this._sessionCache = {\x0d\n    map: {}\x2C\x0d\n    list: []\x0d\n  };\x0d\n}\x0d\nObjectSetPrototypeOf(Agent.prototype\x2C HttpAgent.prototype);\x0d\nObjectSetPrototypeOf(Agent\x2C HttpAgent);\x0d\nAgent.prototype.createConnection = createConnection;\x0d\n\x0d\n/**\x0d\n * Gets a unique name for a set of options.\x0d\n * @param {{\x0d\n *   host: string;\x0d\n *   port: number;\x0d\n *   localAddress: string;\x0d\n *   family: number;\x0d\n *   }} [options]\x0d\n * @returns {string}\x0d\n */\x0d\nAgent.prototype.getName = function getName(options) {\x0d\n  let name = FunctionPrototypeCall(HttpAgent.prototype.getName\x2C this\x2C options);\x0d\n\x0d\n  name += ':';\x0d\n  if (options.ca)\x0d\n    name += options.ca;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.cert)\x0d\n    name += options.cert;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.clientCertEngine)\x0d\n    name += options.clientCertEngine;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.ciphers)\x0d\n    name += options.ciphers;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.key)\x0d\n    name += options.key;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.pfx)\x0d\n    name += options.pfx;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.rejectUnauthorized !== undefined)\x0d\n    name += options.rejectUnauthorized;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.servername && options.servername !== options.host)\x0d\n    name += options.servername;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.minVersion)\x0d\n    name += options.minVersion;\x0d\n\x0d\n  name += ':';\x0d\n  if (options.maxVersion)\x0d\n    name += options.maxVersion;\x0d\n\x0d\n 