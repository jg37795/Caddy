{String} template\n\x09 * @return {Boolean}\n\x09 */\n\x09function matchesTemplate(search\x2C template) {\n\x09\x09let searchIndex = 0;\n\x09\x09let templateIndex = 0;\n\x09\x09let starIndex = -1;\n\x09\x09let matchIndex = 0;\n\n\x09\x09while (searchIndex < search.length) {\n\x09\x09\x09if (templateIndex < template.length && (template[templateIndex] === search[searchIndex] || template[templateIndex] === '*')) {\n\x09\x09\x09\x09// Match character or proceed with wildcard\n\x09\x09\x09\x09if (template[templateIndex] === '*') {\n\x09\x09\x09\x09\x09starIndex = templateIndex;\n\x09\x09\x09\x09\x09matchIndex = searchIndex;\n\x09\x09\x09\x09\x09templateIndex++; // Skip the '*'\n\x09\x09\x09\x09} else {\n\x09\x09\x09\x09\x09searchIndex++;\n\x09\x09\x09\x09\x09templateIndex++;\n\x09\x09\x09\x09}\n\x09\x09\x09} else if (starIndex !== -1) { // eslint-disable-line no-negated-condition\n\x09\x09\x09\x09// Backtrack to the last '*' and try to match more characters\n\x09\x09\x09\x09templateIndex = starIndex + 1;\n\x09\x09\x09\x09matchIndex++;\n\x09\x09\x09\x09searchIndex = matchIndex;\n\x09\x09\x09} else {\n\x09\x09\x09\x09return false; // No match\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09// Handle trailing '*' in template\n\x09\x09while (templateIndex < template.length && template[templateIndex] === '*') {\n\x09\x09\x09templateIndex++;\n\x09\x09}\n\n\x09\x09return templateIndex === template.length;\n\x09}\n\n\x09/**\n\x09* Disable debug output.\n\x09*\n\x09* @return {String} namespaces\n\x09* @api public\n\x09*/\n\x09function disable() {\n\x09\x09const namespaces = [\n\x09\x09\x09...createDebug.names\x2C\n\x09\x09\x09...createDebug.skips.map(namespace => '-' + namespace)\n\x09\x09].join('\x2C');\n\x09\x09createDebug.enable('');\n\x09\x09return namespaces;\n\x09}\n\n\x09/**\n\x09* Returns true if the given mode name is enabled\x2C false otherwise.\n\x09*\n\x09* @param {String} name\n\x09* @return {Boolean}\n\x09* @api public\n\x09*/\n\x09function enabled(name) {\n\x09\x09for (const 